        expansion_fixture(side);test_game.players[side].monsters[0]=slot(knight,side,0);test_game.players[side].hand_count=1;test_game.players[side].hand[0]=simple_record(796);deck=test_game.players[side].deck_count;check(command(DUEL_ACTION_SUMMON,0,0,0,0,1)==DUEL_OK&&test_game.players[side].deck_count==deck+1&&test_game.players[side].deck[deck]==knight&&!test_game.players[side].grave_count);
        pile_fixture(side,1070);test_game.players[enemy].hand_count=1;test_game.players[enemy].hand[0]=knight;deck=test_game.players[enemy].deck_count;check(command(DUEL_ACTION_ACTIVATE_HAND,0,0,0,0,0)==DUEL_OK&&choose(side,0)==DUEL_OK&&test_game.players[enemy].deck_count==deck+1&&test_game.players[enemy].deck[deck]==knight&&!test_game.players[enemy].grave_count);
