        trait_fixture(side,77,2,0);expansion_place(1-side,4,1033);test_game.players[side].backrow[0]=slot(simple_record(1145),side,DUEL_FACEDOWN_DEFENSE);test_game.players[side].backrow[0].set_turn=1;check(command(DUEL_ACTION_ACTIVATE_BACKROW,0,0,0,0,0)==DUEL_OK&&choose(side,7)==DUEL_OK);pass_chain();check(duel_race(&test_game,side,0)==15&&test_game.players[side].backrow[0].control_used==7);test_game.players[1-side].backrow[4]=empty_slot();check(duel_race(&test_game,side,0)==7);
        /* Declaration precedes response. Chain two's newer DNA source
