static void traits_tests(void){unsigned initial=checks,matrix=0,reference_only=0;for(unsigned i=0;i<DUEL_CARD_COUNT;++i)trait_defs[i]=duel_card_definitions[i];
    for(unsigned n=0;n<sizeof(original_trait_race_cases)/sizeof(original_trait_race_cases[0]);++n){const int *v=original_trait_race_cases[n];trait_fixture(v[0],v[2],v[3],v[6]);trait_source(v[1],0,1145,v[5],20,v[4]);check(duel_race(&test_game,v[0],0)==v[7]);++matrix;}
    for(unsigned n=0;n<sizeof(original_trait_order_cases)/sizeof(original_trait_order_cases[0]);++n){const int *v=original_trait_order_cases[n];trait_fixture(v[0],1329,2,v[5]);trait_source(0,0,1145,v[1],20,0);trait_source(1,0,1145,v[2],v[3]?20:30,0);if(v[4]){dynamic_equip_attach(0,1,simple_record(1550),100);test_game.players[0].backrow[1].serial=v[4];}check(duel_race(&test_game,v[0],0)==v[6]);++matrix;}
    for(unsigned n=0;n<sizeof(original_trait_attribute_cases)/sizeof(original_trait_attribute_cases[0]);++n){const int *v=original_trait_attribute_cases[n];if(v[3]&&v[4]){++reference_only;continue;}trait_fixture(v[0],1329,v[6],v[5]);dynamic_equip_attach(v[1],0,simple_record(1448),100);test_game.players[v[1]].backrow[0].control_used=v[2];if(v[4])expansion_place(v[1],4,1154);if(v[3]){dynamic_equip_attach(1-v[1],1,simple_record(1448),100);test_game.players[1-v[1]].backrow[1].control_used=1+v[2]%6;test_game.stat_links[0]=(DuelStatLink){test_game.players[v[1]].backrow[0].serial,100,2};test_game.stat_links[1]=(DuelStatLink){test_game.players[1-v[1]].backrow[1].serial,100,2};test_game.stat_link_count=2;}check(duel_attribute(&test_game,v[0],0)==v[7]);++matrix;}
    for(unsigned n=0;n<sizeof(original_trait_tribe_cases)/sizeof(original_trait_tribe_cases[0]);++n){const int *v=original_trait_tribe_cases[n];trait_fixture(1-v[0],77,2,0);trait_defs[simple_record(77)].race=v[4];test_game.cards=trait_defs;trait_source(v[0],0,1146,v[3],20,v[2]);test_game.players[v[0]].backrow[0].position=v[1]==1?DUEL_FACEDOWN_DEFENSE:DUEL_FACEUP_ATTACK;test_game.phase=DUEL_BATTLE;int result=command(DUEL_ACTION_ATTACK,0,v[0],DUEL_NO_SLOT,0,0);check((result!=DUEL_OK)==v[5]);++matrix;}
    for(unsigned n=0;n<sizeof(original_trait_dragon_cases)/sizeof(original_trait_dragon_cases[0]);++n){const int *v=original_trait_dragon_cases[n];trait_fixture(v[0],v[1],2,v[2]);dynamic_equip_attach(v[0],0,simple_record(1550),100);test_game.players[v[0]].backrow[0].serial=20;if(v[3])trait_source(1-v[0],0,1145,v[3],30,0);if(v[4])expansion_place(v[0],4,1537);check(duel_attack_value(&test_game,v[0],0)==v[5]&&duel_defense_value(&test_game,v[0],0)==v[6]);++matrix;}
    DuelCommand c;DuelChoiceOption options[DUEL_OPTION_MAX];
    for(unsigned side=0;side<2;++side){
        trait_fixture(side,77,2,0);test_game.players[side].backrow[0]=slot(simple_record(1145),side,DUEL_FACEDOWN_DEFENSE);test_game.players[side].backrow[0].serial=10;test_game.players[side].backrow[0].set_turn=1;unsigned revision=test_game.revision;check(command(DUEL_ACTION_ACTIVATE_BACKROW,0,0,0,0,0)==DUEL_OK&&test_game.choice.kind==DUEL_CHOICE_ACTIVATION_PARAMETER&&!test_game.chain_count);check(duel_choice_options(&test_game,options,DUEL_OPTION_MAX)==21);uint32_t before=duel_state_hash(&test_game);check(choose(side,0)==DUEL_BAD_TARGET&&duel_state_hash(&test_game)==before);check(choose(side,DUEL_NO_SLOT)==DUEL_OK&&test_game.players[side].backrow[0].position==DUEL_FACEDOWN_DEFENSE&&!test_game.chain_count&&test_game.revision>revision);
        /* Revealing an older Set source gives it a new rule stamp without
