        trait_fixture(side,77,2,0);test_game.players[side].hand[0]=simple_record(1448);test_game.players[side].hand_count=1;unsigned original=duel_attribute(&test_game,side,0),selected=original==1?2:1;check(command(DUEL_ACTION_ACTIVATE_HAND,0,side,0,0,0)==DUEL_OK&&duel_choice_options(&test_game,options,DUEL_OPTION_MAX)==6);check(choose(side,original)==DUEL_BAD_TARGET&&choose(side,selected)==DUEL_OK);pass_chain();check(duel_attribute(&test_game,side,0)==selected);test_game.players[side].hand[0]=simple_record(1079);test_game.players[side].hand_count=1;check(command(DUEL_ACTION_ACTIVATE_HAND,0,side,0,0,0)==DUEL_OK);pass_chain();check(duel_attribute(&test_game,side,0)==original);
    }
