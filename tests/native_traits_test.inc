volatile uint32_t native_traits_test_result[6];
static void trait_fixture(unsigned side,unsigned name,unsigned pos,unsigned umi){expansion_fixture(side);test_game.players[side].monsters[0]=slot(simple_record(name),side,pos==1?DUEL_FACEDOWN_DEFENSE:DUEL_FACEUP_ATTACK);test_game.players[side].monsters[0].serial=100;test_game.next_serial=200;if(umi){test_game.players[0].field=slot(simple_record(333),0,DUEL_FACEUP_ATTACK);test_game.players[0].field.effect_active=1;}}
