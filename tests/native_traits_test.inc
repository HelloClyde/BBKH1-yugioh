        trait_fixture(side,77,2,0);for(unsigned p=0;p<2;++p){test_game.players[p].backrow[0]=slot(simple_record(1145),p,DUEL_FACEDOWN_DEFENSE);test_game.players[p].backrow[0].set_turn=1;test_game.players[p].backrow[0].serial=10+p;}check(command(DUEL_ACTION_ACTIVATE_BACKROW,0,0,0,0,0)==DUEL_OK&&choose(side,1)==DUEL_OK&&test_game.response_player==1-side);c=(DuelCommand){1-side,DUEL_ACTION_ACTIVATE_BACKROW,0};check(duel_command(&test_game,&c)==DUEL_OK&&choose(1-side,7)==DUEL_OK);pass_chain();check(duel_race(&test_game,side,0)==7);
        /* Warrior equipment can attach first, then DNA temporarily removes
