    for(unsigned n=0;n<sizeof(original_kunai_position_cases)/sizeof(original_kunai_position_cases[0]);++n){const int *v=original_kunai_position_cases[n];kunai_chain(v[0],v[1],v[2],v[3],v[4],v[5]);test_game.chain[0].command.target_player=1-v[0];test_game.chain[0].targets[0]=(DuelTarget){300,v[2],0};pass_chain();if(v[4]){const DuelSlot *s=&test_game.players[v[2]].monsters[0];unsigned expected=v[3]==0?DUEL_FACEDOWN_ATTACK:v[3]==1?DUEL_FACEDOWN_DEFENSE:v[3]==2?DUEL_FACEUP_ATTACK:DUEL_FACEUP_DEFENSE;if(v[6])expected=v[3]==0?DUEL_FACEDOWN_DEFENSE:DUEL_FACEUP_DEFENSE;check(duel_monster_position(&test_game,v[2],0)==expected);check(s->serial==201);}++matrix;}
    for(unsigned side=0;side<2;++side){unsigned enemy=1-side;
        for(unsigned mode=1;mode<=3;++mode){pair_fixture(enemy);test_game.phase=DUEL_BATTLE;test_game.players[side].monsters[0]=slot(simple_record(77),side,0);test_game.players[side].monsters[0].serial=200;test_game.players[enemy].monsters[0]=slot(simple_record(77),enemy,0);test_game.players[enemy].monsters[0].serial=300;test_game.players[side].backrow[0]=slot(simple_record(650),side,2);test_game.players[side].backrow[0].serial=100;check(command(DUEL_ACTION_ATTACK,0,side,0,0,0)==DUEL_OK&&test_game.response_player==side);c=(DuelCommand){0};c.player=side;c.action=DUEL_ACTION_ACTIVATE_BACKROW;check(duel_command(&test_game,&c)==DUEL_OK);check(choose(side,mode)==DUEL_OK);if(mode!=1)check(choose(side,0)==DUEL_OK);pass_chain();check(test_game.players[side].life==8000&&test_game.players[enemy].life==(mode==2?7500:8000));check((test_game.players[side].backrow[0].card!=0)==(mode!=1));if(mode!=2)check(test_game.players[enemy].monsters[0].position==DUEL_FACEUP_DEFENSE);else check(!test_game.players[enemy].monsters[0].card);}
