        swarm_fixture(side,vermin,2,0);check(command(DUEL_ACTION_ATTACK,0,side,0,0,0)==DUEL_OK&&test_game.choice.kind==DUEL_CHOICE_NIMBLE_SUMMON&&test_game.battle_pending);check(choose(side,0)==DUEL_OK&&!test_game.choice.kind&&!test_game.battle_pending&&!test_game.players[side].monsters[0].card&&test_game.players[side].monsters[1].card==vermin&&test_game.players[side].monsters[1].position==DUEL_FACEDOWN_DEFENSE);
        swarm_fixture(side,vermin,2,1);test_game.active=side;test_game.phase=DUEL_MAIN1;check(command(DUEL_ACTION_POSITION,0,0,0,DUEL_FACEUP_ATTACK,0)==DUEL_OK&&!test_game.choice.kind&&test_game.players[side].deck_count==2);
