            check(result==DUEL_OK);if(result!=DUEL_OK)break;check(owned_cards(&test_game,0)==47&&owned_cards(&test_game,1)==47);}check(test_game.winner>=0);completed+=test_game.winner>=0;}
    check(choices>0&&completed==20);native_swarm_test_result[0]=checks-first;native_swarm_test_result[1]=choices;native_swarm_test_result[2]=completed;
