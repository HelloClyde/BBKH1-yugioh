        while(test_game.winner<0&&actions++<4000){DuelCommand c;check(duel_ai_decide(&test_game,decision_player(),&c));choices+=c.action==DUEL_ACTION_CHOOSE&&test_game.choice.kind==DUEL_CHOICE_NIMBLE_SUMMON&&(test_game.choice.card==germ||test_game.choice.card==vermin);int result=duel_command(&test_game,&c);
#ifdef _WIN32
            if(result!=DUEL_OK)fprintf(stderr,"swarm seed %u turn %u action %u result %u\n",seed,test_game.turn,c.action,result);
