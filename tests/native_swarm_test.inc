        for(unsigned i=0;i<2;++i)check(test_game.players[side].monsters[i].card==germ&&test_game.players[side].monsters[i].position==DUEL_FACEUP_ATTACK&&test_game.players[side].monsters[i].properly_summoned);
        swarm_fixture(side,germ,2,1);check(command(DUEL_ACTION_ATTACK,0,side,0,0,0)==DUEL_OK&&test_game.choice.kind==DUEL_CHOICE_NIMBLE_SUMMON);check(choose(side,0)==DUEL_OK&&!test_game.choice.kind&&test_game.players[side].deck_count==1);for(unsigned i=0;i<5;++i)check(test_game.players[side].monsters[i].card!=0);
        swarm_fixture(side,germ,0,0);check(command(DUEL_ACTION_ATTACK,0,side,0,0,0)==DUEL_OK&&!test_game.choice.kind&&test_game.players[1-side].life==7500);
        swarm_fixture(side,germ,2,0);check(command(DUEL_ACTION_ATTACK,0,side,0,0,0)==DUEL_OK&&choose(side,DUEL_NO_SLOT)==DUEL_OK&&!test_game.choice.kind&&test_game.players[side].deck_count==2&&test_game.players[1-side].life==7500);
        swarm_fixture(side,germ,2,0);test_game.players[1-side].life=500;check(command(DUEL_ACTION_ATTACK,0,side,0,0,0)==DUEL_OK&&test_game.winner==(int)side&&!test_game.choice.kind&&test_game.players[side].deck_count==2);
        simple_fixture(802,side);test_game.players[side].monsters[0]=slot(germ,side,DUEL_FACEUP_ATTACK);test_game.players[side].deck_count=1;test_game.players[side].deck[0]=germ;check(simple_activate(802,0,0)==DUEL_OK&&!test_game.choice.kind&&test_game.players[1-side].life==8000&&test_game.players[side].deck_count==1);
