static void swarm_fixture(unsigned side,unsigned card,unsigned copies,unsigned full){reset();test_game.turn=3;test_game.active=1-side;test_game.phase=DUEL_BATTLE;test_game.players[0].hand_count=test_game.players[1].hand_count=0;test_game.players[side].deck_count=copies;for(unsigned i=0;i<copies;++i)test_game.players[side].deck[i]=card;test_game.players[side].monsters[0]=slot(card,side,DUEL_FACEDOWN_DEFENSE);if(full)for(unsigned i=1;i<5;++i)test_game.players[side].monsters[i]=slot(550,side,DUEL_FACEUP_ATTACK);test_game.players[1-side].monsters[0]=slot(550,1-side,DUEL_FACEUP_ATTACK);}
static void swarm_tests(void){unsigned first=checks,germ=simple_record(1114),vermin=simple_record(1307),nimble=simple_record(1115);
    for(unsigned side=0;side<2;++side){
