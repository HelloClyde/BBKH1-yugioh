        expansion_fixture(side);test_game.players[side].hand_count=1;test_game.players[side].hand[0]=expansion_effect_card(DUEL_E_CHANGE_HEART);test_game.players[side].life=2000;test_game.players[enemy].monsters[0]=slot(simple_record(483),enemy,0);check(command(DUEL_ACTION_ACTIVATE_HAND,0,enemy,0,0,0)==DUEL_OK&&test_game.winner==enemy&&test_game.players[side].life==0);
