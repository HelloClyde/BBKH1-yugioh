    for(unsigned n=0;n<sizeof(original_prohibition_revival_cases)/sizeof(original_prohibition_revival_cases[0]);++n){const int *v=original_prohibition_revival_cases[n];expansion_fixture(v[0]);test_game.players[v[1]].grave[0]=simple_record(v[2]);test_game.players[v[1]].grave_proper[0]=1;test_game.players[v[1]].grave_count=1;if(v[3])procedure_prohibition(1-v[0],v[2],0,0);check(duel_can_revive_for(&test_game,v[0],v[1],0)==v[4]);++matrix;}
