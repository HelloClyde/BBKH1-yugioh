    for(unsigned n=0;n<sizeof(original_token_tribute_cases)/sizeof(original_token_tribute_cases[0]);++n){const int *v=original_token_tribute_cases[n];expansion_fixture(v[0]);test_game.players[v[1]].monsters[0]=slot(simple_record(v[2]),v[1],DUEL_FACEUP_ATTACK);if(v[3])expansion_place(v[0],0,1418);check(duel_can_tribute(&test_game,v[0],v[1],0)==v[4]&&duel_can_normal_tribute(&test_game,v[0],v[1],0)==v[5]);++matrix;}
