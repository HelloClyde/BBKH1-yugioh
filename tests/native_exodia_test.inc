#include "original_exodia_cases.h"
volatile uint32_t native_exodia_test_result[5];
static void exodia_tests(void){unsigned initial=checks,matrix=0;unsigned pieces[5];for(unsigned i=0;i<5;++i)pieces[i]=simple_record(16+i);
    for(unsigned i=0;i<sizeof(original_exodia_cases)/sizeof(original_exodia_cases[0]);++i){const unsigned *v=original_exodia_cases[i];reset();DuelPlayer *p=&test_game.players[v[0]];p->hand_count=0;for(unsigned k=0;k<=v[2];++k)for(unsigned j=0;j<5;++j)if(v[1]&(1u<<j))p->hand[p->hand_count++]=pieces[j];p->hand[p->hand_count++]=550;p->hand[p->hand_count++]=550;if(v[3])for(unsigned j=0;j<p->hand_count/2;++j){unsigned card=p->hand[j];p->hand[j]=p->hand[p->hand_count-1-j];p->hand[p->hand_count-1-j]=card;}check(duel_exodia_complete(&test_game,v[0])==(int)v[4]);++matrix;}
    /* A normal draw and a deck search are complete decisions. */
    for(unsigned side=0;side<2;++side){reset();test_game.turn=3;test_game.active=1-side;test_game.players[side].hand_count=4;for(unsigned i=0;i<4;++i)test_game.players[side].hand[i]=pieces[i];test_game.players[side].deck[test_game.players[side].deck_count-1]=pieces[4];check(command(DUEL_ACTION_PHASE,0,0,DUEL_END,0,0)==DUEL_OK&&test_game.winner==(int)side&&test_game.last_event.type==DUEL_EVENT_WIN);uint32_t before=duel_state_hash(&test_game);check(command(DUEL_ACTION_PHASE,0,0,DUEL_MAIN1,0,0)==DUEL_FINISHED&&duel_state_hash(&test_game)==before);}
    /* Graceful Charity must finish its required two discards. Drawing the
     * head does not bypass them, and discarding the head prevents victory. */
    for(unsigned keep=0;keep<2;++keep){reset();test_game.turn=3;test_game.players[1].hand_count=0;for(unsigned i=0;i<4;++i)test_game.players[0].hand[i]=pieces[i];test_game.players[0].hand[4]=simple_record(968);test_game.players[0].hand_count=5;test_game.players[0].deck_count=3;test_game.players[0].deck[2]=pieces[4];test_game.players[0].deck[1]=test_game.players[0].deck[0]=550;check(command(DUEL_ACTION_ACTIVATE_HAND,4,0,0,0,0)==DUEL_OK&&test_game.winner<0&&test_game.choice.kind==DUEL_CHOICE_DISCARD_HAND);check(choose(0,keep?5:4)==DUEL_OK&&test_game.winner<0&&test_game.choice.kind==DUEL_CHOICE_DISCARD_HAND);check(choose(0,keep?5:4)==DUEL_OK&&!test_game.choice.kind&&(keep?test_game.winner==0:test_game.winner<0));}
    /* Simultaneous completed hands are a draw, not a loss recorded by UI. */
    reset();test_game.turn=3;for(unsigned side=0;side<2;++side){for(unsigned i=0;i<5;++i)test_game.players[side].hand[i]=pieces[i];test_game.players[side].hand_count=5;}check(command(DUEL_ACTION_PHASE,0,0,DUEL_MAIN2,0,0)==DUEL_OK&&test_game.winner==2&&test_game.last_event.player==2);
    reset();test_game.turn=3;test_game.players[0].hand_count=test_game.players[1].hand_count=0;for(unsigned i=0;i<5;++i){test_game.players[0].monsters[i]=slot(pieces[i],0,DUEL_FACEUP_ATTACK);test_game.players[0].grave[i]=pieces[i];}test_game.players[0].grave_count=5;check(!duel_exodia_complete(&test_game,0)&&command(DUEL_ACTION_PHASE,0,0,DUEL_MAIN2,0,0)==DUEL_OK&&test_game.winner<0);
    /* Opening hands are checked after the historical first-player draw. */
    uint16_t opening[40];for(unsigned i=0;i<40;++i)opening[i]=pieces[i%5];unsigned opening_wins=0;for(unsigned seed=1;seed<=32;++seed){check(duel_start(&test_game,duel_card_definitions,opening,40,opening,40,seed,seed&1)==DUEL_OK);unsigned one=duel_exodia_complete(&test_game,0),two=duel_exodia_complete(&test_game,1);check(test_game.winner==(one&&two?2:one?0:two?1:-1));opening_wins+=test_game.winner>=0;}check(opening_wins);
    uint16_t deck[48];for(unsigned i=0;i<42;++i)deck[i]=duel_original_deck[i];for(unsigned i=0;i<6;++i)deck[42+i]=pieces[i%5];unsigned completed=0,exodia_wins=0;
    for(unsigned seed=1;seed<=20;++seed){check(duel_start(&test_game,duel_card_definitions,deck,48,deck,48,seed+2700,seed&1)==DUEL_OK);check(duel_fusion_setup(&test_game,duel_fusion_recipes,DUEL_FUSION_RECIPE_COUNT,duel_original_fusion_deck,1,duel_original_fusion_deck,1)==DUEL_OK);check(duel_equip_setup(&test_game,duel_equip_rules,DUEL_EQUIP_RULE_COUNT)==DUEL_OK);unsigned actions=0;while(test_game.winner<0&&actions++<5000){DuelCommand a;check(duel_ai_decide(&test_game,decision_player(),&a));int result=duel_command(&test_game,&a);
#ifdef _WIN32
        if(result!=DUEL_OK)fprintf(stderr,"exodia seed %u action %u source %u result %d\n",seed,a.action,a.source,result);
#endif
        check(result==DUEL_OK);check(owned_cards(&test_game,0)==49&&owned_cards(&test_game,1)==49);}check(test_game.winner>=0);completed+=test_game.winner>=0;exodia_wins+=test_game.winner>=0&&(duel_exodia_complete(&test_game,0)||duel_exodia_complete(&test_game,1));}
    check(completed==20);native_exodia_test_result[0]=checks-initial;native_exodia_test_result[1]=matrix;native_exodia_test_result[2]=completed;native_exodia_test_result[3]=opening_wins;native_exodia_test_result[4]=exodia_wins;
}
