        if(name==1517){before=duel_state_hash(&test_game);check(command(DUEL_ACTION_POSITION,0,0,0,DUEL_FACEUP_ATTACK,0)==DUEL_NOT_ALLOWED&&duel_state_hash(&test_game)==before);}
