        spirit_position_fixture(side,name);test_game.players[1-side].monsters[0].position=DUEL_FACEDOWN_DEFENSE;check(spirit_position_phase(name)==DUEL_OK&&!test_game.choice.kind);
        if(name==1519){spirit_position_fixture(side,name);check(spirit_position_phase(name)==DUEL_OK&&choose(side,DUEL_NO_SLOT)==DUEL_OK&&test_game.players[1-side].monsters[0].position==DUEL_FACEUP_ATTACK);}
        else {spirit_position_fixture(side,name);test_game.players[1-side].skip_next_standby=1;check(spirit_position_phase(name)==DUEL_OK&&!test_game.choice.kind&&test_game.players[1-side].monsters[0].position==DUEL_FACEUP_ATTACK);}
