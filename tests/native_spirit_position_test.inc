    for(unsigned i=0;i<sizeof(original_spirit_position_cases)/sizeof(original_spirit_position_cases[0]);++i){const unsigned *v=original_spirit_position_cases[i];if(v[4]){++reference;continue;}unsigned name=v[0],side=v[1];spirit_position_fixture(side,name);test_game.players[side].monsters[0]=slot(0,side,0);test_game.players[side].monsters[v[2]]=slot(simple_record(name),side,v[3]==1?2:v[3]==2?0:1);test_game.players[side].monsters[v[2]].serial=99;check(spirit_position_phase(name)==DUEL_OK);check((test_game.choice.kind==DUEL_CHOICE_SPIRIT_POSITION)==v[5]);if(v[5]){check(test_game.choice.player==side&&duel_choice_options(&test_game,options,DUEL_OPTION_MAX)==(name==1519?2:1));check(choose(side,0)==DUEL_OK&&test_game.players[1-side].monsters[0].position==DUEL_FACEUP_DEFENSE);check(test_game.players[1-side].monsters[0].position_lock_until==(name==1517?3:0));}++matrix;}
    for(unsigned side=0;side<2;++side)for(unsigned ni=0;ni<2;++ni){unsigned name=ni?1519:1517;special_fixture(side,name);unsigned cost=test_game.players[side].grave_count;check(command(DUEL_ACTION_ACTIVATE_HAND,0,0,0,0,0)==DUEL_OK);for(unsigned i=0;i<cost;++i)check(choose(side,0)==DUEL_OK);check(choose(side,0)==DUEL_OK&&test_game.players[side].monsters[0].properly_summoned);
        /* A face-down monster is not exposed as a target. Lord of D. also
