#include "original_spirit_position_cases.h"
volatile uint32_t native_spirit_position_test_result[5];
static void spirit_position_fixture(unsigned side,unsigned name){expansion_fixture(1-side);test_game.players[side].monsters[0]=slot(simple_record(name),side,0);test_game.players[side].monsters[0].serial=99;test_game.players[1-side].monsters[0]=slot(550,1-side,0);test_game.players[1-side].monsters[0].serial=100;test_game.phase=name==1517?DUEL_DRAW:DUEL_MAIN1;}
