 for(unsigned actor=0;actor<2;++actor)for(unsigned name=0;name<3;++name){pair_fixture(actor);unsigned target=(unsigned[]){1116,461,1336}[name];redirect_place(actor,1,target,2,201);pair_chain(1112,actor);test_game.chain[0].source_slot=1;test_game.chain[0].source_serial=200;pass_chain();DuelSlot *s=&test_game.players[actor].monsters[1];check(s->ignition_turn==test_game.turn&&s->flip_armed&&s->destroy_end_turn==test_game.turn);check(name==2?s->attacked==1:s->control_used==1);++flows;}
