    for(unsigned n=0;n<sizeof(original_equip_end_timer_cases)/sizeof(original_equip_end_timer_cases[0]);++n){const int *v=original_equip_end_timer_cases[n];if(!v[5]){++reference;continue;}equip_end_fixture(v[0],v[1],v[2],v[3],v[4]);unsigned owned0=owned_cards(&test_game,0),owned1=owned_cards(&test_game,1);check(command(DUEL_ACTION_PHASE,0,0,DUEL_END,0,0)==DUEL_OK);pass_chain();check((!test_game.players[v[2]].monsters[0].card)==v[7]);check(test_game.players[v[1]].hand_count==(unsigned)(v[8]+(v[1]!=v[0])));if(!v[7])check(test_game.players[v[1]].backrow[0].control_used==v[3]+(v[6]&&v[3]<15));check(owned_cards(&test_game,0)==owned0&&owned_cards(&test_game,1)==owned1);++matrix;}
