    }
    uint16_t deck[44];for(unsigned i=0;i<40;++i)deck[i]=duel_original_deck[i];deck[40]=deck[41]=simple_record(1548);deck[42]=simple_record(77);deck[43]=expansion_effect_card(DUEL_E_CHANGE_HEART);unsigned completed=0,activations=0;
