        equip_end_fixture(side,owner,side,1,0);dynamic_equip_attach(side,1,simple_record(303),100);check(command(DUEL_ACTION_PHASE,0,0,DUEL_END,0,0)==DUEL_OK);pass_chain();check(!test_game.players[side].monsters[0].card&&!test_game.players[side].backrow[1].card&&test_game.players[side].grave_count==2&&test_game.players[owner].hand[0]==simple_record(1548));
