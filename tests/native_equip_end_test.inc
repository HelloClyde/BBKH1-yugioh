    check(completed==10&&activations);native_equip_end_test_result[0]=checks-initial;native_equip_end_test_result[1]=matrix;native_equip_end_test_result[2]=completed;native_equip_end_test_result[3]=activations;native_equip_end_test_result[4]=reference;
