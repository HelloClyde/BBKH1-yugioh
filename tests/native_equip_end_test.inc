static void equip_end_fixture(unsigned actor,unsigned owner,unsigned host,unsigned age,unsigned disabled){expansion_fixture(actor);test_game.players[host].monsters[0]=slot(simple_record(77),host,0);test_game.players[host].monsters[0].serial=100;test_game.next_serial=100;dynamic_equip_attach(owner,0,simple_record(1548),100);test_game.players[owner].backrow[0].control_used=age;if(disabled)expansion_place(1-owner,4,1154);}
