    for(unsigned n=0;n<sizeof(original_mask_dispel_standby_cases)/sizeof(original_mask_dispel_standby_cases[0]);++n){const int *v=original_mask_dispel_standby_cases[n];if(v[4]){++reference;continue;}dispel_fixture(v[0],v[1],1008,0);test_game.players[v[0]].backrow[0].effect_active=1;test_game.players[v[0]].backrow[0].link_serial=v[3]?100:0;if(v[2])expansion_place(1-v[0],4,1154);test_game.phase=DUEL_DRAW;unsigned life=test_game.players[v[1]].life;check(command(DUEL_ACTION_PHASE,0,0,DUEL_STANDBY,0,0)==DUEL_OK);pass_chain();check(test_game.players[v[1]].life==life-500*v[5]);++matrix;}
    for(unsigned side=0;side<2;++side){unsigned enemy=1-side;
