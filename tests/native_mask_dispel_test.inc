    for(unsigned n=0;n<sizeof(original_mask_dispel_target_cases)/sizeof(original_mask_dispel_target_cases[0]);++n){const int *v=original_mask_dispel_target_cases[n];pair_fixture(v[0]);test_game.players[v[0]].backrow[1]=slot(v[1],v[0],0);test_game.players[v[0]].backrow[1].serial=100;check(duel_equip_can_target_for(&test_game,v[0],simple_record(1417),v[0],1)==v[2]);++matrix;}
