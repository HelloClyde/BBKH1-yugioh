    }
    uint16_t deck[44];for(unsigned i=0;i<40;++i)deck[i]=duel_original_deck[i];deck[40]=deck[41]=simple_record(1417);deck[42]=deck[43]=simple_record(333);unsigned completed=0,effects=0;
