#include "original_mask_dispel_cases.h"
volatile uint32_t native_mask_dispel_test_result[6];
static void dispel_fixture(unsigned actor,unsigned host,unsigned name,unsigned position){pair_fixture(actor);test_game.players[actor].backrow[0]=slot(simple_record(1417),actor,0);test_game.players[actor].backrow[0].serial=200;test_game.players[host].backrow[1]=slot(simple_record(name),host,position);test_game.players[host].backrow[1].serial=100;}
