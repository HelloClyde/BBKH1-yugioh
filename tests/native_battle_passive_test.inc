        for(unsigned dark=0;dark<2;++dark)for(unsigned hidden=0;hidden<2;++hidden){expansion_fixture(side);test_game.phase=DUEL_BATTLE;unsigned target=0;for(unsigned i=1;i<DUEL_CARD_COUNT;++i)if(duel_card_definitions[i].family==DUEL_MONSTER&&duel_card_definitions[i].effect==DUEL_E_NONE&&(duel_card_definitions[i].attribute==2)==dark){target=i;break;}check(target!=0);test_game.players[side].monsters[0]=slot(simple_record(409),side,0);test_game.players[enemy].monsters[0]=slot(target,enemy,hidden?2:0);test_game.players[enemy].monsters[0].temporary_attack=3000-duel_card_definitions[target].attack;test_game.players[enemy].monsters[0].temporary_defense=3000-duel_card_definitions[target].defense;check(command(DUEL_ACTION_ATTACK,0,enemy,0,0,0)==DUEL_OK);check((test_game.players[enemy].monsters[0].card==0)==dark);}
    }
    uint16_t deck[48];const unsigned extra[8]={1251,1251,1231,1231,409,409,609,609};for(unsigned i=0;i<40;++i)deck[i]=duel_original_deck[i];for(unsigned i=0;i<8;++i)deck[40+i]=simple_record(extra[i]);unsigned completed=0;
    for(unsigned seed=1;seed<=10;++seed){check(duel_start(&test_game,duel_card_definitions,deck,48,deck,48,seed+5500,seed&1)==DUEL_OK);unsigned actions=0;while(test_game.winner<0&&actions++<7000){check(duel_ai_decide(&test_game,decision_player(),&c));int result=duel_command(&test_game,&c);check(result==DUEL_OK);if(result!=DUEL_OK)break;check(owned_cards(&test_game,0)==48&&owned_cards(&test_game,1)==48);}check(test_game.winner>=0);completed+=test_game.winner>=0;}
    check(completed==10);native_battle_passive_test_result[0]=checks-initial;native_battle_passive_test_result[1]=matrix;native_battle_passive_test_result[2]=completed;
}
