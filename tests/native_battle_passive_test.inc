        expansion_fixture(side);test_game.phase=DUEL_BATTLE;test_game.players[side].monsters[0]=slot(simple_record(1231),side,0);test_game.players[enemy].monsters[0]=slot(simple_record(0),enemy,0);check(command(DUEL_ACTION_ATTACK,0,enemy,0,0,0)==DUEL_OK&&test_game.players[side].monsters[0].card&&test_game.players[side].life==8000&&duel_attack_value(&test_game,enemy,0)==2500);check(command(DUEL_ACTION_PHASE,0,0,DUEL_END,0,0)==DUEL_OK&&duel_attack_value(&test_game,enemy,0)==3000);
        expansion_fixture(side);test_game.phase=DUEL_BATTLE;test_game.players[side].monsters[0]=slot(simple_record(0),side,0);test_game.players[enemy].monsters[0]=slot(simple_record(1231),enemy,0);unsigned difference=3000-duel_card_definitions[simple_record(1231)].attack;check(command(DUEL_ACTION_ATTACK,0,enemy,0,0,0)==DUEL_OK&&!test_game.players[enemy].monsters[0].card&&test_game.players[enemy].life==8000-difference);
        /* Spider's surviving DARK target is effect-destroyed, including
