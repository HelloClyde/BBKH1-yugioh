           permits the ordinary difference in LP. */
        for(unsigned role=0;role<2;++role)for(unsigned high=0;high<2;++high){expansion_fixture(side);test_game.phase=DUEL_BATTLE;unsigned owner=side^role,strong=1-owner;test_game.players[owner].monsters[0]=slot(simple_record(1251),owner,0);test_game.players[strong].monsters[0]=slot(550,strong,0);test_game.players[strong].monsters[0].temporary_attack=high?100: -1;int a=duel_attack_value(&test_game,side,0),b=duel_attack_value(&test_game,enemy,0);check(command(DUEL_ACTION_ATTACK,0,enemy,0,0,0)==DUEL_OK);check((test_game.players[owner].monsters[0].card!=0)==high&&test_game.players[owner].life==8000-(a>b?a-b:b-a));}
        /* Rocket survives attacking the stronger Blue-Eyes with no battle
