#include "original_battle_passive_cases.h"
volatile uint32_t native_battle_passive_test_result[5];
static void battle_passive_tests(void){unsigned initial=checks,matrix=0;DuelCommand c;
    for(unsigned n=0;n<sizeof(original_battle_passive_cases)/sizeof(original_battle_passive_cases[0]);++n){const unsigned *v=original_battle_passive_cases[n];unsigned owner=v[1]^v[2];expansion_fixture(v[3]);test_game.phase=v[4];test_game.players[owner].monsters[0]=slot(simple_record(v[0]),owner,0);unsigned protection=duel_battle_protection(&test_game,owner,0,v[5]);check((protection&1)==v[6]&&((protection&2)!=0)==(v[7]==0));test_game.players[owner].monsters[0].position=DUEL_FACEDOWN_DEFENSE;check(!duel_battle_protection(&test_game,owner,0,v[5]));++matrix;}
    for(unsigned n=0;n<sizeof(original_lizard_cases)/sizeof(original_lizard_cases[0]);++n){const unsigned *v=original_lizard_cases[n];unsigned side=v[0],enemy=1-side,attacker=0;for(unsigned i=1;i<DUEL_CARD_COUNT;++i)if(duel_card_definitions[i].family==DUEL_MONSTER&&duel_card_definitions[i].race==v[1]&&duel_card_definitions[i].effect==DUEL_E_NONE){attacker=i;break;}if(!attacker)continue;expansion_fixture(side);test_game.phase=DUEL_BATTLE;test_game.players[side].monsters[0]=slot(attacker,side,0);test_game.players[side].monsters[0].temporary_attack=3000-duel_card_definitions[attacker].attack;test_game.players[enemy].monsters[0]=slot(simple_record(609),enemy,2);check(command(DUEL_ACTION_ATTACK,0,enemy,0,0,0)==DUEL_OK&&test_game.players[side].monsters[0].no_attack_until==(v[2]?5:0));test_game.turn=5;test_game.players[side].monsters[0].attacked=0;check((command(DUEL_ACTION_ATTACK,0,enemy,DUEL_NO_SLOT,0,0)==DUEL_OK)==!v[2]);test_game.turn=7;test_game.players[side].monsters[0].attacked=0;check(command(DUEL_ACTION_ATTACK,0,enemy,DUEL_NO_SLOT,0,0)==DUEL_OK);++matrix;}
    for(unsigned side=0;side<2;++side){unsigned enemy=1-side;
        /* Guardian can be the attacker or defender. Its protection follows
