    for(unsigned n=0;n<sizeof(original_mushroom_status_cases)/sizeof(original_mushroom_status_cases[0]);++n){const unsigned *v=original_mushroom_status_cases[n];mushroom_fixture(v[0],v[1],0);test_game.chain_count=1;test_game.response_player=1-v[0];DuelChainLink *link=&test_game.chain[0];link->card=simple_record(552);link->command.player=v[0];link->source_slot=v[1];link->source_serial=100;link->effect_activation=1;link->effect_negated=v[2];link->speed=1;pass_chain();check(control_test_owner(100)==v[3]&&test_game.control_layer_count==1);++matrix;}
    for(unsigned n=0;n<sizeof(original_mushroom_outer_cases)/sizeof(original_mushroom_outer_cases[0]);++n){const unsigned *v=original_mushroom_outer_cases[n];mushroom_fixture(v[0],v[1],v[2]==3?DUEL_FACEDOWN_DEFENSE:DUEL_FACEUP_ATTACK);DuelSlot *source=&test_game.players[v[0]].monsters[v[1]];if(v[2]==1)*source=empty_slot();if(v[2]==2){source->card=24;source->serial=200;}test_game.chain_count=1;test_game.response_player=1-v[0];DuelChainLink *link=&test_game.chain[0];link->card=simple_record(552);link->command.player=v[0];link->source_slot=v[1];link->source_serial=100;link->effect_activation=1;link->effect_negated=v[3];link->speed=1;pass_chain();check(test_game.control_layer_count==(v[2]==1?0:1));if(v[2]!=1)check(control_test_owner(v[2]==2?200:100)==1-v[0]);++matrix;}
    for(unsigned n=0;n<sizeof(original_mushroom_cost_cases)/sizeof(original_mushroom_cost_cases[0]);++n){const unsigned *v=original_mushroom_cost_cases[n];mushroom_fixture(v[0],4,0);test_game.phase=DUEL_MAIN1;check(command(DUEL_ACTION_PHASE,0,0,DUEL_END,0,0)==DUEL_OK&&test_game.choice.kind==DUEL_CHOICE_MUSHROOM);check(choose(v[0],v[1]?0:DUEL_NO_SLOT)==DUEL_OK);pass_chain();check(test_game.players[v[0]].life==8000-(int)v[2]&&control_test_owner(100)==(v[1]?1-v[0]:v[0]));++matrix;}
