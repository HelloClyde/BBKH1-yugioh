        mushroom_fixture(side,0,0);for(unsigned i=0;i<4;++i)test_game.players[enemy].monsters[i]=slot(24,enemy,0);test_game.players[enemy].grave_count=1;test_game.players[enemy].grave[0]=24;test_game.players[enemy].backrow[0]=slot(expansion_effect_card(DUEL_E_CALL_HAUNTED),enemy,2);test_game.players[enemy].backrow[0].set_turn=1;test_game.phase=DUEL_MAIN1;check(command(DUEL_ACTION_PHASE,0,0,DUEL_END,0,0)==DUEL_OK&&choose(side,0)==DUEL_OK);c=(DuelCommand){enemy,DUEL_ACTION_ACTIVATE_BACKROW,0,enemy,0};check(duel_command(&test_game,&c)==DUEL_OK);pass_chain();check(control_test_owner(100)==DUEL_NO_SLOT&&test_game.players[side].grave_count==1&&test_game.players[side].life==7500);
    }
    unsigned completed=0,choices=0;uint16_t deck[48];const unsigned extra[8]={552,552,552,347,1530,1079,939,1061};for(unsigned i=0;i<40;++i)deck[i]=duel_original_deck[i];for(unsigned i=0;i<8;++i)deck[40+i]=simple_record(extra[i]);
    for(unsigned seed=1;seed<=10;++seed){check(duel_start(&test_game,duel_card_definitions,deck,48,deck,48,seed+7900,seed&1)==DUEL_OK);unsigned actions=0;while(test_game.winner<0&&actions++<7000){check(duel_ai_decide(&test_game,decision_player(),&c));choices+=c.action==DUEL_ACTION_CHOOSE&&test_game.choice.kind==DUEL_CHOICE_MUSHROOM;int result=duel_command(&test_game,&c);check(result==DUEL_OK);if(result!=DUEL_OK)break;check(owned_cards(&test_game,0)==48&&owned_cards(&test_game,1)==48);}check(test_game.winner>=0);completed+=test_game.winner>=0;}
    check(completed==10);native_mushroom_test_result[0]=checks-initial;native_mushroom_test_result[1]=matrix;native_mushroom_test_result[2]=completed;native_mushroom_test_result[3]=choices;native_mushroom_test_result[4]=reference_only;
