        mushroom_fixture(side,0,0);test_game.phase=DUEL_DRAW;test_game.players[side].life=300;check(command(DUEL_ACTION_PHASE,0,0,DUEL_MAIN1,0,0)==DUEL_OK&&test_game.winner==(int)enemy&&test_game.players[side].life==0);
