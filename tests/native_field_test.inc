    field_fixture(490);field_place(1,1008,1);check(command(DUEL_ACTION_SET_BACKROW,0,0,DUEL_FIELD_SLOT,0,0)==DUEL_OK&&test_game.players[1].field.card==1008&&!test_game.players[0].field.effect_active&&duel_attack_value(&test_game,0,0)==1700);check(command(DUEL_ACTION_ACTIVATE_BACKROW,DUEL_FIELD_SLOT,0,0,0,0)==DUEL_OK&&test_game.players[0].field.effect_active&&!test_game.players[1].field.card&&test_game.players[1].grave_count==1);
    field_fixture(490);field_place(1,1008,0);check(command(DUEL_ACTION_ACTIVATE_HAND,0,0,0,0,0)==DUEL_OK&&test_game.players[1].field.card==1008&&test_game.players[1].field.position==DUEL_FACEDOWN_DEFENSE);
    field_fixture(134);field_place(0,490,1);check(command(DUEL_ACTION_SET_BACKROW,0,0,DUEL_FIELD_SLOT,0,0)==DUEL_OK&&test_game.players[0].grave_count==1&&test_game.players[0].grave[0]==490&&!test_game.players[0].field.effect_active);
    /* Source destruction or activation negation prevents terrain application
