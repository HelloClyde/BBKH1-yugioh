    field_fixture(490);field_place(1,1008,1);test_game.players[1].backrow[0]=slot(316,1,DUEL_FACEDOWN_DEFENSE);check(command(DUEL_ACTION_ACTIVATE_HAND,0,0,0,0,0)==DUEL_OK&&test_game.response_player==1&&!test_game.players[0].field.effect_active&&test_game.players[1].field.effect_active);c=(DuelCommand){1,DUEL_ACTION_ACTIVATE_BACKROW,0,0,DUEL_FIELD_SLOT};check(duel_command(&test_game,&c)==DUEL_OK&&!test_game.players[0].field.card&&test_game.players[1].field.card==1008);
    field_fixture(490);field_place(1,1008,1);test_game.players[1].backrow[0]=slot(893,1,DUEL_FACEDOWN_DEFENSE);test_game.players[1].hand_count=1;test_game.players[1].hand[0]=24;check(command(DUEL_ACTION_ACTIVATE_HAND,0,0,0,0,0)==DUEL_OK&&test_game.response_player==1);c=(DuelCommand){1,DUEL_ACTION_ACTIVATE_BACKROW,0,0,0,0,0,0};check(duel_command(&test_game,&c)==DUEL_OK&&!test_game.players[0].field.card&&test_game.players[1].field.card==1008);
    /* Slot5 is a separate speed1 field, never a sixth response backrow.
       Rejection must preserve the entire pending response and both zones. */
    field_fixture(490);field_place(1,1008,0);test_game.players[1].backrow[0]=slot(316,1,DUEL_FACEDOWN_DEFENSE);check(command(DUEL_ACTION_ACTIVATE_HAND,0,0,0,0,0)==DUEL_OK&&test_game.response_player==1);uint32_t response_hash=duel_state_hash(&test_game);c=(DuelCommand){1,DUEL_ACTION_ACTIVATE_BACKROW,DUEL_FIELD_SLOT};check(duel_command(&test_game,&c)==DUEL_NOT_ALLOWED&&duel_state_hash(&test_game)==response_hash);
    /* Targeted and mass backrow removal include field slot5. */
    field_fixture(316);field_place(1,490,1);check(command(DUEL_ACTION_ACTIVATE_HAND,0,1,DUEL_FIELD_SLOT,0,0)==DUEL_OK&&!test_game.players[1].field.card&&test_game.players[1].grave_count==1&&duel_attack_value(&test_game,0,0)==1700);
    field_fixture(695);field_place(0,490,1);field_place(1,1008,0);check(command(DUEL_ACTION_ACTIVATE_HAND,0,0,0,0,0)==DUEL_OK&&test_game.players[0].field.card==490&&!test_game.players[1].field.card);
    field_fixture(729);field_place(0,490,1);field_place(1,1008,0);check(command(DUEL_ACTION_ACTIVATE_HAND,0,0,0,0,0)==DUEL_OK&&!test_game.players[0].field.card&&!test_game.players[1].field.card&&test_game.players[0].hand_count==1&&test_game.players[0].hand[0]==490&&test_game.players[1].hand_count==6);
    field_fixture(490);uint32_t hash=duel_state_hash(&test_game);check(command(DUEL_ACTION_SET_BACKROW,0,0,0,0,0)==DUEL_BAD_TARGET&&duel_state_hash(&test_game)==hash);field_fixture(894);hash=duel_state_hash(&test_game);check(command(DUEL_ACTION_SET_BACKROW,0,0,DUEL_FIELD_SLOT,0,0)==DUEL_BAD_TARGET&&duel_state_hash(&test_game)==hash);
    reset();DuelFieldRule invalid=duel_field_rules[0];invalid.negative=invalid.positive;check(duel_field_setup(&test_game,&invalid,1)==DUEL_BAD_ARGUMENT);field_place(0,490,1);check(duel_field_setup(&test_game,duel_field_rules,DUEL_FIELD_RULE_COUNT)==DUEL_NOT_ALLOWED);
    native_field_test_result[0]=checks-initial;native_field_test_result[1]=sizeof(original_field_cases)/sizeof(original_field_cases[0]);
    uint16_t deck[55];for(unsigned i=0;i<42;++i)deck[i]=duel_original_deck[i];for(unsigned i=0;i<13;++i)deck[42+i]=duel_field_rules[i].card;
    for(unsigned seed=1;seed<=30;++seed){check(duel_start(&test_game,duel_card_definitions,deck,55,deck,55,seed+1200,seed&1)==DUEL_OK);check(duel_fusion_setup(&test_game,duel_fusion_recipes,DUEL_FUSION_RECIPE_COUNT,duel_original_fusion_deck,1,duel_original_fusion_deck,1)==DUEL_OK);check(duel_equip_setup(&test_game,duel_equip_rules,DUEL_EQUIP_RULE_COUNT)==DUEL_OK&&duel_life_setup(&test_game,duel_life_rules,DUEL_LIFE_RULE_COUNT)==DUEL_OK&&duel_recall_setup(&test_game,duel_recall_rules,DUEL_RECALL_RULE_COUNT)==DUEL_OK&&duel_field_setup(&test_game,duel_field_rules,DUEL_FIELD_RULE_COUNT)==DUEL_OK);
        unsigned actions=0;while(test_game.winner<0&&actions++<3000){DuelCommand a;check(duel_ai_decide(&test_game,decision_player(),&a));if(a.action==DUEL_ACTION_ACTIVATE_HAND&&test_game.cards[test_game.players[a.player].hand[a.source]].effect==DUEL_E_FIELD)++native_field_test_result[3];check(duel_command(&test_game,&a)==DUEL_OK);check(owned_cards(&test_game,0)==56&&owned_cards(&test_game,1)==56);check(!(test_game.players[0].field.effect_active&&test_game.players[1].field.effect_active));}check(test_game.winner>=0);if(test_game.winner>=0)++native_field_test_result[2];}
    check(native_field_test_result[2]==30&&native_field_test_result[3]>0);native_field_test_result[4]=checks-initial;
}
