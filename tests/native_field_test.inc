/* Explicit CPU-model fixtures and independent original field-delta vectors. */
#include "original_field_cases.h"
volatile unsigned native_field_test_result[6];
static DuelCardDef field_fixture_defs[DUEL_CARD_COUNT];
static void field_fixture(unsigned card){reset();test_game.turn=3;test_game.players[0].hand_count=1;test_game.players[0].hand[0]=card;test_game.players[0].monsters[0]=slot(24,0,DUEL_FACEUP_ATTACK);test_game.players[0].monsters[0].serial=100;test_game.next_serial=100;}
static void field_place(unsigned side,unsigned card,unsigned active){test_game.players[side].field=slot(card,side,active?DUEL_FACEUP_ATTACK:DUEL_FACEDOWN_DEFENSE);test_game.players[side].field.serial=++test_game.next_serial;test_game.players[side].field.effect_active=active;}
static void field_tests(void){
    unsigned initial=checks;DuelCommand c;
    for(unsigned i=0;i<DUEL_CARD_COUNT;++i)field_fixture_defs[i]=duel_card_definitions[i];
    for(unsigned n=0;n<sizeof(original_field_cases)/sizeof(original_field_cases[0]);++n){const int *v=original_field_cases[n];unsigned card=0;for(unsigned i=0;i<DUEL_FIELD_RULE_COUNT;++i)if(duel_card_definitions[duel_field_rules[i].card].name_group==v[0])card=duel_field_rules[i].card;check(card!=0);reset();test_game.cards=field_fixture_defs;DuelCardDef *host=&field_fixture_defs[24];host->race=v[1];host->attribute=v[2];host->attack=host->defense=1000;field_place(n&1,card,1);
        for(unsigned side=0;side<2;++side){test_game.players[side].monsters[0]=slot(24,side,v[3]?DUEL_FACEUP_DEFENSE:DUEL_FACEUP_ATTACK);check(duel_attack_value(&test_game,side,0)==1000+v[4]);check(duel_defense_value(&test_game,side,0)==1000+v[5]);test_game.players[side].monsters[0].position=DUEL_FACEDOWN_DEFENSE;check(duel_attack_value(&test_game,side,0)==1000&&duel_defense_value(&test_game,side,0)==1000);}
    }
    /* Five ordinary spell/trap slots do not consume the independent field. */
    field_fixture(490);for(unsigned i=0;i<5;++i)test_game.players[0].backrow[i]=slot(851,0,DUEL_FACEDOWN_DEFENSE);unsigned owned=owned_cards(&test_game,0);check(command(DUEL_ACTION_ACTIVATE_HAND,0,0,0,0,0)==DUEL_OK&&test_game.players[0].field.card==490&&test_game.players[0].field.effect_active&&duel_attack_value(&test_game,0,0)==1900&&owned_cards(&test_game,0)==owned);for(unsigned i=0;i<5;++i)check(test_game.players[0].backrow[i].card==851);
    /* A set field replaces only its owner's old field; it grants no bonus and
