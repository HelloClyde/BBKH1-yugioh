#include "original_protection_counter_cases.h"
volatile uint32_t native_protection_counter_test_result[5];
static void protection_counter_fixture(unsigned side,unsigned name){expansion_fixture(1-side);unsigned source=name==1019?335:name==1022?336:671;test_game.players[1-side].hand_count=1;test_game.players[1-side].hand[0]=simple_record(source);test_game.players[side].backrow[0]=slot(simple_record(name),side,2);test_game.players[side].monsters[0]=slot(550,side,0);test_game.players[1-side].monsters[0]=slot(550,1-side,0);test_game.players[1-side].backrow[2]=slot(simple_record(1061),1-side,2);test_game.players[side].field=slot(simple_record(333),side,2);test_game.players[1-side].field=slot(simple_record(333),1-side,2);}
static void protection_counter_tests(void){unsigned initial=checks,matrix=0,excluded=0;DuelCommand c;DuelActivationOption options[12];
    /* Compare the original resolver identity/owner predicate with public
       response enumeration. Resolver-phase and effect-suppression vectors
