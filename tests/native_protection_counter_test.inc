    for(unsigned i=0;i<sizeof(original_protection_counters)/sizeof(original_protection_counters[0]);++i){const unsigned *v=original_protection_counters[i];if(v[4]||v[5]!=128){++excluded;continue;}expansion_fixture(v[2]);test_game.response_player=v[1];test_game.chain_count=1;test_game.chain[0].card=simple_record(v[3]);test_game.chain[0].speed=1;test_game.chain[0].command.player=v[2];test_game.players[v[1]].backrow[0]=slot(simple_record(v[0]),v[1],2);check((duel_response_options(&test_game,v[1],options,12)!=0)==v[6]);++matrix;}
    for(unsigned side=0;side<2;++side)for(unsigned k=0;k<3;++k)for(unsigned suppressed=0;suppressed<2;++suppressed){unsigned name=k==0?1019:k==1?1022:1062;protection_counter_fixture(side,name);if(suppressed)expansion_place(side,4,1033);check(command(DUEL_ACTION_ACTIVATE_HAND,0,0,0,0,0)==DUEL_OK&&test_game.response_player==side);c=(DuelCommand){side,DUEL_ACTION_ACTIVATE_BACKROW,0};check(duel_command(&test_game,&c)==DUEL_OK&&!test_game.chain_count);if(!suppressed){check(!test_game.chain[0].negated&&test_game.chain[0].effect_negated);if(k==2){check(test_game.players[side].monsters[0].card==550&&test_game.players[1-side].monsters[0].card==550);check(test_game.players[side].field.card&& !test_game.players[1-side].field.card&&!test_game.players[1-side].backrow[2].card);}else check(test_game.players[side].monsters[0].card==550&&!test_game.players[1-side].monsters[0].card&&test_game.players[side].field.card&&test_game.players[1-side].field.card);}else {check(!test_game.chain[0].effect_negated);if(k==2)check(!test_game.players[side].field.card&&test_game.players[1-side].field.card&&test_game.players[1-side].backrow[2].card);else check(!test_game.players[side].monsters[0].card&&(k==0?!test_game.players[1-side].monsters[0].card:test_game.players[1-side].monsters[0].card==550));}check(!test_game.players[side].backrow[0].card);++matrix;}
    for(unsigned side=0;side<2;++side)for(unsigned k=0;k<3;++k){unsigned name=k==0?1019:k==1?1022:1062;protection_counter_fixture(side,name);test_game.players[1-side].backrow[0]=slot(simple_record(1030),1-side,2);check(command(DUEL_ACTION_ACTIVATE_HAND,0,0,0,0,0)==DUEL_OK);c=(DuelCommand){side,DUEL_ACTION_ACTIVATE_BACKROW,0};check(duel_command(&test_game,&c)==DUEL_OK&&test_game.response_player==1-side);c=(DuelCommand){1-side,DUEL_ACTION_ACTIVATE_BACKROW,0};check(duel_command(&test_game,&c)==DUEL_OK&&test_game.players[1-side].life==7000);if(k==2)check(!test_game.players[side].field.card&&test_game.players[1-side].field.card);else check(!test_game.players[side].monsters[0].card&&(k==0?!test_game.players[1-side].monsters[0].card:test_game.players[1-side].monsters[0].card==550));
        /* MST destroys the activated trap source but does not negate it. */
        protection_counter_fixture(side,name);test_game.players[1-side].backrow[0]=slot(316,1-side,2);check(command(DUEL_ACTION_ACTIVATE_HAND,0,0,0,0,0)==DUEL_OK);c=(DuelCommand){side,DUEL_ACTION_ACTIVATE_BACKROW,0};check(duel_command(&test_game,&c)==DUEL_OK&&test_game.response_player==1-side);c=(DuelCommand){1-side,DUEL_ACTION_ACTIVATE_BACKROW,0,side,0};check(duel_command(&test_game,&c)==DUEL_OK);if(k==2)check(test_game.players[side].field.card&&!test_game.players[1-side].field.card);else check(test_game.players[side].monsters[0].card==550&&!test_game.players[1-side].monsters[0].card);++matrix;}
    uint16_t deck[50];const unsigned added[8]={1019,1022,1062,335,336,671,1030,316};for(unsigned i=0;i<42;++i)deck[i]=duel_original_deck[i];for(unsigned i=0;i<8;++i)deck[42+i]=simple_record(added[i]);unsigned completed=0,activations=0;
    for(unsigned seed=1;seed<=20;++seed){check(duel_start(&test_game,duel_card_definitions,deck,50,deck,50,seed+3600,seed&1)==DUEL_OK&&duel_equip_setup(&test_game,duel_equip_rules,DUEL_EQUIP_RULE_COUNT)==DUEL_OK);unsigned actions=0;while(test_game.winner<0&&actions++<6000){check(duel_ai_decide(&test_game,decision_player(),&c));if(c.action==DUEL_ACTION_ACTIVATE_BACKROW){unsigned n=test_game.cards[test_game.players[c.player].backrow[c.source].card].name_group;activations+=n==1019||n==1022||n==1062;}int result=duel_command(&test_game,&c);
#ifdef _WIN32
        if(result!=DUEL_OK)fprintf(stderr,"protection counter seed %u turn %u phase %u action %u result %u\n",seed,test_game.turn,test_game.phase,c.action,result);
