    check(completed==20&&activations);native_protection_counter_test_result[0]=checks-initial;native_protection_counter_test_result[1]=matrix;native_protection_counter_test_result[2]=completed;native_protection_counter_test_result[3]=activations;native_protection_counter_test_result[4]=excluded;
}
