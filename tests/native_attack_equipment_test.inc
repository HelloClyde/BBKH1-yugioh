    }
    for(unsigned active=0;active<2;++active){unsigned enemy=1-active;pair_fixture(active);test_game.phase=DUEL_DRAW;test_game.players[enemy].life=500;test_game.players[active].monsters[0]=slot(simple_record(77),active,0);test_game.players[active].monsters[0].serial=100;test_game.players[enemy].backrow[0]=slot(simple_record(1170),enemy,0);test_game.players[enemy].backrow[0].serial=200;test_game.players[enemy].backrow[0].link_serial=100;test_game.players[enemy].backrow[0].effect_active=1;test_game.players[active].backrow[0]=slot(simple_record(1417),active,0);test_game.players[active].backrow[0].serial=300;test_game.players[active].backrow[0].link_serial=200;test_game.players[active].backrow[0].effect_active=1;check(command(DUEL_ACTION_PHASE,0,0,DUEL_STANDBY,0,0)==DUEL_OK);check(test_game.winner==active&&!test_game.players[enemy].life);}
    uint16_t deck[46];const unsigned extra[6]={735,735,1170,1170,77,77};for(unsigned i=0;i<40;++i)deck[i]=duel_original_deck[i];for(unsigned i=0;i<6;++i)deck[40+i]=simple_record(extra[i]);unsigned completed=0,effects=0;
    for(unsigned seed=0;seed<10;++seed){check(duel_start(&test_game,duel_card_definitions,deck,46,deck,46,11400+seed,seed&1)==DUEL_OK);check(duel_equip_setup(&test_game,duel_equip_rules,DUEL_EQUIP_RULE_COUNT)==DUEL_OK);unsigned actions=0;while(test_game.winner<0&&actions++<7000){check(duel_ai_decide(&test_game,decision_player(),&c));uint32_t before=test_game.event_sequence;int r=duel_command(&test_game,&c);check(r==DUEL_OK);if(r!=DUEL_OK)break;effects+=test_game.event_sequence!=before&&test_game.last_event.type==DUEL_EVENT_SPELL&&(test_game.last_event.card==simple_record(735)||test_game.last_event.card==simple_record(1170));check(owned_cards(&test_game,0)==46&&owned_cards(&test_game,1)==46);check(identity_unique(&test_game));}check(test_game.winner>=0);completed+=test_game.winner>=0;}check(completed==10);native_attack_equipment_test_result[0]=checks-initial;native_attack_equipment_test_result[1]=matrix;native_attack_equipment_test_result[2]=completed;native_attack_equipment_test_result[3]=effects;native_attack_equipment_test_result[4]=reference;
}
