    for(unsigned n=0;n<sizeof(original_attack_equip_parent_cases)/sizeof(original_attack_equip_parent_cases[0]);++n){const int *v=original_attack_equip_parent_cases[n];attack_equip_fixture(v[0],v[1],v[2]?2:1);check(command(DUEL_ACTION_ATTACK,0,v[0],0,0,0)==DUEL_OK);pass_chain();check((test_game.players[v[0]].backrow[0].card==simple_record(v[1]))==v[3]);if(v[3])check(test_game.players[v[0]].backrow[0].serial==200&&test_game.players[v[0]].backrow[0].link_serial==100&&!test_game.players[v[0]].monsters[0].card&&!test_game.battle_pending&&test_game.players[0].life==8000&&test_game.players[1].life==8000);++matrix;}
    for(unsigned n=0;n<sizeof(original_attack_equip_move_cases)/sizeof(original_attack_equip_move_cases[0]);++n){const int *v=original_attack_equip_move_cases[n];unsigned actor=v[0];attack_equip_fixture(actor,v[1],1);for(unsigned i=0;i<5-v[2];++i){test_game.players[actor].backrow[i]=slot(simple_record(303),actor,2);test_game.players[actor].backrow[i].serial=250+i;}pair_chain(v[1],actor);test_game.chain[0].source_serial=200;test_game.chain[0].source_slot=0;test_game.chain[0].command.target_player=1-actor;test_game.chain[0].command.target=0;test_game.chain[0].target_serial=100;test_game.chain[0].effect_negated=v[3]!=0;pass_chain();check((test_game.players[actor].backrow[4].card==simple_record(v[1]))==v[4]);check(test_game.players[actor].grave_count==v[5]&&!test_game.players[actor].monsters[0].card);if(v[4])check(test_game.players[actor].backrow[4].serial==200&&test_game.players[actor].backrow[4].link_serial==100);++matrix;}
    for(unsigned n=0;n<sizeof(original_attack_equip_standby_cases)/sizeof(original_attack_equip_standby_cases[0]);++n){const int *v=original_attack_equip_standby_cases[n];unsigned actor=v[1],host=v[2],active=1-actor;pair_fixture(active);test_game.phase=DUEL_DRAW;test_game.players[host].monsters[0]=slot(simple_record(v[5]?1326:77),host,0);test_game.players[host].monsters[0].serial=100;test_game.players[actor].backrow[0]=slot(simple_record(v[0]),actor,0);DuelSlot *source=&test_game.players[actor].backrow[0];source->serial=200;source->effect_active=1;source->link_serial=100;source->control_used=v[4];if(v[3])expansion_place(active,4,1154);if(v[5]){test_game.players[host].field=slot(simple_record(333),host,0);test_game.players[host].field.serial=300;test_game.players[host].field.effect_active=1;}check(duel_attack_value(&test_game,host,0)==v[6]);check(command(DUEL_ACTION_PHASE,0,0,DUEL_STANDBY,0,0)==DUEL_OK);pass_chain();if(v[0]==735){check(test_game.players[active].life==8000-v[8]*v[6]);check((test_game.players[host].monsters[0].card==0)==v[8]);check((test_game.players[actor].backrow[0].card==0)==v[7]);}else{check(test_game.players[actor].life==8000+v[9]*((v[6]+1)/2));check(test_game.players[host].monsters[0].serial==100&&test_game.players[actor].backrow[0].serial==200);}++matrix;}
    reference+=sizeof(original_attack_equip_gate_cases)/sizeof(original_attack_equip_gate_cases[0]);
    for(unsigned actor=0;actor<2;++actor)for(unsigned name_index=0;name_index<2;++name_index){unsigned name=name_index?1170:735,enemy=1-actor;
        /* Actual attack cancellation persists with a full backrow; source
