        attack_equip_fixture(actor,name,2);for(unsigned i=0;i<5;++i){test_game.players[actor].backrow[i]=slot(simple_record(303),actor,2);test_game.players[actor].backrow[i].serial=250+i;}check(command(DUEL_ACTION_ATTACK,0,actor,0,0,0)==DUEL_OK);pass_chain();check(!test_game.players[actor].monsters[0].card&&test_game.players[actor].grave_count==1&&test_game.players[actor].life==8000&&test_game.players[enemy].life==8000);
        /* MST removes the field association, leaving the attacker alive. */
