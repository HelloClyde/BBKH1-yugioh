static unsigned optional_set_options(const Duel *d,unsigned side,DuelChoiceOption *options,unsigned capacity){if(empty_zone(d->players[side].backrow)<0)return 0;unsigned count=0;const DuelPlayer *p=&d->players[side];for(unsigned i=0;i<p->hand_count;++i){const DuelCardDef *c=&d->cards[p->hand[i]];if(c->family==DUEL_MONSTER||!duel_card_supported(c)||(c->name_group>=1541&&c->name_group<=1544)||(c->effect==DUEL_E_FIELD&&!field_rule(d,p->hand[i])))continue;if(options&&count<capacity)options[count]=(DuelChoiceOption){p->hand[i],i,DUEL_OPTION_CARD};++count;}if(count){if(options&&count<capacity)options[count]=(DuelChoiceOption){0,DUEL_NO_SLOT,DUEL_OPTION_SKIP};++count;}return count;}
static void optional_set_begin(Duel *d,unsigned side,unsigned card){if(optional_set_options(d,side,0,0))d->choice=(DuelTrigger){DUEL_CHOICE_OPTIONAL_SET,side,card,0};}
static void optional_set_choose(Duel *d,unsigned token){unsigned side=d->choice.player;finish_choice(d);if(token==DUEL_NO_SLOT)return;const DuelPlayer *p=&d->players[side];if(token>=p->hand_count)return;int target=d->cards[p->hand[token]].effect==DUEL_E_FIELD?DUEL_FIELD_SLOT:empty_zone(p->backrow);if(target>=0)set_hand_card(d,side,token,target,1);}
