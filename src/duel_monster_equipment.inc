/* Arbitrary Monster cards may become typed equipment without changing their
 * immutable printed definition. Pending Sword victims belong to a deployment. */
static void sword_remove(Duel *d,unsigned index){DuelSwordQueue *q=&d->sword_jobs;for(unsigned i=index;i+1<q->count;++i){q->source[i]=q->source[i+1];q->victim[i]=q->victim[i+1];q->actor[i]=q->actor[i+1];}if(q->count){--q->count;q->source[q->count]=q->victim[q->count]=0;q->actor[q->count]=0;}}
static void monster_equipment_new_deployment(Duel *d,uint32_t serial){for(unsigned i=0;i<d->sword_jobs.count;)if(d->sword_jobs.source[i]==serial)sword_remove(d,i);else ++i;}
static void sword_capture_battle(Duel *d){unsigned side=d->damage_dealer_side,index=d->damage_dealer_slot;if(side>1||index>=5)return;const DuelSlot *hunter=&d->players[side].monsters[index];if(!hunter->card||d->cards[hunter->card].name_group!=1327||battle_destroyed(d,side,index)||activation_blocked_for_slot(d,hunter->card,hunter->serial))return;DuelSwordQueue *q=&d->sword_jobs;unsigned own=0;for(unsigned i=0;i<q->count;++i)own+=q->source[i]==hunter->serial;for(unsigned i=0;i<d->battle_destroy_count&&own<32&&q->count<320;++i){const DuelTarget *t=&d->battle_destroy[i];const DuelSlot *victim=&d->players[t->player].monsters[t->slot];if(victim->serial==hunter->serial||!victim->card||victim->serial!=t->serial||d->cards[victim->card].family!=DUEL_MONSTER||d->cards[victim->card].race>=21)continue;q->source[q->count]=hunter->serial;q->victim[q->count]=victim->serial;q->actor[q->count++]=side;++own;}}
static void monster_equipment_battle_end(Duel *d){if(!d->sword_jobs.count)return;for(;;){unsigned moved=0;for(unsigned side=0;side<2&&!moved;++side)for(unsigned index=0;index<5&&!moved;++index){DuelSlot *hunter=&d->players[side].monsters[index];if(!hunter->card||d->cards[hunter->card].name_group!=1327||hunter->position==DUEL_FACEDOWN_DEFENSE)continue;DuelSwordQueue *q=&d->sword_jobs;unsigned job=0;while(job<q->count&&q->source[job]!=hunter->serial)++job;if(job==q->count)continue;unsigned actor=q->actor[job],owner=0;int from=-1,to=empty_zone(d->players[actor].backrow);if(to<0)continue;for(unsigned p=0;p<2&&from<0;++p){from=grave_index(&d->players[p],q->victim[job]);owner=p;}if(from<0)continue;DuelCardState state=take_pile_card(&d->players[owner],PILE_GRAVE,from);state.history&=3;sword_remove(d,job);DuelSlot *source=&d->players[actor].backrow[to];clear(source,sizeof(*source));slot_install_state(d,source,state);source->position=DUEL_FACEUP_ATTACK;source->effect_active=1;source->equip_role=DUEL_EQUIP_ROLE_SWORD;source->link_serial=hunter->serial;source_field_reveal(d,source);equipment_order_attach(d,source,hunter);event(d,DUEL_EVENT_SPELL,actor,to,state.card,0);moved=1;}if(!moved)return;}}

static void monster_equipment_prune(Duel *d){for(unsigned n=0;n<d->sword_jobs.count;){unsigned found=0;for(unsigned p=0;p<2&&!found;++p)for(unsigned i=0;i<5;++i){const DuelSlot *s=&d->players[p].monsters[i];found|=s->card&&s->serial==d->sword_jobs.source[n]&&d->cards[s->card].name_group==1327;}if(found)++n;else sword_remove(d,n);}}

static int absorption_name(unsigned name){return name==730||name==1334;}
static int absorption_attached(const Duel *d,uint32_t serial){if(!serial)return 0;for(unsigned p=0;p<2;++p)for(unsigned i=0;i<5;++i){const DuelSlot *s=&d->players[p].backrow[i];if(s->card&&s->effect_active&&s->equip_role==DUEL_EQUIP_ROLE_ABSORB&&s->link_serial==serial)return 1;}return 0;}
static int thousand_eyes_locked(const Duel *d,unsigned side,unsigned index){const DuelSlot *s=&d->players[side].monsters[index];return (int)live_monster_name(d,1334,3)-(int)(s->card&&d->cards[s->card].name_group==1334)>0;}
/* Consumption and the source check deliberately use the original coordinate.
 * A different face-up monster occupying it during the chain receives the
 * attachment. An invalid source/full backrow sends the target to GY instead. */
static void absorption_resolve(Duel *d,const DuelChainLink *l){unsigned side=l->command.player,index=l->source_slot,victim=l->command.target_player,at=l->command.target;if(index>=5||victim>1||at>=5)return;DuelSlot *host=&d->players[side].monsters[index],*s=&d->players[victim].monsters[at];if(host->card)host->ignition_turn=d->turn;if(!s->card||s->serial!=l->target_serial)return;int to=empty_zone(d->players[side].backrow);if(!host->card||host->position==DUEL_FACEDOWN_DEFENSE||to<0){leave_field(d,victim,at,0,LEAVE_SEND);return;}DuelCardState state=slot_card_state(s);unsigned position=s->position,hidden=s->facedown_attack;clear(s,sizeof(*s));detach_monster(d,state.serial,0);DuelSlot *source=&d->players[side].backrow[to];clear(source,sizeof(*source));slot_install_state(d,source,state);source->position=position;source->facedown_attack=hidden;source->effect_active=1;source->equip_role=DUEL_EQUIP_ROLE_ABSORB;source->link_serial=host->serial;source_field_reveal(d,source);equipment_order_attach(d,source,host);event(d,DUEL_EVENT_SPELL,side,to,state.card,0);}
static int absorption_battle_protect(Duel *d,unsigned side,unsigned index){DuelSlot *host=&d->players[side].monsters[index];if(!host->card||host->position==DUEL_FACEDOWN_DEFENSE||!absorption_name(d->cards[host->card].name_group)||activation_blocked_for_slot(d,host->card,host->serial)||!absorption_attached(d,host->serial))return 0;for(unsigned p=0;p<2;++p)for(unsigned i=0;i<5;++i){const DuelSlot *s=&d->players[p].backrow[i];if(s->card&&s->effect_active&&s->equip_role==DUEL_EQUIP_ROLE_ABSORB&&s->link_serial==host->serial){unsigned duplicate=0;for(unsigned n=0;n<d->battle_equipment_destroy_count;++n)duplicate|=d->battle_equipment_destroy[n].serial==s->serial;if(!duplicate&&d->battle_equipment_destroy_count<10)d->battle_equipment_destroy[d->battle_equipment_destroy_count++]=(DuelTarget){s->serial,p,i};}}return 1;}
static unsigned absorption_reflection(const Duel *d,const DuelWindow *w,unsigned side){if(w->source>=5||w->target>=5||!d->damage_amount[side]||!(d->damage_event_mask&(1u<<side))||d->damage_dealer_side==side||d->battle_protect_turn[side]==d->turn||continuous_battle_protected(d,side))return 0;unsigned index=side==w->player?w->source:w->target;const DuelSlot *s=&d->players[side].monsters[index];return s->card&&d->cards[s->card].name_group==730&&absorption_attached(d,s->serial)?d->damage_amount[side]:0;}
