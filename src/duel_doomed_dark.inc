/* Reborn adds an original kind13 mark. It belongs to the deployment, survives
 * hiding, and leaves when the physical card leaves that deployment. */
static void call_dark_resolve(Duel *d,const DuelChainLink *l){unsigned actor=l->command.player;if(l->effect_negated||l->source_slot>=5||d->players[actor].backrow[l->source_slot].card!=l->card)return;for(unsigned pass=0;pass<2;++pass){unsigned side=d->active^pass;for(unsigned i=0;i<5;++i)if(d->players[side].monsters[i].card&&d->players[side].monsters[i].reborn_origin)leave_field(d,side,i,0,LEAVE_SEND);}}
static void call_dark_cleanup(Duel *d){if(!(d->field_name_cache&256)||!continuous_count(d,38))return;unsigned saved=d->effect_actor_plus1;for(unsigned pass=0;pass<2;++pass){unsigned side=d->active^pass;for(unsigned i=0;i<5;++i)if(d->players[side].monsters[i].card&&d->players[side].monsters[i].reborn_origin){d->effect_actor_plus1=live_backrow_name(d,1026,1u<<(1-side))?2-side:side+1;leave_field(d,side,i,0,LEAVE_SEND);}}d->effect_actor_plus1=saved;}
static int doomed_validate(const Duel *d,unsigned actor){if(grave_redirect_active(d)||d->end_timer_count>=64)return DUEL_NOT_ALLOWED;for(unsigned i=0;i<d->players[actor].hand_count;++i)if(d->cards[d->players[actor].hand[i]].family==DUEL_MONSTER)return DUEL_OK;return DUEL_NOT_ALLOWED;}
static void doomed_end_resolve(Duel *d,const DuelChainLink *l){if(history_target_options(d,l->command.player,1421,0,0))d->choice=(DuelTrigger){DUEL_CHOICE_HISTORY_TARGET,l->command.player,l->card,0};}
