/* Attack roles and physical controllers are independent: AncientLamp can
 * redirect an attack to another Monster controlled by its own attacker. */
#define BATTLE_REDIRECT_SEEN (1u<<30)
#define BATTLE_REDIRECT_FORCED (1u<<29)
int duel_battle_redirect_target(const Duel *d,unsigned name,unsigned actor,const DuelWindow *w,unsigned side,unsigned index){if(!d||!w||actor>1||side>1||index>=5||!duel_can_target_monster(d,side,index))return 0;const DuelSlot *s=&d->players[side].monsters[index];if(name==1529||name==990)return side!=actor&&s->position!=DUEL_FACEDOWN_DEFENSE&&!(side==w->player&&index==w->source);if(name==1243)return side!=actor&&!(side==w->player&&index==w->source);if(name==1522||name==1428)return side==actor&&!(side==duel_battle_target_player(w)&&index==w->target)&&(name!=1428||(d->cards[s->card].name_group==1405&&s->position!=DUEL_FACEDOWN_DEFENSE));return 0;}
static unsigned redirect_targets(const Duel *d,unsigned name,unsigned actor,const DuelWindow *w,DuelChoiceOption *options,unsigned capacity){unsigned n=0;for(unsigned side=0;side<2;++side)for(unsigned i=0;i<5;++i)if(duel_battle_redirect_target(d,name,actor,w,side,i)){if(options&&n<capacity)options[n]=(DuelChoiceOption){d->players[side].monsters[i].card,side*5+i,DUEL_OPTION_CARD};++n;}return n;}
int duel_jam_redirect_ready(const Duel *d,unsigned actor){if(!d||actor>1)return 0;const DuelWindow *w=&d->window;if(w->kind!=DUEL_WINDOW_ATTACK||w->player==actor||w->target>=5||duel_battle_target_player(w)!=actor||!d->players[actor].monsters[w->target].card)return 0;if(d->chain_count&&d->cards[d->chain[d->chain_count-1].card].name_group==1428)return 0;return redirect_targets(d,1428,actor,w,0,0)!=0;}
static unsigned redirect_options(const Duel *d,DuelChoiceOption *options,unsigned capacity){unsigned name=d->cards[d->choice.card].name_group,n=redirect_targets(d,name,d->choice.player,name==1428?&d->window:&d->redirect_battle,options,capacity);if(options&&n<capacity)options[n]=(DuelChoiceOption){0,DUEL_NO_SLOT,DUEL_OPTION_SKIP};return n+1;}
int duel_battle_redirect_begin(Duel *d,const DuelWindow *w){if(w->target>=5||w->events&BATTLE_REDIRECT_SEEN||w->player==duel_battle_target_player(w))return 0;unsigned actor=duel_battle_target_player(w);DuelSlot *s=&d->players[actor].monsters[w->target];unsigned name=d->cards[s->card].name_group;if((name!=1522&&(name!=1243||s->position!=DUEL_FACEDOWN_DEFENSE||s->facedown_attack))||activation_blocked_for_slot(d,s->card,s->serial)||!redirect_targets(d,name,actor,w,0,0))return 0;d->redirect_battle=*w;d->redirect_battle.events|=BATTLE_REDIRECT_SEEN;if(s->position==DUEL_FACEDOWN_DEFENSE){detach_monster(d,s->serial,0);s->position=s->facedown_attack?DUEL_FACEUP_ATTACK:DUEL_FACEUP_DEFENSE;s->facedown_attack=0;}d->choice=(DuelTrigger){DUEL_CHOICE_BATTLE_REDIRECT,actor,s->card,s->serial};return 1;}
void duel_redirect_battle(Duel *d,const DuelChainLink *l){if(l->effect_negated||l->command.target_player>1||l->command.target>=5)return;unsigned actor=l->command.player,name=d->cards[l->card].name_group;DuelSlot *target=&d->players[l->command.target_player].monsters[l->command.target];if(!target->card||target->serial!=l->target_serial)return;if(name==1428){if(l->source_slot>=5||d->players[actor].backrow[l->source_slot].card!=l->card||duel_field_effect_negated(d,l->card)||!duel_battle_redirect_target(d,1428,actor,&d->window,l->command.target_player,l->command.target))return;}DuelWindow *w=name==1428?&d->window:&d->deferred_attack;if(!w->kind)return;w->target=l->command.target;w->target_serial=target->serial;w->target_player_plus1=l->command.target_player+1;w->events|=BATTLE_REDIRECT_FORCED|BATTLE_REDIRECT_SEEN;w->negated=0;}
static int redirect_jam_begin(Duel *d,const DuelCommand *c,unsigned reuse){if(!duel_jam_redirect_ready(d,c->player))return DUEL_NOT_ALLOWED;DuelSlot *s=&d->players[c->player].backrow[c->source];if(reuse&&(d->response_player!=c->player||(d->chain_count&&d->chain[d->chain_count-1].speed>2)))return DUEL_NOT_ALLOWED;if(reuse&&(!s->effect_active||s->position==DUEL_FACEDOWN_DEFENSE||activation_blocked_for_slot(d,s->card,s->serial)))return DUEL_NOT_ALLOWED;if(c->cost!=2){d->redirect_command=*c;d->choice=(DuelTrigger){DUEL_CHOICE_BATTLE_REDIRECT,c->player,s->card,s->serial};return DUEL_OK;}if(!duel_battle_redirect_target(d,1428,c->player,&d->window,c->target_player,c->target))return DUEL_BAD_TARGET;if(!reuse)return DUEL_OK;if(d->response_player!=c->player||d->chain_count>=DUEL_CHAIN_MAX||(d->chain_count&&d->chain[d->chain_count-1].speed>2))return DUEL_NOT_ALLOWED;DuelChainLink *l=&d->chain[d->chain_count++];clear(l,sizeof(*l));l->command=*c;l->card=s->card;l->source_serial=s->serial;l->source_slot=c->source;l->effect_activation=1;l->speed=2;DuelSlot *t=&d->players[c->target_player].monsters[c->target];if(!t->serial)t->serial=++d->next_serial;l->target_serial=t->serial;event(d,DUEL_EVENT_SPELL,c->player,c->source,s->card,0);begin_response(d,1-c->player);return DUEL_OK;}
static int redirect_choose(Duel *d,unsigned token){unsigned actor=d->choice.player,name=d->cards[d->choice.card].name_group,card=d->choice.card;uint32_t source=d->choice.serial;DuelWindow w=d->redirect_battle;DuelCommand c=d->redirect_command;finish_choice(d);if(name==1428){clear(&d->redirect_command,sizeof(d->redirect_command));if(token==DUEL_NO_SLOT)return DUEL_OK;c.target_player=token/5;c.target=token%5;c.cost=2;return activate(d,&c,1);}clear(&d->redirect_battle,sizeof(d->redirect_battle));d->deferred_attack=w;if(token==DUEL_NO_SLOT)return DUEL_OK;if(d->chain_count>=DUEL_CHAIN_MAX)return DUEL_NOT_ALLOWED;DuelSlot *target=&d->players[token/5].monsters[token%5];if(!target->serial)target->serial=++d->next_serial;DuelChainLink *l=&d->chain[d->chain_count++];clear(l,sizeof(*l));l->command.player=actor;l->command.target_player=token/5;l->command.target=token%5;l->card=card;l->source_serial=source;l->target_serial=target->serial;l->source_slot=w.target;l->effect_activation=l->speed=1;begin_response(d,1-actor);return DUEL_OK;}
