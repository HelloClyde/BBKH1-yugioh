unsigned duel_attack_tribute_required(const DuelCardDef *def){return def&&(def->name_group==744||def->name_group==761);}
static unsigned attack_tribute_cost_options(const Duel *d,unsigned actor,unsigned source,DuelChoiceOption *options,unsigned capacity){unsigned n=0;for(unsigned p=0;p<2;++p)for(unsigned i=0;i<5;++i)if((p!=actor||i!=source)&&duel_can_tribute(d,actor,p,i)){if(options&&n<capacity)options[n]=(DuelChoiceOption){d->players[p].monsters[i].card,p*5+i,DUEL_OPTION_CARD};++n;}return n;}
static unsigned attack_tribute_target_options(const Duel *d,DuelChoiceOption *options,unsigned capacity){const DuelAttackTributeTask *t=&d->attack_tribute;unsigned actor=t->command.player,index=t->command.source,n=0;for(unsigned i=0;i<5;++i)if(duel_can_attack_target(d,actor,index,i)){const DuelSlot *s=&d->players[1-actor].monsters[i];if(options&&n<capacity)options[n]=(DuelChoiceOption){s->position==DUEL_FACEDOWN_DEFENSE?0:s->card,i,DUEL_OPTION_CARD};++n;}if(duel_can_attack_direct(d,actor,index)){if(options&&n<capacity)options[n]=(DuelChoiceOption){d->players[actor].monsters[index].card,5,DUEL_OPTION_CONFIRM};++n;}return n;}
static int attack_tribute_begin(Duel *d,const DuelCommand *c){if(c->cost||d->attack_tribute.stage)return DUEL_BAD_ARGUMENT;if(!attack_tribute_cost_options(d,c->player,c->source,0,0))return DUEL_NOT_ALLOWED;DuelSlot *s=&d->players[c->player].monsters[c->source];if(!s->serial)s->serial=++d->next_serial;d->attack_tribute=(DuelAttackTributeTask){*c,s->serial,1};d->choice=(DuelTrigger){DUEL_CHOICE_ATTACK_TRIBUTE_COST,c->player,s->card,s->serial};return DUEL_OK;}
static void attack_tribute_cost_choose(Duel *d,unsigned token){if(token==DUEL_NO_SLOT){clear(&d->attack_tribute,sizeof(d->attack_tribute));finish_choice(d);return;}d->attack_tribute.stage=2;finish_choice(d);leave_field(d,token/5,token%5,0,LEAVE_TRIBUTE);}
static void attack_tribute_resume(Duel *d){DuelAttackTributeTask *t=&d->attack_tribute;if(t->stage!=2||d->choice.kind||d->chain_count||d->trigger_count||d->response_player<2)return;check_special_victory(d);if(d->winner>=0){clear(t,sizeof(*t));return;}unsigned side=t->command.player,index=t->command.source;DuelSlot *s=&d->players[side].monsters[index];if(d->phase!=DUEL_BATTLE||d->active!=side||!s->card||s->serial!=t->serial||!combat_attack_position(d,s)||!continuous_attack_allowed(d,side,index)||s->attacked>=duel_attack_limit(d,side,index)){clear(t,sizeof(*t));return;}t->stage=3;d->choice=(DuelTrigger){DUEL_CHOICE_ATTACK_TRIBUTE_TARGET,side,s->card,s->serial};}
static void queen_capture_battle(Duel *d){unsigned side=d->damage_dealer_side,index=d->damage_dealer_slot;if(side>1||index>=5)return;DuelSlot *s=&d->players[side].monsters[index];if(!s->card||d->cards[s->card].name_group!=761||duel_card_prohibited(d,s->card,s->serial)||battle_destroyed(d,side,index))return;for(unsigned i=0;i<d->battle_destroy_count;++i)if(d->battle_destroy[i].serial!=s->serial){s->control_used=1;return;}}
static void queen_end_queue(Duel *d){for(unsigned order=0;order<2;++order){unsigned side=d->active^order;for(unsigned i=0;i<5;++i){DuelSlot *s=&d->players[side].monsters[i];if(s->card&&d->cards[s->card].name_group==761&&s->control_used)queue_trigger(d,DUEL_TRIGGER_QUEEN_END,side,s->card,s->serial);}}}
static void queen_end_resolve(Duel *d,const DuelTrigger *t){for(unsigned side=0;side<2;++side)for(unsigned i=0;i<5;++i){DuelSlot *s=&d->players[side].monsters[i];if(s->card&&s->serial==t->serial&&d->cards[s->card].name_group==761&&s->control_used&&s->position!=DUEL_FACEDOWN_DEFENSE&&!duel_card_prohibited(d,s->card,s->serial)){if(summon_token(d,side,1920,DUEL_FACEUP_ATTACK))s->control_used=0;return;}}}
