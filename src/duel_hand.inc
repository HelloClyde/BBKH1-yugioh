#include "duel_hand_data.h"
static const HandRule *hand_rule(const Duel *d,unsigned card){if(d->cards[card].effect!=DUEL_E_HAND)return 0;for(unsigned i=0;i<DUEL_HAND_RULE_COUNT;++i)if(hand_rules[i].name==d->cards[card].name_group)return &hand_rules[i];return 0;}
static unsigned send_hand_effect(Duel *d,unsigned side,unsigned index,unsigned actor,unsigned by_effect){DuelPlayer *p=&d->players[side];DuelCardState state=take_pile_card(p,PILE_HAND,index);unsigned before=d->players[state.owner].grave_count,card=state.card;state.history=by_effect&&actor!=side?DUEL_HISTORY_OPPONENT:0;grave_card_state(d,side,state);const HandRule *r=hand_rule(d,card);if(d->players[state.owner].grave_count>before&&by_effect&&actor!=side&&r&&(r->op==6||r->op==7))queue_trigger(d,DUEL_TRIGGER_DISCARD,state.owner,card,0);return card;}
static unsigned discard_hand_unpaid(Duel *d,unsigned side,unsigned index,unsigned actor,unsigned by_effect){DuelCardState state=pile_card_state(&d->players[side],PILE_HAND,index);unsigned card=send_hand_effect(d,side,index,actor,by_effect);passive_discard_collect(d,side,state.owner);reactive_discard_collect(d,side);return card;}
static unsigned discard_hand_effect(Duel *d,unsigned side,unsigned index,unsigned actor,unsigned by_effect){DuelCardState state=pile_card_state(&d->players[side],PILE_HAND,index);unsigned card=discard_hand_unpaid(d,side,index,actor,by_effect);if(actor==side&&!by_effect)borrow_penalty(d,side,state.serial);return card;}
unsigned duel_discard_hand(Duel *d,unsigned side,unsigned index,unsigned actor,unsigned by_effect,unsigned paid){if(!d||side>1||actor>1||index>=d->players[side].hand_count)return 0;return paid?discard_hand_effect(d,side,index,actor,by_effect):discard_hand_unpaid(d,side,index,actor,by_effect);}
static int hand_validate(const Duel *d,const DuelCommand *c,unsigned card,unsigned from_set){const HandRule *r=hand_rule(d,card);if(!r||r->op>5)return DUEL_NOT_ALLOWED;const DuelPlayer *p=&d->players[c->player];if(p->life<=(int)(r->cost+(from_set?0:hand_play_cost(d))))return DUEL_NOT_ALLOWED;if(r->op<=3&&!d->players[1-c->player].hand_count)return DUEL_NOT_ALLOWED;unsigned available=p->hand_count-(from_set?0:1);if((r->op==4&&!available)||(r->op==5&&available<5))return DUEL_NOT_ALLOWED;return DUEL_OK;}
static void hand_begin_choice(Duel *d,unsigned chooser,unsigned owner,unsigned actor,unsigned card,unsigned op,unsigned count,unsigned optional,unsigned cost){if(!count||!d->players[owner].hand_count)return;d->hand_task=(DuelHandTask){owner,actor,count,optional,op,cost};d->choice=(DuelTrigger){DUEL_CHOICE_HAND,chooser,card,0};}
static int hand_begin_cost(Duel *d,unsigned side,unsigned card){const HandRule *r=hand_rule(d,card);unsigned count=d->cards[card].name_group==1421?1:d->cards[card].name_group==1072?2:r&&r->op==5?5:0;if(!count)return 0;hand_begin_choice(d,side,side,side,card,1,count,0,1);if(d->cards[card].name_group==1421)d->hand_task.filter=DUEL_MONSTER+1;return 1;}
static void hand_resolve(Duel *d,const DuelChainLink *link){const HandRule *r=hand_rule(d,link->card);if(!r)return;unsigned side=link->command.player,enemy=link_player(link,1-side);
    if(r->op==1){DuelPlayer *p=&d->players[enemy];if(p->hand_count)discard_hand_effect(d,enemy,random_next(d)%p->hand_count,side,1);if(p->hand_count)hand_begin_choice(d,enemy,enemy,side,link->card,1,1,0,0);}
    else if(r->op==2||r->op==3)hand_begin_choice(d,side,enemy,side,link->card,r->op==2?1:2,1,0,0);
    else if(r->op==4){unsigned owner=link_player(link,side);hand_begin_choice(d,owner,owner,side,link->card,1,3,1,0);}
    else if(r->op==5)destroy_all_field(d);
    else if(r->op==6)damage(d,enemy,r->cost);
    else if(r->op==7)draw_cards(d,side,r->cost);
}
static unsigned hand_options(const Duel *d,DuelChoiceOption *options,unsigned capacity){const DuelHandTask *task=&d->hand_task;const DuelPlayer *p=&d->players[task->owner];unsigned n=0;for(unsigned i=0;i<p->hand_count;++i){if(task->filter&&d->cards[p->hand[i]].family+1!=task->filter)continue;if(options&&n<capacity)options[n]=(DuelChoiceOption){p->hand[i],i,DUEL_OPTION_CARD};++n;}if(n&&task->optional&&d->choice.selected_count){if(options&&n<capacity)options[n]=(DuelChoiceOption){0,DUEL_NO_SLOT,DUEL_OPTION_SKIP};++n;}return n;}
static void hand_finish(Duel *d){unsigned next=d->hand_task.next_owner_plus1,actor=d->hand_task.actor,card=d->choice.card;unsigned cost=d->hand_task.cost,side=d->choice.player;clear(&d->hand_task,sizeof(d->hand_task));finish_choice(d);if(cost)begin_response(d,1-side);else if(next)hand_begin_choice(d,next-1,next-1,actor,card,1,1,0,0);}
static void hand_choose(Duel *d,unsigned index){DuelHandTask *task=&d->hand_task;DuelPlayer *p=&d->players[task->owner];if(index==DUEL_NO_SLOT){hand_finish(d);return;}
    if(task->op==1){DuelCardState state=pile_card_state(p,PILE_HAND,index);discard_hand_effect(d,task->owner,index,task->actor,!task->cost);if(!task->cost&&task->owner==task->actor)borrow_penalty(d,task->owner,state.serial);}
    else {DuelCardState state=card_state_reset(take_pile_card(p,PILE_HAND,index));unsigned card=state.card;if(!put_pile_card(d,task->owner,PILE_DECK,state,0))grave_card_state(d,task->owner,state);shuffle(d,p);event(d,DUEL_EVENT_RETURN,task->owner,0,card,0);}
    ++d->choice.selected_count;if(task->remaining)--task->remaining;if(!task->remaining||!p->hand_count)hand_finish(d);
}
static int hand_ai_wants(const Duel *d,unsigned side,unsigned card,unsigned from_set){DuelCommand c={side,from_set?DUEL_ACTION_ACTIVATE_BACKROW:DUEL_ACTION_ACTIVATE_HAND,0};if(hand_validate(d,&c,card,from_set)!=DUEL_OK)return 0;const HandRule *r=hand_rule(d,card);if(r->op<=3)return 1;if(r->op==4){for(unsigned i=0;i<d->players[side].hand_count;++i)if(d->cards[d->players[side].hand[i]].effect==DUEL_E_HAND&&d->cards[d->players[side].hand[i]].family==DUEL_MONSTER)return 1;return 0;}return monsters(&d->players[1-side])>monsters(&d->players[side]);}
