/* Target selection precedes responses. Resolution follows the recorded pile
 * instances, so removal/replacement during a chain cannot retarget a spell. */
static unsigned pile_target_limit(unsigned op){return op==42?3:op==38?5:(op==39||op==41)?2:3;}
static int pile_target_selected(const DuelChainLink *link,unsigned owner,unsigned index){for(unsigned i=0;i<link->target_count;++i)if(link->targets[i].player==owner&&link->targets[i].slot==index)return 1;return 0;}
static unsigned pile_target_candidates(const Duel *d,unsigned side,unsigned op,unsigned owner,const DuelChainLink *link,DuelChoiceOption *options,unsigned capacity){if(duel_spirit_active(d,side)&&spirit_pool(op)){if(!grave_banish_allowed(d,side))return 0;return spirit_field_options(d,side,op==42||op==43?0:link,options,capacity);}const DuelPlayer *p=&d->players[owner];if(op!=40&&!grave_banish_allowed(d,side)||(op==39||op==41)&&owner==side||(op==40||op==42||op==43)&&owner!=side||op!=40&&p->banished_count>=DUEL_PILE_MAX)return 0;unsigned count=0,total=op==40?p->banished_count:p->grave_count;for(unsigned i=0;i<total;++i){unsigned card=op==40?p->banished[i]:p->grave[i];if(!card||(op==40&&p->banished_flags[i]==0x80)||op!=38&&(d->cards[card].family!=DUEL_MONSTER||d->cards[card].race>=21)||op!=42&&op!=43&&link&&pile_target_selected(link,owner,i))continue;if(options&&count<capacity)options[count]=(DuelChoiceOption){card,i,DUEL_OPTION_CARD};++count;}return count;}
static int pile_target_validate(const Duel *d,unsigned side,unsigned op){if(duel_spirit_active(d,side)&&spirit_pool(op))return pile_target_candidates(d,side,op,side,0,0,0)?DUEL_OK:DUEL_NOT_ALLOWED;unsigned count=pile_target_candidates(d,side,op,side,0,0,0)+pile_target_candidates(d,side,op,1-side,0,0,0);return op==40?(count>=5&&!grave_redirect_active(d)&&d->players[side].grave_count+3<=DUEL_PILE_MAX?DUEL_OK:DUEL_NOT_ALLOWED):count?DUEL_OK:DUEL_NOT_ALLOWED;}
static unsigned pile_target_options(const Duel *d,DuelChoiceOption *options,unsigned capacity){const DuelPileTask *task=&d->pile_task;const DuelChainLink *link=&d->chain[task->root];unsigned side=link->command.player,count=0;if(d->choice.kind==DUEL_CHOICE_PILE_PLAYER){for(unsigned i=0;i<2;++i)if(pile_target_candidates(d,side,task->op,side^i,link,0,0)){if(options&&count<capacity)options[count]=(DuelChoiceOption){0,i,DUEL_OPTION_CONFIRM};++count;}if(link->target_count){if(options&&count<capacity)options[count]=(DuelChoiceOption){0,DUEL_NO_SLOT,DUEL_OPTION_SKIP};++count;}return count;}count=pile_target_candidates(d,side,task->op,task->owner,link,options,capacity);if((task->op==38&&(!link->command.position||link->target_count))||(task->op==39&&link->target_count||task->op==41||(task->op==42||task->op==43)&&link->command.cost)){if(options&&count<capacity)options[count]=(DuelChoiceOption){0,DUEL_NO_SLOT,DUEL_OPTION_SKIP};++count;}return count;}
static void pile_target_begin(Duel *d,unsigned root,unsigned op){unsigned side=d->chain[root].command.player;unsigned field=duel_spirit_active(d,side)&&spirit_pool(op);d->chain[root].command.position=field;d->pile_task=(DuelPileTask){op,!field&&(op==39||op==41)?1-side:side,root};d->choice=(DuelTrigger){op==38&&!field?DUEL_CHOICE_PILE_PLAYER:DUEL_CHOICE_PILE_CARD,side,d->chain[root].card,d->chain[root].source_serial};}
static void pile_target_finish(Duel *d){unsigned side=d->chain[d->pile_task.root].command.player;unsigned kycoo=d->pile_task.op==41,targets=d->chain[d->pile_task.root].target_count;clear(&d->pile_task,sizeof(d->pile_task));finish_choice(d);if(kycoo){if(!targets)--d->chain_count;d->trigger_chain_pending=d->chain_count!=0;}else begin_response(d,1-side);}
static void pile_target_choose(Duel *d,unsigned index){DuelPileTask *task=&d->pile_task;DuelChainLink *link=&d->chain[task->root];unsigned side=link->command.player;if(d->choice.kind==DUEL_CHOICE_PILE_PLAYER){if(index==DUEL_NO_SLOT){pile_target_finish(d);return;}task->owner=side^index;d->choice.kind=DUEL_CHOICE_PILE_CARD;return;}if(index==DUEL_NO_SLOT){if(task->op==38&&!link->command.position)d->choice.kind=DUEL_CHOICE_PILE_PLAYER;else pile_target_finish(d);return;}DuelPlayer *p=&d->players[task->owner];if(task->op==42||task->op==43){if(!(link->command.position?duel_banish_field(d,side,index,0):banish_grave(d,task->owner,index,side)))return;++link->command.cost;link->target_card=link->command.cost*(task->op==42?300:1);if(task->op==42&&link->command.cost==3||!pile_target_candidates(d,side,task->op,side,0,0,0))pile_target_finish(d);return;}if(link->command.position&&spirit_pool(task->op)){DuelSlot *m=&d->players[side].monsters[index];if(!m->serial)m->serial=++d->next_serial;link->targets[link->target_count++]=(DuelTarget){m->serial,side,index};unsigned left=pile_target_candidates(d,side,task->op,side,link,0,0);if(link->target_count==pile_target_limit(task->op)||!left)pile_target_finish(d);return;}uint32_t *serial=task->op==40?&p->banished_serial[index]:&p->grave_serial[index];if(!*serial)*serial=++d->next_serial;link->targets[link->target_count++]=(DuelTarget){*serial,task->owner,index};unsigned left=pile_target_candidates(d,side,task->op,side,link,0,0)+pile_target_candidates(d,side,task->op,1-side,link,0,0);if(link->target_count==pile_target_limit(task->op)||!left)pile_target_finish(d);else if(task->op==38)d->choice.kind=DUEL_CHOICE_PILE_PLAYER;}
static void pile_target_resolve(Duel *d,const DuelChainLink *link,unsigned op){for(unsigned i=0;i<link->target_count;++i){const DuelTarget *target=&link->targets[i];DuelPlayer *p=&d->players[target->player];if(link->command.position&&spirit_pool(op)){if(grave_banish_allowed(d,link->command.player)&&duel_target_present(d,target->player,target->slot,target->serial)&&effect_affects_monster(d,link->card,target->player,target->slot))duel_banish_field(d,target->player,target->slot,0);continue;}if(op==40){int index=banished_index(p,target->serial);if(index<0||p->grave_count>=DUEL_PILE_MAX)continue;DuelCardState returned=take_pile_card(p,PILE_BANISHED,index);unsigned card=returned.card;returned.history&=3;grave_card_state(d,target->player,returned);event(d,DUEL_EVENT_RETURN,target->player,0,card,0);}else {int index=grave_index(p,target->serial);if(index>=0)banish_grave(d,target->player,index,link->command.player);}}}
