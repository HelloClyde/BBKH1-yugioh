/* Normal/Flip and special arrival callbacks have different producer lists.
 * Status2 uses a live source deployment, retained when either card is hidden. */
static void arrival_choice_trigger(Duel *d,unsigned side,unsigned index,unsigned special){DuelSlot *s=&d->players[side].monsters[index];if(!s->card||s->position==DUEL_FACEDOWN_DEFENSE||d->cards[s->card].effect!=DUEL_E_TARGET_FLIP||duel_card_prohibited(d,s->card,s->serial))return;const TargetFlipRule *r=target_flip_rule(d,s->card);if(r->op<13||r->op>15||special&&r->op!=14)return;if(!s->serial)s->serial=++d->next_serial;queue_trigger(d,DUEL_CHOICE_TARGET_FLIP,side,s->card,s->serial);}
static int sleep_attack_locked(const Duel *d,unsigned side,unsigned index){if(!(d->stat_snapshot_present&8))return 0;const DuelSlot *s=&d->players[side].monsters[index];for(unsigned i=0;i<d->stat_link_count;++i){const DuelStatLink *l=&d->stat_links[i];if(l->kind!=9||l->target!=s->serial)continue;const DuelSlot *source=stat_link_source(d,l);if(source&&!source->monster_negated&&(d->cards[source->card].name_group==729||d->cards[source->card].name_group==1332)&&!duel_field_effect_negated(d,source->card)&&!duel_card_prohibited(d,source->card,source->serial))return 1;}return 0;}
static void arrival_target_resolve(Duel *d,const DuelChainLink *link,const DuelTarget *t,unsigned op){if(t->player>1||t->slot>=5)return;DuelSlot *victim=&d->players[t->player].monsters[t->slot];if(!victim->card||victim->serial!=t->serial)return;
    if(op==13){if(!link->effect_negated&&victim->position!=DUEL_FACEDOWN_DEFENSE&&duel_race(d,t->player,t->slot)==1)destroy(d,t->player,t->slot,0);return;}
    if(link->source_slot>=5)return;DuelSlot *source=&d->players[link->command.player].monsters[link->source_slot];if(!source->card)return;if(!source->serial)source->serial=++d->next_serial;
    if(op==14){if(victim->position==DUEL_FACEDOWN_DEFENSE)return;unsigned before=d->stat_link_count;duel_stat_snapshot(d,link->command.player,link->source_slot,0x6000|victim->card,0);if(d->stat_link_count>before)d->stat_links[d->stat_link_count-1].expires=0;return;}
    if(link->effect_negated)return;stat_links_cleanup(d);if(d->stat_link_count>=DUEL_STAT_LINK_MAX)return;d->stat_links[d->stat_link_count++]=(DuelStatLink){source->serial,victim->serial,9};d->stat_snapshot_present|=8;
}
