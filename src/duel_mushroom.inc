/* The original End callback deliberately addresses its recorded physical
 * zone. It does not revalidate the source identity, position or flag4. */
static int mushroom_source(const Duel *d,unsigned side,unsigned card,uint32_t serial){for(unsigned i=0;i<5;++i){const DuelSlot *s=&d->players[side].monsters[i];if(s->card==card&&s->serial==serial&&s->position!=DUEL_FACEDOWN_DEFENSE)return i;}return -1;}
static unsigned mushroom_options(const Duel *d,DuelChoiceOption *options,unsigned capacity){unsigned side=d->choice.player;if(mushroom_source(d,side,d->choice.card,d->choice.serial)<0||d->players[side].life<=500||empty_zone(d->players[1-side].monsters)<0)return 0;if(options&&capacity)options[0]=(DuelChoiceOption){d->choice.card,0,DUEL_OPTION_CONFIRM};if(options&&capacity>1)options[1]=(DuelChoiceOption){0,DUEL_NO_SLOT,DUEL_OPTION_SKIP};return 2;}
static void mushroom_end_queue(Duel *d,unsigned side){if(d->players[side].life<=500||empty_zone(d->players[1-side].monsters)<0)return;for(unsigned i=0;i<5;++i){DuelSlot *s=&d->players[side].monsters[i];if(s->card&&d->cards[s->card].name_group==552&&s->position!=DUEL_FACEDOWN_DEFENSE&&!battle_destroyed(d,side,i)){if(!s->serial)s->serial=++d->next_serial;queue_trigger(d,DUEL_CHOICE_MUSHROOM,side,s->card,s->serial);}}}
static void mushroom_choose(Duel *d,unsigned index){unsigned side=d->choice.player;int source=mushroom_source(d,side,d->choice.card,d->choice.serial);if(index!=DUEL_NO_SLOT&&source>=0){d->players[side].life-=500;event(d,DUEL_EVENT_SPELL,side,source,d->choice.card,-500);DuelChainLink *link=&d->chain[d->chain_count++];clear(link,sizeof(*link));link->command.player=side;link->card=d->choice.card;link->source_serial=d->choice.serial;link->source_slot=source;link->speed=1;link->effect_activation=1;d->trigger_chain_pending=1;}finish_choice(d);}
static void mushroom_resolve(Duel *d,const DuelChainLink *link){unsigned side=link->command.player,index=link->source_slot;if(index>=5)return;DuelSlot *s=&d->players[side].monsters[index];if(!s->card)return;if(!s->serial)s->serial=++d->next_serial;control_replace_name(d,s->serial,552);control_add(d,side,index,1-side,link->card,0,0);}
