/* Controller status entries are ordered by application, keyed by instance,
 * and reevaluated when a source, suppression or end timer changes. */
static int control_find(const Duel *d,uint32_t serial,unsigned *owner,unsigned *index){for(unsigned p=0;p<2;++p)for(unsigned i=0;i<5;++i)if(d->players[p].monsters[i].card&&d->players[p].monsters[i].serial==serial){if(owner)*owner=p;if(index)*index=i;return 1;}return 0;}
static const DuelSlot *control_link_source(const Duel *d,uint32_t serial,unsigned *owner){for(unsigned p=0;p<2;++p)for(unsigned i=0;i<5;++i){const DuelSlot *s=&d->players[p].backrow[i];if(s->card&&s->serial==serial){if(owner)*owner=p;return s;}}return 0;}
/* The original uses presence here, even under disabled flag0x20. A pending
 * activation (original flag2) is represented by effect_active==0. */
static int control_royal_present(const Duel *d){for(unsigned p=0;p<2;++p)for(unsigned i=0;i<5;++i){const DuelSlot *s=&d->players[p].backrow[i];if(s->card&&s->effect_active&&s->position!=DUEL_FACEDOWN_DEFENSE&&d->cards[s->card].name_group==1530)return 1;}return 0;}
unsigned duel_control_desired(const Duel *d,uint32_t serial,unsigned base,unsigned spell_immune){unsigned actor=base,royal=control_royal_present(d);for(unsigned i=0;i<d->control_layer_count;++i){const DuelControlLayer *l=&d->control_layers[i];if(l->target!=serial)continue;const DuelCardDef *c=&d->cards[l->card];if(spell_immune&&(c->family==DUEL_SPELL||l->source&&equip_rule(d,l->card)))continue;if((duel_original_classification[l->card]&2)&&royal)continue;if(l->source){unsigned owner;const DuelSlot *s=control_link_source(d,l->source,&owner);if(!s||!s->effect_active||s->position==DUEL_FACEDOWN_DEFENSE||equip_effect_negated(d,s->card)||s->link_serial!=serial)continue;actor=c->name_group==1258?s->control_used:owner;}else actor=l->actor;}return actor;}
static DuelControlState *control_state(Duel *d,uint32_t target){if(!target)return 0;for(unsigned i=0;i<10;++i)if(d->control_states[i].target==target)return &d->control_states[i];return 0;}
static int control_add(Duel *d,unsigned side,unsigned index,unsigned actor,unsigned card,uint32_t source,unsigned until){DuelSlot *s=&d->players[side].monsters[index];if(!s->card||d->control_layer_count>=DUEL_CONTROL_LAYER_MAX)return 0;if(!s->serial)s->serial=++d->next_serial;DuelControlState *state=control_state(d,s->serial);if(!state){for(unsigned i=0;i<10;++i)if(!d->control_states[i].target){state=&d->control_states[i];break;}if(!state)return 0;*state=(DuelControlState){s->serial,side};}d->control_layers[d->control_layer_count++]=(DuelControlLayer){s->serial,source,card,until,actor};s->return_controller=state->base;return 1;}
static void control_remove_layer(Duel *d,unsigned index){for(unsigned i=index;i+1<d->control_layer_count;++i)d->control_layers[i]=d->control_layers[i+1];clear(&d->control_layers[--d->control_layer_count],sizeof(DuelControlLayer));}
static void control_reconcile(Duel *d){if(!d->control_layer_count){unsigned any=0;for(unsigned i=0;i<10;++i)any|=d->control_states[i].target!=0;if(!any)return;}
    /* Original reconciliation visits the active side first and restarts after
       each movement request. Ten target states bound a stable field pass. */
    for(unsigned step=0;step<=10&&d->winner<0;++step){
        for(unsigned i=0;i<d->control_layer_count;){const DuelControlLayer *l=&d->control_layers[i];const DuelSlot *source=l->source?control_link_source(d,l->source,0):0;if(!control_find(d,l->target,0,0)||(l->source&&(!source||source->link_serial!=l->target))||(l->until&&l->until<d->turn))control_remove_layer(d,i);else ++i;}
        unsigned changed=0;for(unsigned order=0;order<2&&!changed&&d->winner<0;++order){unsigned p=d->active^order;for(unsigned i=0;i<5&&d->winner<0;++i){DuelSlot *s=&d->players[p].monsters[i];if(!s->card)continue;DuelControlState *state=control_state(d,s->serial);if(!state)continue;unsigned immune=duel_spell_immune(d,p,i),actor=duel_control_desired(d,s->serial,state->base,immune),count=0;for(unsigned n=0;n<d->control_layer_count;++n)count+=d->control_layers[n].target==s->serial;
            if(actor!=p){int to=empty_zone(d->players[actor].monsters);if(to<0){unsigned saved=d->effect_actor_plus1;d->effect_actor_plus1=actor+1;destroy(d,p,i,0);d->effect_actor_plus1=saved;}else {change_controller(d,p,i,actor,to,DUEL_NO_SLOT);d->players[actor].monsters[to].return_controller=count?state->base:DUEL_NO_SLOT;}changed=1;}
            else s->return_controller=count?state->base:DUEL_NO_SLOT;if(!count)clear(state,sizeof(*state));if(changed)break;}}
        if(!changed)break;
    }
    for(unsigned i=0;i<10;++i)if(d->control_states[i].target&&!control_find(d,d->control_states[i].target,0,0))clear(&d->control_states[i],sizeof(DuelControlState));
}
static void control_end_turn(Duel *d){for(unsigned i=0;i<d->control_layer_count;)if(d->control_layers[i].until&&d->control_layers[i].until<=d->turn)control_remove_layer(d,i);else ++i;control_reconcile(d);
    /* Preserve manually imported legacy states with no typed layer records. */
    for(unsigned p=0;p<2;++p)for(unsigned i=0;i<5;++i){DuelSlot *s=&d->players[p].monsters[i];if(!s->card||s->return_controller>=2||control_state(d,s->serial))continue;unsigned actor=s->return_controller;int to=empty_zone(d->players[actor].monsters);if(to<0){unsigned saved=d->effect_actor_plus1;d->effect_actor_plus1=actor+1;destroy(d,p,i,0);d->effect_actor_plus1=saved;}else change_controller(d,p,i,actor,to,DUEL_NO_SLOT);}
}

static void control_replace_name(Duel *d,uint32_t target,unsigned name){for(unsigned i=0;i<d->control_layer_count;)if(d->control_layers[i].target==target&&d->cards[d->control_layers[i].card].name_group==name)control_remove_layer(d,i);else ++i;}
static void control_exchange(Duel *d,const DuelChainLink *link,const DuelTarget *t){unsigned actor=link->command.player,index=link->source_slot;if(index>=5||t->player==actor||t->player>1||t->slot>=5)return;DuelSlot *one=&d->players[actor].monsters[index],*two=&d->players[t->player].monsters[t->slot];if(!one->card||one->card!=link->card||one->serial!=link->source_serial||one->position==DUEL_FACEDOWN_DEFENSE||!two->card||two->serial!=t->serial)return;
    unsigned removed=0;for(unsigned i=0;i<d->control_layer_count;++i){const DuelControlLayer *l=&d->control_layers[i];removed+=(l->target==one->serial||l->target==two->serial)&&d->cards[l->card].name_group==640;}if(d->control_layer_count-removed+2>DUEL_CONTROL_LAYER_MAX)return;control_replace_name(d,one->serial,640);control_replace_name(d,two->serial,640);if(!control_add(d,actor,index,t->player,link->card,0,0)||!control_add(d,t->player,t->slot,actor,link->card,0,0))return;
    DuelSlot saved=*one;*one=*two;*two=saved;control_change_effects(d,t->player,actor,one);control_change_effects(d,actor,t->player,two);
}
