/* Paid delayed revivals identify a physical card. The job is consumed before
 * checking the destination, so a blocked Standby attempt does not retry. */
static unsigned revival_job_space(const Duel *d){for(unsigned i=0;i<64;++i)if(!d->revival_jobs[i].used)return i;return 64;}
static unsigned revival_jam_options(const Duel *d,DuelChoiceOption *options,unsigned capacity){if(d->players[d->choice.player].life<=1000||revival_job_space(d)>=64)return 0;if(options&&capacity)options[0]=(DuelChoiceOption){d->choice.card,0,DUEL_OPTION_CONFIRM};if(options&&capacity>1)options[1]=(DuelChoiceOption){0,DUEL_NO_SLOT,DUEL_OPTION_SKIP};return 2;}
static void revival_jam_choose(Duel *d,unsigned index){if(index!=DUEL_NO_SLOT){unsigned side=d->choice.player,at=revival_job_space(d);if(at<64&&d->players[side].life>1000){d->players[side].life-=1000;event(d,DUEL_EVENT_SPELL,side,0,d->choice.card,-1000);d->revival_jobs[at]=(DuelRevivalJob){d->choice.serial,d->event_sequence,d->choice.card,d->turn+(d->active==side?2:1),side,1,0};}}finish_choice(d);}
static void revival_job_queue(Duel *d,unsigned side){for(;;){unsigned best=64;for(unsigned i=0;i<64;++i){DuelRevivalJob *j=&d->revival_jobs[i];if(j->used&&!j->kind&&!j->queued&&j->actor==side&&j->due_turn<=d->turn&&(best==64||j->order<d->revival_jobs[best].order))best=i;}if(best==64||d->trigger_count>=DUEL_TRIGGER_MAX)return;DuelRevivalJob *j=&d->revival_jobs[best];j->queued=1;queue_trigger(d,DUEL_TRIGGER_REVIVAL_JOB,side,j->card,best+1);}}
static void revival_job_resolve(Duel *d,const DuelTrigger *trigger){unsigned at=trigger->serial-1;if(at>=64||!d->revival_jobs[at].used)return;DuelRevivalJob job=d->revival_jobs[at];clear(&d->revival_jobs[at],sizeof(job));unsigned side=job.actor;DuelPlayer *p=&d->players[side];if(!special_summon_allowed_for(d,side))return;int from=grave_index(p,job.serial),to=empty_zone(p->monsters);if(from<0||to<0)return;DuelCardState state=take_pile_card(p,PILE_GRAVE,from);state.history&=3;DuelSlot *s=&p->monsters[to];clear(s,sizeof(*s));slot_install_state(d,s,state);s->position=DUEL_FACEUP_DEFENSE;s->set_turn=s->summoned_turn=d->turn;s->return_controller=DUEL_NO_SLOT;special_summon_success(d,side,to);revival_triggers(d,side);d->summon_notice=(DuelWindow){DUEL_WINDOW_SUMMON,side,to,0,s->serial,0,s->card,0,2};event(d,DUEL_EVENT_REVIVE,side,to,s->card,0);}
