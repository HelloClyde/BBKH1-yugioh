/* Battle victims retain original ownership and previous control/position.
 * RedMoon's virtual job survives the simultaneous death of its source. */
int duel_battle_revival_ready(const Duel *d,const DuelBattleRevival *j){if(!d||!j||!j->used||j->actor>1||j->victim.owner>1||!special_summon_allowed_for(d,j->actor)||empty_zone(d->players[j->actor].monsters)<0)return 0;int from=grave_index(&d->players[j->victim.owner],j->victim.serial);return from>=0&&duel_can_revive_for(d,j->actor,j->victim.owner,from);}
int duel_time_machine_available(const Duel *d,unsigned actor){if(!d||actor>1||d->window.kind!=DUEL_WINDOW_BATTLE_DEATH||d->battle_death_count!=1||!special_summon_allowed_for(d,actor))return 0;const DuelBattleRevival *j=&d->battle_last_death;if(j->controller>1||j->victim.owner>1||empty_zone(d->players[j->controller].monsters)<0)return 0;int from=grave_index(&d->players[j->victim.owner],j->victim.serial);return from>=0&&duel_can_revive_for(d,actor,j->victim.owner,from);}
void duel_battle_revival_capture(Duel *d){d->battle_death_count=d->battle_revival_notice=d->battle_revival_relevant=0;for(unsigned role=0;role<2;++role){const DuelTarget *t=&d->dimensional_battle[role];if(t->player<2&&t->slot<5){const DuelSlot *s=&d->players[t->player].monsters[t->slot];if(s->card&&s->serial==t->serial&&d->cards[s->card].name_group==1340)d->battle_revival_relevant=1;}}for(unsigned side=0;side<2&&!d->battle_revival_relevant;++side)for(unsigned i=0;i<5;++i){const DuelSlot *s=&d->players[side].backrow[i];if(s->card&&d->cards[s->card].name_group==950&&s->position==DUEL_FACEDOWN_DEFENSE&&s->set_turn<d->turn)d->battle_revival_relevant=1;}if(!d->battle_revival_relevant)return;clear(d->battle_revive_jobs,sizeof(d->battle_revive_jobs));clear(&d->battle_last_death,sizeof(d->battle_last_death));d->battle_death_count=d->battle_revival_notice=0;for(unsigned i=0;i<d->battle_destroy_count;++i){const DuelTarget *t=&d->battle_destroy[i];const DuelSlot *victim=&d->players[t->player].monsters[t->slot];if(!victim->card||victim->serial!=t->serial)continue;d->battle_death_position[i]=victim->position;for(unsigned role=0;role<2;++role){const DuelTarget *source=&d->dimensional_battle[role],*fallen=&d->dimensional_battle[1-role];unsigned other=source->player;if(other>1||source->slot>=5||fallen->serial!=t->serial||fallen->player!=t->player||fallen->slot!=t->slot)continue;const DuelSlot *s=&d->players[other].monsters[source->slot];if(s->card&&s->serial==source->serial&&d->cards[s->card].name_group==1340&&!activation_blocked_for_slot(d,s->card,s->serial))d->battle_revive_jobs[role]=(DuelBattleRevival){slot_card_state(victim),s->card,other,other,0,1,t->slot};}}}
static void battle_revival_commit(Duel *d){if(!d->battle_revival_relevant)return;for(unsigned i=0;i<d->battle_destroy_count;++i){const DuelTarget *t=&d->battle_destroy[i];for(unsigned owner=0;owner<2;++owner){int index=grave_index(&d->players[owner],t->serial);if(index<0)continue;DuelCardState victim=pile_card_state(&d->players[owner],PILE_GRAVE,index);if(!(victim.history&DUEL_HISTORY_BATTLE))continue;++d->battle_death_count;d->battle_last_death=(DuelBattleRevival){victim,0,0,t->player,0,1,t->slot};/* The death's previous orientation was recorded before the field cleared. */d->battle_last_death.position=d->battle_death_position[i];}}for(unsigned i=0;i<2;++i){DuelBattleRevival *j=&d->battle_revive_jobs[i];if(duel_battle_revival_ready(d,j))queue_trigger(d,DUEL_CHOICE_BATTLE_REVIVE,j->actor,j->card,i+1);else j->used=0;}d->battle_revival_notice=d->battle_death_count==1;}
static int battle_revival_window(Duel *d){d->battle_revival_notice=0;d->window=(DuelWindow){DUEL_WINDOW_BATTLE_DEATH,d->battle_last_death.controller,d->battle_last_death.slot,0,d->battle_last_death.victim.serial,0,d->battle_last_death.victim.card,0,d->battle_death_count};for(unsigned order=0;order<2;++order){unsigned actor=d->active^order;if(!duel_time_machine_available(d,actor))continue;for(unsigned i=0;i<5;++i){const DuelSlot *s=&d->players[actor].backrow[i];if(s->card&&d->cards[s->card].name_group==950&&s->position==DUEL_FACEDOWN_DEFENSE&&s->set_turn<d->turn&&!activation_blocked_for_slot(d,s->card,s->serial)){begin_response(d,actor);return 1;}}}clear(&d->window,sizeof(d->window));return 0;}
static void battle_revival_install(Duel *d,const DuelBattleRevival *j,unsigned position){unsigned actor=j->actor,side=j->controller,owner=j->victim.owner;if(actor>1||side>1||owner>1||!special_summon_allowed_for(d,actor)||empty_zone(d->players[actor].monsters)<0)return;int from=grave_index(&d->players[owner],j->victim.serial),to=empty_zone(d->players[side].monsters);if(from<0||to<0)return;DuelCardState state=take_pile_card(&d->players[owner],PILE_GRAVE,from);state.history&=3;DuelSlot *s=&d->players[side].monsters[to];clear(s,sizeof(*s));slot_install_state(d,s,state);s->position=position;s->set_turn=s->summoned_turn=d->turn;s->return_controller=DUEL_NO_SLOT;s->properly_summoned=1;special_summon_success(d,side,to);revival_triggers(d,side);d->summon_notice=(DuelWindow){DUEL_WINDOW_SUMMON,side,to,0,s->serial,0,s->card,0,2};event(d,DUEL_EVENT_REVIVE,side,to,s->card,0);}
static void battle_revival_resolve(Duel *d,const DuelChainLink *l){unsigned actor=l->command.player,owner=l->grave_targets[0].owner;if(owner>1||!special_summon_allowed_for(d,actor)||empty_zone(d->players[actor].monsters)<0||grave_index(&d->players[owner],l->grave_targets[0].serial)<0)return;DuelBattleRevival j={l->grave_targets[0],l->card,actor,d->cards[l->card].name_group==950?l->command.target_player:actor,l->command.position,1,0};if(d->cards[l->card].name_group==950){if(!l->effect_negated)battle_revival_install(d,&j,j.position);}else {d->battle_revive_task=j;d->choice=(DuelTrigger){DUEL_CHOICE_BATTLE_REVIVE_POSITION,actor,l->card,0};}}
static unsigned battle_revival_options(const Duel *d,DuelChoiceOption *options,unsigned capacity){unsigned kind=d->choice.kind;if(kind==DUEL_CHOICE_BATTLE_REVIVE_POSITION){for(unsigned i=0;i<2;++i)if(options&&i<capacity)options[i]=(DuelChoiceOption){d->battle_revive_task.victim.card,i,DUEL_OPTION_CONFIRM};return 2;}unsigned at=d->choice.serial-1;if(at>=2)return 0;unsigned n=0;if(duel_battle_revival_ready(d,&d->battle_revive_jobs[at])){if(options&&capacity)options[0]=(DuelChoiceOption){d->battle_revive_jobs[at].victim.card,0,DUEL_OPTION_CONFIRM};n=1;}if(options&&n<capacity)options[n]=(DuelChoiceOption){0,DUEL_NO_SLOT,DUEL_OPTION_SKIP};return n+1;}
static void battle_revival_choose(Duel *d,unsigned token){if(d->choice.kind==DUEL_CHOICE_BATTLE_REVIVE_POSITION){DuelBattleRevival j=d->battle_revive_task;finish_choice(d);clear(&d->battle_revive_task,sizeof(d->battle_revive_task));battle_revival_install(d,&j,token);return;}unsigned at=d->choice.serial-1;if(at>=2){finish_choice(d);return;}DuelBattleRevival j=d->battle_revive_jobs[at];d->battle_revive_jobs[at].used=0;finish_choice(d);if(token==DUEL_NO_SLOT)return;DuelChainLink *l=&d->chain[d->chain_count++];clear(l,sizeof(*l));l->command.player=j.actor;l->card=j.card;l->grave_targets[0]=j.victim;l->effect_activation=l->speed=1;d->trigger_chain_pending=1;}
