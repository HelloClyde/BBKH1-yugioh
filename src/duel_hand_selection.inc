/* Exchange snapshots both original hands before moving either card. Painful
 * Choice compares exact records, retaining the original first-copy behavior. */
static int hand_selection_kind(unsigned kind){return kind==DUEL_CHOICE_EXCHANGE_OTHER||kind==DUEL_CHOICE_EXCHANGE_OWN||kind==DUEL_CHOICE_PAINFUL_DECK||kind==DUEL_CHOICE_PAINFUL_KEEP;}
static int hand_selection_validate(const Duel *d,const DuelCommand *c,unsigned name){unsigned actor=c->player;return (name==1081?d->players[actor].deck_count>=5:d->players[actor].hand_count>(c->action==DUEL_ACTION_ACTIVATE_HAND)&&d->players[1-actor].hand_count)?DUEL_OK:DUEL_NOT_ALLOWED;}
static int hand_selection_index(const DuelPlayer *p,unsigned pile,uint32_t serial){unsigned count=pile==PILE_HAND?p->hand_count:p->deck_count;for(unsigned i=0;i<count;++i)if(pile_card_state(p,pile,i).serial==serial)return i;return -1;}
static DuelCardState hand_selection_identify(Duel *d,unsigned side,unsigned pile,unsigned index){DuelPlayer *p=&d->players[side];DuelCardState state=card_state_identify(d,pile_card_state(p,pile,index));if(pile==PILE_HAND)p->hand_state[index]=state;else p->deck_state[index]=state;return state;}
static unsigned hand_selection_options(const Duel *d,DuelChoiceOption *options,unsigned capacity){unsigned kind=d->choice.kind,actor=d->choice.serial-1,n=0;const DuelPlayer *p=&d->players[kind==DUEL_CHOICE_EXCHANGE_OTHER?1-actor:actor];
    if(kind==DUEL_CHOICE_PAINFUL_KEEP){for(unsigned i=0;i<5;++i){int from=hand_selection_index(p,PILE_DECK,d->choice_targets[i].serial);if(from<0)continue;if(options&&n<capacity)options[n]=(DuelChoiceOption){p->deck[from],i,DUEL_OPTION_CARD};++n;}return n;}
    unsigned count=kind==DUEL_CHOICE_PAINFUL_DECK?p->deck_count:p->hand_count;for(unsigned i=0;i<count;++i){unsigned selected=0;if(kind==DUEL_CHOICE_PAINFUL_DECK)for(unsigned j=0;j<d->choice.selected_count;++j)selected|=pile_card_state(p,PILE_DECK,i).serial&&pile_card_state(p,PILE_DECK,i).serial==d->choice_targets[j].serial;if(selected)continue;if(options&&n<capacity)options[n]=(DuelChoiceOption){kind==DUEL_CHOICE_PAINFUL_DECK?p->deck[i]:p->hand[i],i,DUEL_OPTION_CARD};++n;}return n;
}
static void hand_selection_resolve(Duel *d,const DuelChainLink *l){unsigned actor=l->command.player;if(l->effect_negated)return;if(d->cards[l->card].name_group==1081){if(d->players[actor].deck_count<5)return;d->choice=(DuelTrigger){DUEL_CHOICE_PAINFUL_DECK,actor,l->card,actor+1};}else{if(!d->players[actor].hand_count||!d->players[1-actor].hand_count)return;d->choice=(DuelTrigger){DUEL_CHOICE_EXCHANGE_OTHER,actor,l->card,actor+1};}}
static void hand_selection_choose(Duel *d,unsigned token){unsigned actor=d->choice.serial-1,kind=d->choice.kind;DuelPlayer *p=&d->players[actor];
    if(kind==DUEL_CHOICE_EXCHANGE_OTHER){DuelCardState state=hand_selection_identify(d,1-actor,PILE_HAND,token);d->choice_targets[0]=(DuelTarget){state.serial,1-actor,token};d->choice.kind=DUEL_CHOICE_EXCHANGE_OWN;d->choice.player=1-actor;return;}
    if(kind==DUEL_CHOICE_EXCHANGE_OWN){int other=hand_selection_index(&d->players[1-actor],PILE_HAND,d->choice_targets[0].serial);if(other<0){finish_choice(d);return;}DuelCardState own=hand_selection_identify(d,actor,PILE_HAND,token),received=take_pile_card(&d->players[1-actor],PILE_HAND,other);take_pile_card(p,PILE_HAND,token);finish_choice(d);put_pile_card(d,actor,PILE_HAND,received,0);put_pile_card(d,1-actor,PILE_HAND,own,0);event(d,DUEL_EVENT_RETURN,actor,0,received.card,0);event(d,DUEL_EVENT_RETURN,1-actor,0,own.card,0);return;}
    if(kind==DUEL_CHOICE_PAINFUL_DECK){DuelCardState state=hand_selection_identify(d,actor,PILE_DECK,token);d->choice_targets[d->choice.selected_count++]=(DuelTarget){state.serial,actor,token};if(d->choice.selected_count==5){d->choice.kind=DUEL_CHOICE_PAINFUL_KEEP;d->choice.player=1-actor;}return;}
    int chosen=hand_selection_index(p,PILE_DECK,d->choice_targets[token].serial);if(chosen<0){finish_choice(d);return;}unsigned record=p->deck[chosen],keep=0;for(;keep<5;++keep){int at=hand_selection_index(p,PILE_DECK,d->choice_targets[keep].serial);if(at>=0&&p->deck[at]==record)break;}DuelTarget selected[5];for(unsigned i=0;i<5;++i)selected[i]=d->choice_targets[i];finish_choice(d);if(keep>=5)return;
    int from=hand_selection_index(p,PILE_DECK,selected[keep].serial);DuelCardState received=take_pile_card(p,PILE_DECK,from);put_pile_card(d,actor,PILE_HAND,received,0);event(d,DUEL_EVENT_RETURN,actor,0,record,0);
    for(unsigned i=0;i<5;++i)if(i!=keep){from=hand_selection_index(p,PILE_DECK,selected[i].serial);if(from>=0)grave_deck_state(d,actor,take_pile_card(p,PILE_DECK,from),actor,1);}shuffle(d,p);
}
static unsigned hand_selection_ai_choice(const Duel *d){DuelChoiceOption options[DUEL_OPTION_MAX];unsigned n=hand_selection_options(d,options,DUEL_OPTION_MAX),best=0;int score=-2147483647;for(unsigned i=0;i<n;++i){const DuelCardDef *c=&d->cards[options[i].card];int value=c->family==DUEL_MONSTER?c->attack+(c->level<=4?500:0):2000;if(d->choice.kind==DUEL_CHOICE_PAINFUL_KEEP)value=-value;if(value>score){score=value;best=options[i].index;}}return best;}
