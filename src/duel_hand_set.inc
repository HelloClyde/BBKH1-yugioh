/* Ordinary and effect-driven hand setting share ownership, age and field
 * replacement. The effect-driven path does not invent a strict LP gate. */
static int set_hand_card(Duel *d,unsigned side,unsigned source,unsigned target,unsigned forced){DuelPlayer *p=&d->players[side];if(source>=p->hand_count||target>DUEL_FIELD_SLOT)return DUEL_BAD_ARGUMENT;unsigned card=p->hand[source];const DuelCardDef *c=&d->cards[card];if(c->family==DUEL_MONSTER)return DUEL_NOT_ALLOWED;if(!duel_card_supported(c))return DUEL_UNSUPPORTED;if(d->cold_wave_until||duel_card_prohibited(d,card,0))return DUEL_NOT_ALLOWED;if((target==DUEL_FIELD_SLOT)!=(c->effect==DUEL_E_FIELD))return DUEL_BAD_TARGET;if(target==DUEL_FIELD_SLOT){if(!field_rule(d,card))return DUEL_UNSUPPORTED;}else if(p->backrow[target].card)return DUEL_ZONE_FULL;
    unsigned fee=hand_play_cost(d);if(!forced&&!can_pay_action(d,side,fee))return DUEL_NOT_ALLOWED;if(fee>(unsigned)p->life)fee=p->life;pay_action(d,side,fee);if(!p->life){check_victory_boundary(d);return DUEL_OK;}
    if(target==DUEL_FIELD_SLOT&&p->field.card)leave_field(d,side,target,1,LEAVE_REPLACE);DuelCardState played=take_pile_card(p,PILE_HAND,source);DuelSlot *s=spell_zone(p,target);clear(s,sizeof(*s));s->card=card;s->owner=side;s->position=DUEL_FACEDOWN_DEFENSE;s->set_turn=d->turn;if(c->family==DUEL_SPELL&&live_backrow_name(d,1180,3))s->position_lock_until=d->turn+2;slot_install_state(d,s,played);event(d,DUEL_EVENT_SET,side,target,card,0);return DUEL_OK;
}
