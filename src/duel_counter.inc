#include "duel_counter_data.h"
static const CounterRule *counter_rule(const Duel *d,unsigned card){if(d->cards[card].effect!=DUEL_E_COUNTER)return 0;for(unsigned i=0;i<DUEL_COUNTER_RULE_COUNT;++i)if(counter_rules[i].name==d->cards[card].name_group)return &counter_rules[i];return 0;}
static int activation_unnegatable(const Duel *d,unsigned card){return d->cards[card].name_group==1539;}
static int counter_targeting_spell(const Duel *d,unsigned card){for(unsigned i=0;i<DUEL_COUNTER_TARGET_SPELL_COUNT;++i)if(counter_target_spells[i]==d->cards[card].name_group)return 1;return 0;}
unsigned duel_counter_tribute_cost(const DuelCardDef *c){if(c->effect!=DUEL_E_COUNTER)return 0;for(unsigned i=0;i<DUEL_COUNTER_RULE_COUNT;++i)if(counter_rules[i].name==c->name_group&&counter_rules[i].op==5)return 1;return 0;}
static int counter_tribute_eligible(const Duel *d,unsigned side,unsigned index){unsigned owner=tribute_owner(side,index),slot=index%5;return index<10&&duel_can_tribute(d,side,owner,slot)&&!(d->window.kind==DUEL_WINDOW_SUMMON_NEGATION&&d->window.player==owner&&d->window.source==slot);}
static unsigned counter_tributes_available(const Duel *d,unsigned side){unsigned n=0;for(unsigned i=0;i<10;++i)n+=counter_tribute_eligible(d,side,i);return n;}
static unsigned counter_life_cost(const Duel *d,unsigned side,unsigned card){const CounterRule *r=counter_rule(d,card);return r?(r->op==4?(unsigned)d->players[side].life/2:r->cost):0;}
static int counter_validate(const Duel *d,unsigned side,unsigned card){const CounterRule *r=counter_rule(d,card);if(!r)return DUEL_NOT_ALLOWED;
    if((r->op==4||r->op==5)&&!d->chain_count){const DuelWindow *w=&d->window;if(w->kind!=DUEL_WINDOW_SUMMON_NEGATION||w->negated||w->player>1||w->source>=5)return DUEL_NOT_ALLOWED;const DuelSlot *s=&d->players[w->player].monsters[w->source];return s->card&&s->serial==w->serial&&(r->op!=5||counter_tributes_available(d,side))?DUEL_OK:DUEL_NOT_ALLOWED;}
    if(!d->chain_count||r->op==5)return DUEL_NOT_ALLOWED;const DuelChainLink *last=&d->chain[d->chain_count-1];if(last->effect_activation||activation_unnegatable(d,last->card))return DUEL_NOT_ALLOWED;unsigned family=d->cards[last->card].family;if(r->cost&&d->players[side].life<=r->cost)return DUEL_NOT_ALLOWED;
    return (r->op==1?family==DUEL_TRAP:r->op==2?family==DUEL_SPELL&&last->command.player!=side:r->op==4?family==DUEL_SPELL||family==DUEL_TRAP:family==DUEL_SPELL&&counter_targeting_spell(d,last->card))?DUEL_OK:DUEL_NOT_ALLOWED;
}
static int counter_validate_tribute(const Duel *d,const DuelCommand *c,unsigned card){if(!duel_counter_tribute_cost(&d->cards[card]))return DUEL_OK;if(c->tributes&~1023u)return DUEL_BAD_ARGUMENT;unsigned n=0;for(unsigned i=0;i<10;++i)if(c->tributes&(1u<<i)){if(!counter_tribute_eligible(d,c->player,i))return DUEL_BAD_TARGET;++n;}return n==1?DUEL_OK:DUEL_NEED_TRIBUTES;}
static void counter_pay(Duel *d,const DuelCommand *c,unsigned card){unsigned amount=counter_life_cost(d,c->player,card);if(amount){d->players[c->player].life-=amount;event(d,DUEL_EVENT_DAMAGE,c->player,0,card,amount);}if(duel_counter_tribute_cost(&d->cards[card]))for(unsigned i=0;i<10;++i)if(c->tributes&(1u<<i))leave_field(d,tribute_owner(c->player,i),i%5,0,LEAVE_TRIBUTE);}
static int counter_ai_cost(const Duel *d,unsigned side,unsigned card,DuelCommand *c){if(!duel_counter_tribute_cost(&d->cards[card]))return 1;int best=-1;for(unsigned i=0;i<10;++i)if(counter_tribute_eligible(d,side,i)&&(best<0||duel_attack_value(d,tribute_owner(side,i),i%5)<duel_attack_value(d,tribute_owner(side,best),best%5)))best=i;if(best<0)return 0;c->tributes=1u<<best;return 1;}
static void counter_negate(Duel *d,unsigned index){if(index>=d->chain_count)return;DuelChainLink *target=&d->chain[index];target->negated=1;if(target->effect_activation||target->source_slot>DUEL_FIELD_SLOT)return;DuelSlot *s=spell_zone(&d->players[target->command.player],target->source_slot);if(s->card==target->card&&s->serial==target->source_serial)leave_field(d,target->command.player,target->source_slot,1,LEAVE_NEGATE);}
static int counter_drain_payment_allowed(const Duel *d){for(unsigned side=0;side<2;++side)for(unsigned i=0;i<5;++i){const DuelSlot *s=&d->players[side].backrow[i];if(s->card&&s->position!=DUEL_FACEDOWN_DEFENSE&&s->effect_active&&d->cards[s->card].name_group==1180&&!duel_field_effect_negated(d,s->card))return 0;}return 1;}
static unsigned counter_drain_options(const Duel *d,DuelChoiceOption *options,unsigned capacity){const DuelPlayer *p=&d->players[d->choice.player];unsigned n=0;for(unsigned i=0;i<p->hand_count;++i)if(d->cards[p->hand[i]].family==DUEL_SPELL){if(options&&n<capacity)options[n]=(DuelChoiceOption){p->hand[i],i,DUEL_OPTION_CARD};++n;}if(n){if(options&&n<capacity)options[n]=(DuelChoiceOption){0,DUEL_NO_SLOT,DUEL_OPTION_SKIP};++n;}return n;}
static void counter_drain_choose(Duel *d,unsigned index){if(index==DUEL_NO_SLOT)counter_negate(d,d->choice.serial);else discard_hand_effect(d,d->choice.player,index,d->choice.player,0);finish_choice(d);}
static void counter_resolve(Duel *d,const DuelChainLink *link){const CounterRule *r=counter_rule(d,link->card);unsigned index=link->command.target;if(!r)return;
    if(index==DUEL_NO_SLOT&&(r->op==4||r->op==5)){DuelWindow *w=&d->window;if(w->kind!=DUEL_WINDOW_SUMMON_NEGATION||w->negated||w->player>1||w->source>=5)return;DuelSlot *s=&d->players[w->player].monsters[w->source];if(!s->card||s->serial!=w->serial)return;w->negated=1;s->properly_summoned=0;leave_field(d,w->player,w->source,0,LEAVE_NEGATE);return;}
    if(index>=d->chain_count)return;if(r->op!=2){counter_negate(d,index);return;}DuelChainLink *target=&d->chain[index];d->choice=(DuelTrigger){DUEL_CHOICE_MAGIC_DRAIN,target->command.player,link->card,index};if(!counter_drain_payment_allowed(d)||!counter_drain_options(d,0,0)){finish_choice(d);counter_negate(d,index);}}
