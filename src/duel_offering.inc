/* Extra Normal Summons reuse ordinary validation and deployment. They are
 * resolved inside this effect and preserve the free normal-summon budget. */
static int offering_phase(const Duel *d,unsigned side){return side==d->active?main_phase(d):d->phase==DUEL_BATTLE;}
static unsigned offering_bits(unsigned mask){unsigned n=0;while(mask){n+=mask&1;mask>>=1;}return n;}
static int offering_plan(const Duel *d,unsigned side,unsigned hand,unsigned set,unsigned prefix,DuelCommand *result){if(side>1||hand>=d->players[side].hand_count)return 0;const DuelPlayer *p=&d->players[side];DuelCommand c={side,set?DUEL_ACTION_SET_MONSTER:DUEL_ACTION_SUMMON,hand};unsigned need=duel_normal_tribute_cost(d,side,hand,set),have=offering_bits(prefix);if(have>need)return 0;c.tributes=prefix;for(unsigned token=0;token<10;++token)if(prefix&(1u<<token))if(!duel_can_normal_tribute(d,side,tribute_owner(side,token),token%5))return 0;for(unsigned token=0;token<10&&have<need;++token)if(!(c.tributes&(1u<<token))&&duel_can_normal_tribute(d,side,tribute_owner(side,token),token%5)){c.tributes|=1u<<token;++have;}if(have!=need)return 0;int zone=-1;for(unsigned i=0;i<5;++i)if(!p->monsters[i].zone_blocked&&(!p->monsters[i].card||(c.tributes&(1u<<i)))){zone=i;break;}if(zone<0)return 0;c.target=zone;if(normal_summon_check(d,&c,1)!=DUEL_OK)return 0;if(result)*result=c;return 1;}
unsigned duel_offering_forms(const Duel *d,unsigned side,unsigned hand){if(!d||side>1)return 0;unsigned n=0;for(unsigned set=0;set<2;++set)if(offering_plan(d,side,hand,set,0,0))n|=set?16:1;return n;}
static int offering_extra_available(const Duel *d,unsigned side,unsigned cost){if(!offering_phase(d,side)||d->players[side].life<=(int)(cost+hand_play_cost(d)))return 0;for(unsigned i=0;i<d->players[side].hand_count;++i)if(duel_offering_forms(d,side,i))return 1;return 0;}
static int offering_ai_wants(const Duel *d,unsigned side){for(unsigned i=0;i<d->chain_count;++i)if(d->chain[i].command.player==side&&d->cards[d->chain[i].card].name_group==1017&&d->chain[i].command.cost==1)return 0;return offering_extra_available(d,side,500);}
static int offering_can_use(const Duel *d,unsigned side,unsigned index){if(index>=5||d->battle_pending)return 0;const DuelSlot *s=&d->players[side].backrow[index];return s->card&&d->cards[s->card].name_group==1017&&s->effect_active&&s->position!=DUEL_FACEDOWN_DEFENSE&&!activation_blocked_for_slot(d,s->card,s->serial)&&offering_extra_available(d,side,500);}
static int offering_activate(Duel *d,const DuelCommand *c){if(!offering_can_use(d,c->player,c->source)||d->chain_count>=DUEL_CHAIN_MAX)return DUEL_NOT_ALLOWED;if(d->response_player<2){if(d->response_player!=c->player)return DUEL_EFFECT_PENDING;if((d->chain_count&&d->chain[d->chain_count-1].speed>2)||(d->window.kind==DUEL_WINDOW_SUMMON_NEGATION&&!d->chain_count)||d->window.kind==DUEL_WINDOW_DAMAGE||d->window.kind==DUEL_WINDOW_DAMAGE_LIFE)return DUEL_NOT_ALLOWED;}const DuelSlot *s=&d->players[c->player].backrow[c->source];pay_action(d,c->player,500);DuelChainLink *l=&d->chain[d->chain_count++];clear(l,sizeof(*l));l->command=*c;l->command.cost=1;l->card=s->card;l->source_slot=c->source;l->source_serial=s->serial;l->speed=2;l->effect_activation=1;event(d,DUEL_EVENT_SPELL,c->player,c->source,s->card,0);begin_response(d,1-c->player);return DUEL_OK;}
static void offering_resolve(Duel *d,const DuelChainLink *l){unsigned side=l->command.player;const DuelSlot *s=&d->players[side].backrow[l->source_slot];if(s->card!=l->card||l->effect_negated||duel_field_effect_negated(d,l->card)||l->command.cost!=1||!offering_extra_available(d,side,0))return;clear(&d->offering_summon,sizeof(d->offering_summon));d->offering_summon.player=side;d->choice=(DuelTrigger){DUEL_CHOICE_OFFERING_HAND,side,l->card,0};}
static int offering_choice(unsigned kind){return kind>=DUEL_CHOICE_OFFERING_PAY&&kind<=DUEL_CHOICE_OFFERING_ZONE;}
static unsigned offering_options(const Duel *d,DuelChoiceOption *options,unsigned capacity){unsigned kind=d->choice.kind,side=d->choice.player,n=0;const DuelCommand *c=&d->offering_summon;const DuelPlayer *p=&d->players[side];if(kind==DUEL_CHOICE_OFFERING_PAY){if(options&&capacity)options[0]=(DuelChoiceOption){d->choice.card,0,DUEL_OPTION_CONFIRM};n=1;}else if(kind==DUEL_CHOICE_OFFERING_HAND){for(unsigned i=0;i<p->hand_count;++i)if(duel_offering_forms(d,side,i)){if(options&&n<capacity)options[n]=(DuelChoiceOption){p->hand[i],i,DUEL_OPTION_CARD};++n;}}else if(kind==DUEL_CHOICE_OFFERING_FORM){unsigned forms=duel_offering_forms(d,side,c->source);for(unsigned set=0;set<2;++set)if(forms&(set?16:1)){if(options&&n<capacity)options[n]=(DuelChoiceOption){p->hand[c->source],set,DUEL_OPTION_CONFIRM};++n;}}else if(kind==DUEL_CHOICE_OFFERING_TRIBUTE){for(unsigned token=0;token<10;++token)if(!(c->tributes&(1u<<token))&&offering_plan(d,side,c->source,c->action==DUEL_ACTION_SET_MONSTER,c->tributes|(1u<<token),0)){if(options&&n<capacity)options[n]=(DuelChoiceOption){tribute_monster(d,side,token)->card,token,DUEL_OPTION_CARD};++n;}}else if(kind==DUEL_CHOICE_OFFERING_ZONE){for(unsigned i=0;i<5;++i){DuelCommand selected=*c;selected.target=i;if(normal_summon_check(d,&selected,1)==DUEL_OK){if(options&&n<capacity)options[n]=(DuelChoiceOption){0,i,DUEL_OPTION_CONFIRM};++n;}}}if(options&&n<capacity)options[n]=(DuelChoiceOption){0,DUEL_NO_SLOT,DUEL_OPTION_SKIP};return n+1;}
static int offering_choose(Duel *d,unsigned token){unsigned kind=d->choice.kind,side=d->choice.player;if(kind==DUEL_CHOICE_OFFERING_PAY){DuelCommand selected=d->equip_mode_command;selected.cost=token==DUEL_NO_SLOT?2:1;finish_choice(d);clear(&d->equip_mode_command,sizeof(d->equip_mode_command));return activate(d,&selected,1);}if(token==DUEL_NO_SLOT){finish_choice(d);clear(&d->offering_summon,sizeof(d->offering_summon));++d->revision;return DUEL_OK;}DuelCommand *c=&d->offering_summon;if(kind==DUEL_CHOICE_OFFERING_HAND){c->source=token;d->choice.kind=DUEL_CHOICE_OFFERING_FORM;}else if(kind==DUEL_CHOICE_OFFERING_FORM){c->action=token?DUEL_ACTION_SET_MONSTER:DUEL_ACTION_SUMMON;d->choice.kind=duel_normal_tribute_cost(d,side,c->source,token)?DUEL_CHOICE_OFFERING_TRIBUTE:DUEL_CHOICE_OFFERING_ZONE;}else if(kind==DUEL_CHOICE_OFFERING_TRIBUTE){c->tributes|=1u<<token;if(offering_bits(c->tributes)==duel_normal_tribute_cost(d,side,c->source,c->action==DUEL_ACTION_SET_MONSTER))d->choice.kind=DUEL_CHOICE_OFFERING_ZONE;}else if(kind==DUEL_CHOICE_OFFERING_ZONE){DuelCommand selected=*c;selected.target=token;finish_choice(d);clear(c,sizeof(*c));int r=summon_context(d,&selected,1);if(r!=DUEL_OK)return r;}++d->revision;return DUEL_OK;}
