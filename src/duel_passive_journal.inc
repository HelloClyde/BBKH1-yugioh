/* These original observers use per-deployment counters and a later live
 * source check. Removing or suppressing the source before flush loses the
 * pending damage. Thorn observes actual discards, not every Hand departure. */
static int passive_source_live(const Duel *d,const DuelSlot *s,unsigned forbid){return s->card&&s->effect_active&&s->position!=DUEL_FACEDOWN_DEFENSE&&!s->monster_negated&&!duel_field_effect_negated(d,s->card)&&(!forbid||!duel_card_prohibited(d,s->card,s->serial));}
static void passive_grave_collect(Duel *d,unsigned owner){if(!(d->passive_presence&2))return;for(unsigned side=0;side<2;++side)for(unsigned i=0;i<5;++i){DuelSlot *s=&d->players[side].backrow[i];if(s->card&&d->cards[s->card].name_group==1306&&passive_source_live(d,s,0))s->original_attack+=1u<<(owner*8);}}
static void passive_discard_collect(Duel *d,unsigned side,unsigned owner){if(side!=owner||!(d->passive_presence&1))return;for(unsigned i=0;i<5;++i){DuelSlot *s=&d->players[1-side].backrow[i];if(s->card&&d->cards[s->card].name_group==1038&&passive_source_live(d,s,0))++s->original_attack;}}
static int passive_flush(Duel *d){if(!(d->passive_presence&3))return 0;unsigned processed=0;const unsigned names[2]={1038,1306};for(unsigned which=0;which<2;++which)for(unsigned order=0;order<2;++order){unsigned side=d->active^order;for(unsigned i=0;i<5;++i){DuelSlot *s=&d->players[side].backrow[i];if(!s->card||d->cards[s->card].name_group!=names[which]||!s->original_attack)continue;unsigned count=s->original_attack;s->original_attack=0;if(!passive_source_live(d,s,0))continue;processed=1;if(!which)damage(d,1-side,count*500);else {unsigned first=d->active;damage(d,first,((count>>(first*8))&255)*300);damage(d,1-first,((count>>((1-first)*8))&255)*300);}}}return processed;}
static unsigned servant_cost(const Duel *d,unsigned actor,unsigned index){if(!(d->passive_presence&4)||duel_spell_immune(d,actor,index))return 0;unsigned n=0;for(unsigned i=0;i<5;++i){const DuelSlot *s=&d->players[1-actor].backrow[i];n+=s->card&&d->cards[s->card].name_group==1063&&passive_source_live(d,s,1);}return n;}
static int servant_ready(const Duel *d,unsigned actor,unsigned index){return d->players[actor].deck_count>=servant_cost(d,actor,index);}
static void servant_pay(Duel *d,unsigned actor,unsigned index){unsigned n=servant_cost(d,actor,index);if(n)duel_mill_deck(d,actor,n,1-actor);}
static int goblin_fan_flip(Duel *d,unsigned actor,unsigned index){if(!(d->passive_presence&8))return 0;const DuelSlot *m=&d->players[actor].monsters[index];if(!m->card||d->cards[m->card].level>=3)return 0;unsigned any=0,opposing=0,card=0;for(unsigned side=0;side<2;++side)for(unsigned i=0;i<5;++i){const DuelSlot *s=&d->players[side].backrow[i];if(s->card&&d->cards[s->card].name_group==686&&passive_source_live(d,s,1)){any=1;card=s->card;opposing|=side!=actor;}}if(!any)return 0;unsigned saved=d->effect_actor_plus1;d->effect_actor_plus1=(opposing?1-actor:actor)+1;effect_destroy_monster(d,card,actor,index);d->effect_actor_plus1=saved;return 1;}
