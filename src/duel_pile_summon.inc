/* Embedded summons share a typed source/position task, not a CPU procedure. */
int duel_summon_procedure_candidate(const Duel *d,unsigned side,unsigned kind,unsigned index,unsigned parameter){if(!d||side>1)return 0;const DuelPlayer *p=&d->players[side];unsigned card=kind==9?(index<p->fusion_count?p->fusion[index]:0):(index<p->deck_count?p->deck[index]:0);if(!card||!duel_card_supported(&d->cards[card]))return 0;const DuelCardDef *c=&d->cards[card];if(kind==8)return c->name_group==34;if(kind==9)return c->family==DUEL_MONSTER&&c->subtype==2;return kind==10&&c->family==DUEL_MONSTER&&c->race==10&&c->level==parameter&&(!duel_normal_prohibited[card]||(toon_card(c)&&toon_world_present(d,side)));}
static unsigned pile_summon_card(const Duel *d,unsigned owner,unsigned kind,unsigned token){const DuelPlayer *p=&d->players[owner];if(kind==9)return token<p->fusion_count?p->fusion[token]:0;if(kind==3||kind==6||kind==11||kind==12)return token<p->grave_count?p->grave[token]:0;if(token<DUEL_HAND_MAX)return token<p->hand_count?p->hand[token]:0;token-=DUEL_HAND_MAX;return (kind==1||kind==4||kind==5||kind==7||kind==8||kind==10)&&token<p->deck_count?p->deck[token]:0;}
static int pile_summon_match(const Duel *d,unsigned owner,unsigned kind,unsigned token){unsigned card=pile_summon_card(d,owner,kind,token);if(!card||!duel_card_supported(&d->cards[card]))return 0;const DuelCardDef *c=&d->cards[card];if(kind==8||kind==10)return token>=DUEL_HAND_MAX&&duel_summon_procedure_candidate(d,owner,kind,token-DUEL_HAND_MAX,d->pile_summon_task.parameter);if(kind==9)return duel_summon_procedure_candidate(d,owner,kind,token,0);if(kind==12)return d->pile_summon_task.parameter<3&&d->players[owner].grave_serial[token]==d->pile_summon_task.instances[d->pile_summon_task.parameter];if(kind==11)return (int)token==contact_grave_index(d,owner,d->pile_summon_task.spell,d->pile_summon_task.parameter);if(kind==3||kind==6)return duel_can_revive_for(d,owner,owner,token);if(kind==7)return token>=DUEL_HAND_MAX&&duel_last_will_candidate(d,owner,card);if(kind==1)return c->name_group==61||c->name_group==62;if(kind==4)return c->name_group==1202;if(kind==5){const DeckEvolutionRule *r=deck_evolution_rule(&d->cards[d->pile_summon_task.spell]);return token>=DUEL_HAND_MAX&&r&&c->name_group==r->result;}return c->family==DUEL_MONSTER&&c->race==1&&c->subtype<2&&!special_hand_provenance(c);}
static int pile_summon_source_gate(const Duel *d,unsigned side,unsigned kind){if((kind==8&&d->summon_activity[side])||!special_summon_allowed_for(d,side)||empty_zone(d->players[side].monsters)<0)return 0;if(kind==1)return live_monster_name(d,61,3)!=0;if(kind==2)return live_monster_name(d,740,3)!=0;return 1;}
static unsigned pile_summon_candidates(const Duel *d,unsigned side,unsigned kind,DuelChoiceOption *options,unsigned capacity){if(!pile_summon_source_gate(d,side,kind))return 0;const DuelPlayer *p=&d->players[side];unsigned n=0,limit=(kind==3||kind==6||kind==11||kind==12)?p->grave_count:kind==9?p->fusion_count:(kind==1||kind==4||kind==5||kind==7||kind==8||kind==10)?DUEL_HAND_MAX+p->deck_count:p->hand_count;for(unsigned i=0;i<limit;++i)if(pile_summon_match(d,side,kind,i)){if(options&&n<capacity)options[n]=(DuelChoiceOption){pile_summon_card(d,side,kind,i),i,DUEL_OPTION_CARD};++n;}return n;}
static int pile_summon_validate(const Duel *d,unsigned side,unsigned kind){if(kind==6)return duel_gila_revival_options(d,side,0,0)?DUEL_OK:DUEL_NOT_ALLOWED;if(kind==3)return !special_summon_allowed_for(d,0)||!special_summon_allowed_for(d,1)||!pile_summon_candidates(d,0,3,0,0)||!pile_summon_candidates(d,1,3,0,0)?DUEL_NOT_ALLOWED:DUEL_OK;if(!pile_summon_source_gate(d,side,kind))return DUEL_NOT_ALLOWED;return (kind==2||kind==8)&&!pile_summon_candidates(d,side,kind,0,0)?DUEL_NOT_ALLOWED:DUEL_OK;}
static void pile_summon_next(Duel *d){DuelPileSummonTask *t=&d->pile_summon_task;for(;;){if(t->remaining&&pile_summon_candidates(d,t->chooser,t->kind,0,0)){if(t->kind==11||t->kind==12){int index=t->kind==12?grave_index(&d->players[t->chooser],t->instances[t->parameter]):contact_grave_index(d,t->chooser,t->spell,t->parameter);t->selected_index=index;t->selected=d->players[t->chooser].grave[index];d->choice=(DuelTrigger){DUEL_CHOICE_PILE_SUMMON_POSITION,t->chooser,t->spell,0};}else d->choice=(DuelTrigger){DUEL_CHOICE_PILE_SUMMON,t->chooser,t->spell,0};return;}if(t->kind==3&&t->chooser==t->actor){t->chooser=1-t->actor;t->remaining=1;continue;}unsigned should_ban=t->kind==8,actor=t->actor;clear(t,sizeof(*t));finish_choice(d);if(should_ban)summon_turn_ban(d,actor);return;}}
static void pile_summon_begin_parameter(Duel *d,unsigned side,unsigned card,unsigned kind,unsigned parameter){d->pile_summon_task=(DuelPileSummonTask){card,0,side,side,kind,kind==2?2:kind==11?3:1,0,parameter,{0}};if(kind==6)d->pile_summon_task.chooser=1-side;if(kind==5){DuelChoiceOption option;if(pile_summon_candidates(d,side,kind,&option,1)){d->pile_summon_task.selected=option.card;d->pile_summon_task.selected_index=option.index;d->choice=(DuelTrigger){DUEL_CHOICE_PILE_SUMMON_POSITION,side,card,0};return;}}pile_summon_next(d);}
static void pile_summon_begin(Duel *d,unsigned side,unsigned card,unsigned kind){pile_summon_begin_parameter(d,side,card,kind,0);}
static unsigned pile_summon_options(const Duel *d,DuelChoiceOption *options,unsigned capacity){const DuelPileSummonTask *t=&d->pile_summon_task;if(d->choice.kind==DUEL_CHOICE_PILE_SUMMON_POSITION){if(!pile_summon_match(d,t->chooser,t->kind,t->selected_index)||!pile_summon_source_gate(d,t->chooser,t->kind))return 0;for(unsigned i=0;i<2;++i)if(options&&i<capacity)options[i]=(DuelChoiceOption){t->selected,i,DUEL_OPTION_CONFIRM};return 2;}unsigned n=pile_summon_candidates(d,t->chooser,t->kind,options,capacity);if((t->kind==2||t->kind==6)&&n){if(options&&n<capacity)options[n]=(DuelChoiceOption){0,DUEL_NO_SLOT,DUEL_OPTION_SKIP};++n;}return n;}
static void pile_summon_choose(Duel *d,unsigned token){DuelPileSummonTask *t=&d->pile_summon_task;if(token==DUEL_NO_SLOT){t->remaining=0;pile_summon_next(d);return;}if(d->choice.kind==DUEL_CHOICE_PILE_SUMMON){t->selected_index=token;t->selected=pile_summon_card(d,t->chooser,t->kind,token);if(t->kind!=3){d->choice.kind=DUEL_CHOICE_PILE_SUMMON_POSITION;return;}token=DUEL_FACEDOWN_DEFENSE;}
    unsigned owner=t->chooser,kind=t->kind,index=t->selected_index,card=t->selected;DuelPlayer *p=&d->players[owner];int to=empty_zone(p->monsters);if(to<0||!special_summon_allowed_for(d,owner)||!pile_summon_match(d,owner,kind,index)||pile_summon_card(d,owner,kind,index)!=card){t->remaining=0;pile_summon_next(d);return;}
    DuelCardState summoned=kind==9?take_pile_card(p,PILE_FUSION,index):kind==3||kind==6||kind==11||kind==12?take_pile_card(p,PILE_GRAVE,index):index<DUEL_HAND_MAX?take_pile_card(p,PILE_HAND,index):take_pile_card(p,PILE_DECK,index-DUEL_HAND_MAX);if(kind==3||kind==6||kind==11||kind==12)summoned.history&=3;if(kind==1||kind==4||kind==5||kind==7||kind==8||kind==10)shuffle(d,p);
    DuelSlot *s=&p->monsters[to];clear(s,sizeof(*s));s->card=card;s->owner=owner;s->position=token;s->summoned_turn=s->set_turn=d->turn;s->properly_summoned=1;s->return_controller=DUEL_NO_SLOT;slot_install_state(d,s,summoned);s->properly_summoned=kind!=9;if(kind==9)s->destroy_end_turn=d->turn;special_summon_success(d,owner,to);d->summon_notice=(DuelWindow){DUEL_WINDOW_SUMMON,owner,to,0,s->serial,0,card,0,2};if(kind==3||kind==6||kind==11||kind==12)revival_triggers(d,owner);event(d,DUEL_EVENT_REVIVE,owner,to,card,0);if(t->remaining)--t->remaining;if(kind==11||kind==12)++t->parameter;if(kind==4){dark_sage_search_begin(d,owner,card);return;}pile_summon_next(d);
}
