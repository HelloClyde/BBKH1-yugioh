/* Time Wizard's optional continuation stays inside its resolution. The actual
 * hand/deck summon uses the common typed pile/position task. */
static unsigned dark_sage_tributes(const Duel *d,unsigned side,DuelChoiceOption *options,unsigned capacity){unsigned count=0;for(unsigned i=0;i<5;++i){const DuelSlot *s=&d->players[side].monsters[i];if(!s->card||d->cards[s->card].name_group!=34)continue;if(options&&count<capacity)options[count]=(DuelChoiceOption){s->card,i,DUEL_OPTION_CARD};++count;}return count;}
static unsigned dark_sage_spells(const Duel *d,unsigned side,DuelChoiceOption *options,unsigned capacity){const DuelPlayer *p=&d->players[side];if(p->hand_count>=DUEL_HAND_MAX)return 0;unsigned count=0;for(unsigned i=0;i<p->deck_count;++i)if(d->cards[p->deck[i]].family==DUEL_SPELL){if(options&&count<capacity)options[count]=(DuelChoiceOption){p->deck[i],i,DUEL_OPTION_CARD};++count;}return count;}
static void time_wizard_offer(Duel *d,unsigned side,unsigned card){if(!special_summon_allowed_for(d,side)||continuous_count(d,5)||!live_monster_name(d,34,1u<<side)||!pile_summon_candidates(d,side,4,0,0))return;d->pile_summon_task=(DuelPileSummonTask){card,0,side,side,4,1,0};d->choice=(DuelTrigger){DUEL_CHOICE_DARK_SAGE_OFFER,side,card,0};}
static void dark_sage_search_begin(Duel *d,unsigned side,unsigned card){finish_choice(d);if(dark_sage_spells(d,side,0,0)){d->choice=(DuelTrigger){DUEL_CHOICE_DARK_SAGE_SPELL,side,card,0};return;}clear(&d->pile_summon_task,sizeof(d->pile_summon_task));}
static unsigned dark_sage_options(const Duel *d,DuelChoiceOption *options,unsigned capacity){unsigned side=d->choice.player;if(d->choice.kind==DUEL_CHOICE_DARK_SAGE_TRIBUTE)return dark_sage_tributes(d,side,options,capacity);if(d->choice.kind==DUEL_CHOICE_DARK_SAGE_SPELL)return dark_sage_spells(d,side,options,capacity);if(options&&capacity)options[0]=(DuelChoiceOption){d->choice.card,0,DUEL_OPTION_CONFIRM};if(options&&capacity>1)options[1]=(DuelChoiceOption){0,DUEL_NO_SLOT,DUEL_OPTION_SKIP};return 2;}
static void dark_sage_choose(Duel *d,unsigned token){unsigned side=d->choice.player;if(d->choice.kind==DUEL_CHOICE_DARK_SAGE_OFFER){if(token==DUEL_NO_SLOT){clear(&d->pile_summon_task,sizeof(d->pile_summon_task));finish_choice(d);return;}d->choice.kind=DUEL_CHOICE_DARK_SAGE_TRIBUTE;return;}if(d->choice.kind==DUEL_CHOICE_DARK_SAGE_TRIBUTE){leave_field(d,side,token,0,LEAVE_TRIBUTE);pile_summon_next(d);return;}DuelPlayer *p=&d->players[side];DuelCardState selected=card_state_reset(take_pile_card(p,PILE_DECK,token));unsigned card=selected.card;put_pile_card(d,side,PILE_HAND,selected,0);shuffle(d,p);event(d,DUEL_EVENT_RETURN,side,0,card,0);clear(&d->pile_summon_task,sizeof(d->pile_summon_task));finish_choice(d);}
