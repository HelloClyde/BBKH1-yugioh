/* Shared tribute selection for a spell and a Flip activation. Both pay the
 * selected physical monster before opening the response chain. */
static int summon_procedure_cost_target(const Duel *d,unsigned actor,unsigned name,unsigned source,unsigned side,unsigned index){if(!duel_can_tribute(d,actor,side,index))return 0;if(name==1512)return side!=actor||index!=source;const DuelSlot *s=&d->players[side].monsters[index];if(name!=1318||!special_summon_allowed_for(d,actor)||!d->cards[s->card].level||(side!=actor&&s->position==DUEL_FACEDOWN_DEFENSE)||(empty_zone(d->players[actor].monsters)<0&&side!=actor))return 0;for(unsigned i=0;i<d->players[actor].deck_count;++i)if(duel_summon_procedure_candidate(d,actor,10,i,d->cards[s->card].level+1))return 1;return 0;}
static unsigned summon_procedure_cost_options_for(const Duel *d,unsigned actor,unsigned name,unsigned source,DuelChoiceOption *options,unsigned capacity){unsigned n=0;for(unsigned side=0;side<2;++side)for(unsigned i=0;i<5;++i)if(summon_procedure_cost_target(d,actor,name,source,side,i)){if(options&&n<capacity)options[n]=(DuelChoiceOption){d->players[side].monsters[i].card,side*5+i,DUEL_OPTION_CARD};++n;}return n;}
static int summon_procedure_illusion_gate(const Duel *d,unsigned actor,unsigned source){if(!special_summon_allowed_for(d,actor)||!summon_procedure_cost_options_for(d,actor,1512,source,0,0))return 0;for(unsigned i=0;i<d->players[actor].fusion_count;++i)if(duel_summon_procedure_candidate(d,actor,9,i,0))return 1;return 0;}
static unsigned summon_procedure_cost_options(const Duel *d,DuelChoiceOption *options,unsigned capacity){unsigned name=d->cards[d->choice.card].name_group,n=summon_procedure_cost_options_for(d,d->choice.player,name,d->choice.selected_count,options,capacity);if(options&&n<capacity)options[n]=(DuelChoiceOption){0,DUEL_NO_SLOT,DUEL_OPTION_SKIP};return n+1;}
static int summon_procedure_insect_validate(const Duel *d,const DuelCommand *c){if(!special_summon_allowed_for(d,c->player)||!summon_procedure_cost_options_for(d,c->player,1318,DUEL_NO_SLOT,0,0))return DUEL_NOT_ALLOWED;if(!c->cost)return DUEL_OK;if(c->cost!=1||!c->tributes||c->tributes>10)return DUEL_BAD_ARGUMENT;unsigned token=c->tributes-1;return summon_procedure_cost_target(d,c->player,1318,DUEL_NO_SLOT,token/5,token%5)?DUEL_OK:DUEL_BAD_TARGET;}
static void summon_procedure_illusion_choose(Duel *d,unsigned token){unsigned actor=d->choice.player,card=d->choice.card,source=d->choice.selected_count;uint32_t serial=d->choice.serial;finish_choice(d);if(token==DUEL_NO_SLOT)return;leave_field(d,token/5,token%5,0,LEAVE_TRIBUTE);DuelChainLink *l=&d->chain[d->chain_count++];clear(l,sizeof(*l));l->card=card;l->source_slot=source;l->source_serial=serial;l->command.player=actor;l->speed=l->effect_activation=1;d->trigger_chain_pending=1;}
