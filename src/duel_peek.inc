/* Revealing is a read-only snapshot. It never flips a field card or fires
 * a Flip/continuous effect while the player is reading the information. */
static unsigned peek_hidden_field(const Duel *d,unsigned actor,unsigned both,uint16_t *cards){unsigned count=0;for(unsigned i=0;i<(both?2:1);++i){unsigned side=i?actor:1-actor;for(unsigned index=0;index<11;++index){const DuelSlot *s=index<5?&d->players[side].monsters[index]:index==10?&d->players[side].field:&d->players[side].backrow[index-5];if(s->card&&s->position==DUEL_FACEDOWN_DEFENSE){if(cards)cards[count]=s->card;++count;}}}return count;}
static void peek_finish(Duel *d){clear(&d->peek_task,sizeof(d->peek_task));finish_choice(d);}
static void peek_begin(Duel *d,unsigned actor,unsigned source,unsigned kind){DuelPeekTask *task=&d->peek_task;clear(task,sizeof(*task));task->actor=actor;task->owner=kind==5?actor:1-actor;task->kind=kind;if(kind==2){if(!d->players[task->owner].hand_count)return;d->choice=(DuelTrigger){DUEL_CHOICE_PEEK_HAND,actor,source,0};return;}if(kind==1||kind==5){const DuelPlayer *p=&d->players[task->owner];task->count=p->deck_count<5?p->deck_count:5;for(unsigned i=0;i<task->count;++i)task->cards[i]=p->deck[p->deck_count-1-i];}else task->count=peek_hidden_field(d,actor,kind==4,task->cards);if(task->count)d->choice=(DuelTrigger){kind==5?DUEL_CHOICE_PEEK_ORDER:DUEL_CHOICE_PEEK_VIEW,kind==4?0:actor,source,0};}
static unsigned peek_options(const Duel *d,DuelChoiceOption *options,unsigned capacity){const DuelPeekTask *task=&d->peek_task;unsigned count=0;if(d->choice.kind==DUEL_CHOICE_PEEK_HAND){for(unsigned i=0;i<d->players[task->owner].hand_count;++i){if(options&&count<capacity)options[count]=(DuelChoiceOption){0,i,DUEL_OPTION_CARD};++count;}return count;}for(unsigned i=0;i<task->count;++i){if(task->selected_mask&(1u<<i))continue;if(options&&count<capacity)options[count]=(DuelChoiceOption){task->cards[i],i,DUEL_OPTION_CARD};++count;}if(d->choice.kind==DUEL_CHOICE_PEEK_VIEW||d->choice.kind==DUEL_CHOICE_PEEK_ORDER&&!task->selected_count){if(options&&count<capacity)options[count]=(DuelChoiceOption){0,DUEL_NO_SLOT,DUEL_OPTION_SKIP};++count;}return count;}
static void peek_choose(Duel *d,unsigned index){DuelPeekTask *task=&d->peek_task;if(d->choice.kind==DUEL_CHOICE_PEEK_HAND){task->cards[0]=d->players[task->owner].hand[index];task->count=1;d->choice.kind=DUEL_CHOICE_PEEK_VIEW;return;}if(d->choice.kind==DUEL_CHOICE_PEEK_VIEW||index==DUEL_NO_SLOT){peek_finish(d);return;}task->selected_mask|=1u<<index;task->selected[task->selected_count++]=index;if(task->selected_count==task->count){DuelPlayer *p=&d->players[task->owner];DuelCardState original[5];for(unsigned i=0;i<task->count&&i<5;++i)original[i]=pile_card_state(p,PILE_DECK,p->deck_count-1-i);for(unsigned i=0;i<task->count&&i<5;++i){unsigned at=p->deck_count-1-i;p->deck[at]=task->cards[task->selected[i]];p->deck_state[at]=original[task->selected[i]];}event(d,DUEL_EVENT_RETURN,task->owner,0,d->choice.card,task->count);peek_finish(d);}}
