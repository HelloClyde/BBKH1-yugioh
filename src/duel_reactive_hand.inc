static int reactive_hand_name(unsigned name){return name==1141||name==1142;}
static void reactive_promote(Duel *d){if(d->resolving)return;d->reactive_current.draw|=d->reactive_pending.draw;d->reactive_current.discard|=d->reactive_pending.discard;d->reactive_current.gust|=d->reactive_pending.gust;d->reactive_current.snow|=d->reactive_pending.snow;d->reactive_current.michi|=d->reactive_pending.michi;d->reactive_current.damage|=d->reactive_pending.damage;d->reactive_current.riot|=d->reactive_pending.riot;clear(&d->reactive_pending,sizeof(d->reactive_pending));}
static int reactive_hand_gate(const Duel *d,unsigned actor,unsigned name){unsigned draw=d->reactive_current.draw|d->reactive_pending.draw,discard=d->reactive_current.discard|d->reactive_pending.discard;return name==1141?d->phase!=DUEL_DRAW&&(draw&(1u<<(1-actor))):name==1142?!!(discard&(1u<<actor)):1;}
static void reactive_discard_collect(Duel *d,unsigned actor){d->reactive_pending.discard|=1u<<actor;for(unsigned i=0;i<5;++i){DuelSlot *s=&d->players[actor].backrow[i];if(!s->card||d->cards[s->card].name_group!=1142||!passive_source_live(d,s,1))continue;if(s->control_used){++s->original_attack;continue;}s->control_used=1;s->original_attack=0;unsigned before=d->trigger_count;queue_trigger(d,DUEL_TRIGGER_CONTINUOUS,actor,s->card,s->serial);if(d->trigger_count>before)d->triggers[before].selected_count=i;}}
static void reactive_draw_batch(Duel *d,unsigned drawer,unsigned suppress_initial){if(d->winner>=0||d->phase==DUEL_DRAW)return;if(!suppress_initial)d->reactive_pending.draw|=1u<<drawer;unsigned actor=1-drawer;for(unsigned i=0;i<5;++i){DuelSlot *s=&d->players[actor].backrow[i];if(!s->card||d->cards[s->card].name_group!=1141||!passive_source_live(d,s,1))continue;unsigned before=d->trigger_count;queue_trigger(d,DUEL_TRIGGER_CONTINUOUS,actor,s->card,s->serial);if(d->trigger_count>before)d->triggers[before].selected_count=i;}}
static void reactive_hand_resolve(Duel *d,const DuelChainLink *l){unsigned actor=l->command.player,index=l->source_slot;if(index>=5)return;DuelSlot *s=&d->players[actor].backrow[index];if(s->card!=l->card)return;if(d->cards[l->card].name_group==1141){draw_cards(d,actor,2);return;}/* Original callbacks follow the old coordinate/name, not its old UID or visibility. */s->control_used=0;unsigned count=s->original_attack+1;s->original_attack=0;if(count>d->players[1-actor].hand_count)count=d->players[1-actor].hand_count;if(count)hand_begin_choice(d,1-actor,1-actor,actor,l->card,1,count,0,0);}
static int reactive_open(Duel *d){if(d->chain_count||d->resolving||d->choice.kind||d->response_player<2||d->window.kind||d->winner>=0||(!d->reactive_pending.draw&&!d->reactive_pending.discard&&!d->reactive_pending.gust&&!d->reactive_pending.snow&&!d->reactive_pending.michi&&!d->reactive_pending.damage&&!d->reactive_pending.riot))return 0;unsigned possible=0;for(unsigned side=0;side<2;++side)for(unsigned i=0;i<5;++i){const DuelSlot *s=&d->players[side].backrow[i];if(s->card&&s->position==DUEL_FACEDOWN_DEFENSE&&s->set_turn<d->turn&&((reactive_hand_name(d->cards[s->card].name_group)&&reactive_hand_gate(d,side,d->cards[s->card].name_group))||(reactive_field_name(d->cards[s->card].name_group)&&reactive_field_gate(d,side,d->cards[s->card].name_group))))possible=1;}if(!possible){clear(&d->reactive_pending,sizeof(d->reactive_pending));return 0;}d->window=(DuelWindow){DUEL_WINDOW_REACTIVE,d->active};begin_response(d,d->active);return 1;}
