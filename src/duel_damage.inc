/* Damage-calculation choices suspend the native battle before LP/destruction. */
static int damage_component_name(unsigned name){return name==370||name==371||name==372;}
static int damage_component_matches(const Duel *d,const DuelWindow *w,unsigned side,unsigned index){if(side>1||index>=5||side==w->player||w->target!=index||w->source>=5||w->target>=5||d->phase!=DUEL_BATTLE||d->active!=w->player)return 0;const DuelSlot *s=&d->players[side].monsters[index],*a=&d->players[w->player].monsters[w->source];return s->card&&a->card&&a->serial==w->serial&&s->serial==w->target_serial&&s->position!=DUEL_FACEDOWN_DEFENSE&&!s->control_used&&damage_component_name(d->cards[s->card].name_group)&&duel_can_target_monster(d,w->player,w->source);}
static int damage_component_response(const Duel *d,unsigned side,unsigned index){return d->window.kind==DUEL_WINDOW_DAMAGE&&(!d->chain_count||d->chain[d->chain_count-1].speed<=2)&&damage_component_matches(d,&d->window,side,index);}
static int damage_component_activate(Duel *d,const DuelCommand *c){if(d->response_player!=c->player||d->chain_count>=DUEL_CHAIN_MAX||!damage_component_response(d,c->player,c->source))return DUEL_NOT_ALLOWED;DuelSlot *s=&d->players[c->player].monsters[c->source];s->control_used=1;DuelChainLink *link=&d->chain[d->chain_count++];clear(link,sizeof(*link));link->command=*c;link->command.target_player=d->window.player;link->command.target=d->window.source;link->card=s->card;link->source_slot=c->source;link->source_serial=s->serial;link->target_serial=d->window.serial;link->speed=2;link->effect_activation=1;event(d,DUEL_EVENT_SPELL,c->player,c->source,s->card,0);begin_response(d,1-c->player);return DUEL_OK;}
static void damage_component_resolve(Duel *d,const DuelChainLink *link){unsigned side=link->command.target_player,index=link->command.target;if(d->window.kind!=DUEL_WINDOW_DAMAGE||side>1||index>=5)return;const DuelSlot *s=&d->players[side].monsters[index];if(s->card&&s->serial==link->target_serial)d->damage_zero_serial=s->serial;}
static void damage_state_clear(Duel *d){clear(&d->guard_battle,sizeof(d->guard_battle));clear(&d->punch_attacker,sizeof(d->punch_attacker));clear(&d->punch_defender,sizeof(d->punch_defender));d->damage_stage=d->damage_revealed=0;d->battle_effect_destroy_count=d->battle_equipment_destroy_count=0;d->damage_zero_serial=0;d->damage_amount[0]=d->damage_amount[1]=0;d->damage_event_mask=d->damage_dealer_side=d->damage_dealer_slot=0;}

static int damage_kuriboh_index(const Duel *d,unsigned side){const DuelPlayer *p=&d->players[side];for(unsigned i=0;i<p->hand_count;++i)if(d->cards[p->hand[i]].name_group==57&&duel_card_supported(&d->cards[p->hand[i]])&&!duel_card_activation_blocked(d,p->hand[i]))return i;return -1;}
static int damage_kuriboh_response(const Duel *d,unsigned side,unsigned index){return d->window.kind==DUEL_WINDOW_DAMAGE_LIFE&&side!=d->active&&d->phase==DUEL_BATTLE&&d->damage_amount[side]&&damage_kuriboh_index(d,side)==(int)index;}
static int damage_kuriboh_activate(Duel *d,const DuelCommand *c){if(d->response_player!=c->player||!damage_kuriboh_response(d,c->player,c->source))return DUEL_NOT_ALLOWED;d->damage_amount[c->player]=0;unsigned card=discard_hand_effect(d,c->player,c->source,c->player,0);event(d,DUEL_EVENT_SPELL,c->player,c->source,card,0);d->response_passes=2;return DUEL_OK;}
