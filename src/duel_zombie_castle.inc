/* Cached Monster suppression is refreshed only while visible, as598d70 does.
 * Castle associations retain their order and source identity across hiding. */
static void monster_negation_refresh(Duel *d){if(!(d->field_name_cache&(512|2048)))return;unsigned royal=(d->field_name_cache&512)&&live_backrow_name(d,1530,3)!=0;for(unsigned side=0;side<2;++side)for(unsigned i=0;i<5;++i){DuelSlot *s=&d->players[side].monsters[i];if(s->card&&s->position!=DUEL_FACEDOWN_DEFENSE)s->monster_negated=royal&&flip_card(d,s->card);}}
static void castle_attach(Duel *d,const DuelSlot *source,DuelSlot *target){if(!target->serial)target->serial=++d->next_serial;stat_links_cleanup(d);if(d->stat_link_count<DUEL_STAT_LINK_MAX){d->stat_links[d->stat_link_count++]=(DuelStatLink){source->serial,target->serial,10};d->stat_snapshot_present|=16;}}
static void castle_flip_resolve(Duel *d,const DuelChainLink *link){unsigned side=link->command.player,index=link->source_slot;if(link->effect_negated||index>=5)return;DuelSlot *source=&d->players[side].monsters[index];if(source->card!=link->card||source->position==DUEL_FACEDOWN_DEFENSE)return;if(!source->serial)source->serial=++d->next_serial;source->control_used=1;for(unsigned p=0;p<2;++p)for(unsigned i=0;i<5;++i){DuelSlot *target=&d->players[p].monsters[i];if(target->card&&target->position!=DUEL_FACEDOWN_DEFENSE&&duel_race(d,p,i)==2)castle_attach(d,source,target);}}
static void pumpking_observer(Duel *d,unsigned standby){if(!(d->field_name_cache&1024))return;for(unsigned side=0;side<2;++side)for(unsigned i=0;i<5;++i){DuelSlot *s=&d->players[side].monsters[i];if(!s->card||s->position==DUEL_FACEDOWN_DEFENSE||d->cards[s->card].name_group!=98)continue;s->control_used=1;if(side==standby&&s->hourglass_turn<4)++s->hourglass_turn;}}
static void castle_standby(Duel *d,unsigned side){for(unsigned index=0;index<5;++index){DuelSlot *source=&d->players[side].monsters[index];if(!source->card||source->position==DUEL_FACEDOWN_DEFENSE||d->cards[source->card].name_group!=82||!source->control_used||source->hourglass_turn>=4)continue;++source->hourglass_turn;if(source->monster_negated)continue;for(unsigned p=0;p<2;++p)for(unsigned i=0;i<5;++i){DuelSlot *target=&d->players[p].monsters[i];if(!target->card||target->position==DUEL_FACEDOWN_DEFENSE||duel_race(d,p,i)!=2)continue;unsigned linked=0;for(unsigned n=0;n<d->stat_link_count;++n)linked|=d->stat_links[n].kind==10&&d->stat_links[n].source==source->serial&&d->stat_links[n].target==target->serial;if(linked)castle_attach(d,source,target);}}pumpking_observer(d,side);}
static int castle_bonus_since(const Duel *d,unsigned side,unsigned index,int after){if(!(d->stat_snapshot_present&16))return 0;const DuelSlot *target=&d->players[side].monsters[index];if(!target->card||target->position==DUEL_FACEDOWN_DEFENSE||duel_race(d,side,index)!=2)return 0;int value=0;for(unsigned n=after+1;n<d->stat_link_count;++n){const DuelStatLink *l=&d->stat_links[n];if(l->kind!=10||l->target!=target->serial)continue;const DuelSlot *source=stat_link_source(d,l);if(source&&d->cards[source->card].name_group==82&&!source->monster_negated&&!duel_card_prohibited(d,source->card,source->serial))value+=200;}return value;}
