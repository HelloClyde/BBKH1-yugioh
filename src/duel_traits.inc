/* Presence-only cache. Liveness, immunity and ordering remain real queries.
 * Rebuilt after field mutations and at each public command boundary. */
void duel_refresh_field_cache(Duel *d){unsigned mask=0;d->passive_presence=0;for(unsigned p=0;p<2;++p)for(unsigned i=0;i<5;++i){unsigned card=d->players[p].backrow[i].card;if(card)switch(d->cards[card].name_group){case 1038:d->passive_presence|=1;break;case 1306:d->passive_presence|=2;break;case 1063:d->passive_presence|=4;break;case 686:d->passive_presence|=8;break;case 1145:mask|=1;break;case 1550:mask|=2;break;case 1448:mask|=4;break;case 1146:mask|=8;break;case 1162:mask|=16;break;case 1426:mask|=32;break;case 1151:mask|=64;break;case 1424:mask|=128;break;case 1026:mask|=256;break;case 1530:mask|=512;break;}const DuelSlot *monster=&d->players[p].monsters[i];if(monster->zone_blocked&2)mask|=4096;if(monster->card){if(d->cards[monster->card].name_group==1124)mask|=8192;if(d->cards[monster->card].name_group==731)mask|=16384;if(d->cards[monster->card].name_group==82&&monster->position!=DUEL_FACEDOWN_DEFENSE)mask|=1024;if(monster->monster_negated)mask|=2048;}}d->field_name_cache=mask;if(!(mask&16)){d->prohibition_disabled_mask=0;return;}/* Original source-use checks read the already reconciled per-source disabled bit. Keeping that view separate avoids recursive IO/Jinzo/Prohibition queries. */for(unsigned step=0;step<12;++step){unsigned disabled=0;for(unsigned p=0;p<2;++p)for(unsigned i=0;i<5;++i){const DuelSlot *s=&d->players[p].backrow[i];if(s->card&&d->cards[s->card].name_group==1162&&duel_field_effect_negated(d,s->card))disabled|=1u<<(p*5+i);}if(disabled==d->prohibition_disabled_mask)break;d->prohibition_disabled_mask=disabled;}}
/* Field traits are live derived values. Immutable card traits still describe
 * cards in a hand, Deck, Graveyard, Fusion Deck or banished pile. */
static uint32_t source_field_order(const DuelSlot *s){return s->field_order?s->field_order:s->serial;}
static void source_field_reveal(Duel *d,DuelSlot *source){for(unsigned p=0;p<2;++p)for(unsigned i=0;i<5;++i){const DuelSlot *s=&d->players[p].backrow[i];if(s->card&&source_field_order(s)>d->next_field_order)d->next_field_order=source_field_order(s);}source->field_order=++d->next_field_order;}
static unsigned race_excluding(const Duel *d,unsigned side,unsigned index,uint32_t excluded){
    if(!d||side>1||index>=5)return 0;const DuelSlot *host=&d->players[side].monsters[index];if(!host->card)return 0;unsigned race=d->cards[host->card].race;uint32_t newest=0;if(host->position==DUEL_FACEDOWN_DEFENSE||(!(d->field_name_cache&3)&&!(d->stat_snapshot_present&64)))return race;
    if(d->stat_snapshot_present&64)for(unsigned n=0;n<d->stat_link_count;++n){const DuelStatLink *l=&d->stat_links[n];const DuelSlot *source;if(l->kind==12&&l->base_value==(int)side+1&&(source=stat_link_source(d,l))&&source->position!=DUEL_FACEDOWN_DEFENSE&&d->cards[source->card].name_group==762&&(uint32_t)l->attack_after>newest&&(uint32_t)l->attack_after!=excluded){race=10;newest=l->attack_after;}}
    for(unsigned p=0;p<2;++p)for(unsigned i=0;i<5;++i){const DuelSlot *s=&d->players[p].backrow[i];uint32_t order=source_field_order(s);if(s->card&&d->cards[s->card].name_group==1145&&s->position!=DUEL_FACEDOWN_DEFENSE&&s->effect_active&&!duel_field_effect_negated(d,s->card)&&s->control_used&&order>newest&&order!=excluded){race=s->control_used;newest=order;}}
    if((d->field_name_cache&2)&&!duel_spell_immune(d,side,index))for(unsigned p=0;p<2;++p)for(unsigned i=0;i<5;++i){const DuelSlot *s=&d->players[p].backrow[i];uint32_t order=source_field_order(s);if(s->card&&s->effect_active&&d->cards[s->card].name_group==1550&&s->link_serial==host->serial&&order>newest&&order!=excluded&&!equip_effect_negated(d,s->card))race=1;}
    return race;
}
unsigned duel_race(const Duel *d,unsigned side,unsigned index){return race_excluding(d,side,index,0);}
static int trait_attribute_source(const Duel *d,const DuelSlot *s,const DuelSlot *host){return s&&s->card&&s->effect_active&&d->cards[s->card].name_group==1448&&s->link_serial==host->serial&&!equip_effect_negated(d,s->card);}
unsigned duel_attribute(const Duel *d,unsigned side,unsigned index){
    if(!d||side>1||index>=5)return 0;const DuelSlot *host=&d->players[side].monsters[index];if(!host->card)return 0;unsigned attribute=d->cards[host->card].attribute;if(host->position==DUEL_FACEDOWN_DEFENSE||!(d->field_name_cache&4)||duel_spell_immune(d,side,index))return attribute;unsigned ordered=0;
    for(unsigned n=0;n<d->stat_link_count;++n){const DuelStatLink *l=&d->stat_links[n];if(l->kind!=2||l->target!=host->serial)continue;const DuelSlot *s=stat_link_source(d,l);if(trait_attribute_source(d,s,host)){attribute=s->control_used;ordered=1;}}
    /* Constructed states and older native associations may have no explicit
     * ordered link. Production attachment always appends one. */
    if(!ordered)for(unsigned p=0;p<2;++p)for(unsigned i=0;i<5;++i){const DuelSlot *s=&d->players[p].backrow[i];if(trait_attribute_source(d,s,host))attribute=s->control_used;}
    return attribute;
}
static int trait_attack_locked(const Duel *d,unsigned side,unsigned index){if(!(d->field_name_cache&8))return 0;unsigned race=duel_race(d,side,index);for(unsigned p=0;p<2;++p)for(unsigned i=0;i<5;++i){const DuelSlot *s=&d->players[p].backrow[i];if(s->card&&s->effect_active&&s->position!=DUEL_FACEDOWN_DEFENSE&&d->cards[s->card].name_group==1146&&s->control_used==race&&!duel_field_effect_negated(d,s->card))return 1;}return 0;}
static void equipment_order_attach(Duel *d,const DuelSlot *source,const DuelSlot *host){
    stat_links_cleanup(d);for(unsigned n=0;n<d->stat_link_count;++n)if(d->stat_links[n].kind==2&&d->stat_links[n].source==source->serial&&d->stat_links[n].target==host->serial)return;
    if(d->stat_link_count<DUEL_STAT_LINK_MAX)d->stat_links[d->stat_link_count++]=(DuelStatLink){source->serial,host->serial,2};
}
static unsigned trait_parameter_count(unsigned name){return name==1162?DUEL_CARD_COUNT-1:name==1145||name==1146?20:name==1448?6:0;}
static unsigned trait_parameter_options(const Duel *d,DuelChoiceOption *options,unsigned capacity){unsigned name=d->cards[d->choice.card].name_group,total=trait_parameter_count(name),count=0;const DuelCommand *c=&d->equip_mode_command;if(name==1162){unsigned page=d->choice.selected_count;for(unsigned i=1;i<=128&&page*128+i<DUEL_CARD_COUNT;++i){if(options&&count<capacity)options[count]=(DuelChoiceOption){page*128+i,i,DUEL_OPTION_CARD};++count;}if(page){if(options&&count<capacity)options[count]=(DuelChoiceOption){0,253,DUEL_OPTION_PAGE};++count;}if((page+1)*128+1<DUEL_CARD_COUNT){if(options&&count<capacity)options[count]=(DuelChoiceOption){0,254,DUEL_OPTION_PAGE};++count;}if(options&&count<capacity)options[count]=(DuelChoiceOption){0,DUEL_NO_SLOT,DUEL_OPTION_SKIP};return count+1;}for(unsigned i=1;i<=total;++i){if(name==1448&&i==duel_attribute(d,c->target_player,c->target))continue;if(options&&count<capacity)options[count]=(DuelChoiceOption){d->choice.card,i,DUEL_OPTION_CONFIRM};++count;}if(options&&count<capacity)options[count]=(DuelChoiceOption){0,DUEL_NO_SLOT,DUEL_OPTION_SKIP};return count+1;}

/* A declaration forbids new uses. Existing physical field copies get an
 * exemption snapshot when the original callback resolves. This is a use
 * restriction, not blanket negation of all same-name passive sources. */
int duel_card_prohibited(const Duel *d,unsigned card,uint32_t serial){
    if(!(d->field_name_cache&16)||!card_valid(d,card))return 0;for(unsigned p=0;p<2;++p)for(unsigned i=0;i<5;++i){const DuelSlot *s=&d->players[p].backrow[i];if(!s->card||!s->effect_active||s->position==DUEL_FACEDOWN_DEFENSE||d->cards[s->card].name_group!=1162||(d->prohibition_disabled_mask&(1u<<(p*5+i))))continue;if(s->link_serial&&s->link_serial<DUEL_CARD_COUNT&&d->cards[s->link_serial].name_group!=d->cards[card].name_group)continue;unsigned exempt=0;if(serial)for(unsigned n=0;n<10;++n){const DuelProhibition *r=&d->prohibitions[n];if(r->source!=s->serial)continue;for(unsigned j=0;j<r->count;++j)exempt|=r->exempt[j]==serial;}if(!exempt)return 1;}return 0;
}
static void prohibition_snapshot(Duel *d,const DuelSlot *source){d->field_name_cache|=16;
    DuelProhibition *r=0;for(unsigned n=0;n<10;++n){unsigned live=0;if(d->prohibitions[n].source)for(unsigned p=0;p<2;++p)for(unsigned i=0;i<5;++i)live|=d->players[p].backrow[i].serial==d->prohibitions[n].source;if(d->prohibitions[n].source==source->serial||!live){r=&d->prohibitions[n];break;}}if(!r)return;clear(r,sizeof(*r));r->source=source->serial;unsigned declared=source->link_serial;if(!declared||declared>=DUEL_CARD_COUNT)return;for(unsigned p=0;p<2;++p)for(unsigned i=0;i<11;++i){DuelSlot *s=i<5?&d->players[p].monsters[i]:spell_zone(&d->players[p],i-5);if(s->card&&d->cards[s->card].name_group==d->cards[declared].name_group){if(!s->serial)s->serial=++d->next_serial;r->exempt[r->count++]=s->serial;}}
}

static void prohibition_reconcile(Duel *d){if(!(d->field_name_cache&16))return;
    for(unsigned p=0;p<2;++p)for(unsigned i=0;i<5;++i){DuelSlot *s=&d->players[p].backrow[i];if(!s->card||!s->effect_active||s->position==DUEL_FACEDOWN_DEFENSE||d->cards[s->card].name_group!=1162)continue;DuelProhibition *r=0;for(unsigned n=0;n<10;++n)if(d->prohibitions[n].source==s->serial){r=&d->prohibitions[n];break;}unsigned suppressed=duel_field_effect_negated(d,s->card);if(!r){prohibition_snapshot(d,s);for(unsigned n=0;n<10;++n)if(d->prohibitions[n].source==s->serial){r=&d->prohibitions[n];break;}}if(r){if(r->suppressed&&!suppressed)prohibition_snapshot(d,s);r->suppressed=suppressed;}}
}
