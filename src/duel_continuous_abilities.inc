/* Reusing a face-up continuous card is an effect activation. The card stays
 * on the field; costs are selected and paid before responses are offered. */
static unsigned continuous_ability_kind(const Duel *d,unsigned card){if(d->cards[card].effect!=DUEL_E_CONTINUOUS)return 0;const ContinuousRule *r=continuous_rule(d,card);return r&&(r->op==23||r->op==24||r->op==32||r->op==33||r->op==37)?r->op:0;}
static unsigned grave_cost_count(const Duel *d,unsigned side){return pile_target_candidates(d,side,43,side,0,0,0);}
static unsigned lair_target_options(const Duel *d,unsigned paid,DuelChoiceOption *options,unsigned capacity){if(!paid)return 0;unsigned count=0;for(unsigned side=0;side<2;++side)for(unsigned i=0;i<5;++i){const DuelSlot *s=&d->players[side].monsters[i];if(!s->card||s->position==DUEL_FACEDOWN_DEFENSE||d->cards[s->card].level!=paid||battle_destroyed(d,side,i))continue;if(options&&count<capacity)options[count]=(DuelChoiceOption){s->card,side*5+i,DUEL_OPTION_CARD};++count;}return count;}
static int continuous_ability_can_start(const Duel *d,unsigned side,unsigned index){const DuelPlayer *p=&d->players[side];const DuelSlot *s=&p->backrow[index];unsigned op=s->card?continuous_ability_kind(d,s->card):0;if(op==37)return duel_inspection_ready(d,side,index);if(op==33)return s->effect_active&&s->position!=DUEL_FACEDOWN_DEFENSE&&!activation_blocked_for_slot(d,s->card,s->serial)&&duel_jam_redirect_ready(d,side);if(op==32)return offering_can_use(d,side,index);if(activation_blocked_for_slot(d,s->card,s->serial)||!op||!s->effect_active||s->position==DUEL_FACEDOWN_DEFENSE)return 0;if(op==23){for(unsigned i=0;i<p->hand_count;++i)if(d->cards[p->hand[i]].family==DUEL_SPELL)return 1;return 0;}unsigned available=grave_cost_count(d,side),room=DUEL_PILE_MAX-p->banished_count;if(!duel_spirit_active(d,side)&&available>room)available=room;for(unsigned i=1;i<=available&&i<=15;++i)if(lair_target_options(d,i,0,0))return 1;return 0;}
static int activate_continuous_ability(Duel *d,const DuelCommand *c){unsigned side=c->player;if(c->source<5&&d->cards[d->players[side].backrow[c->source].card].name_group==1428)return redirect_jam_begin(d,c,1);if(c->source<5&&d->cards[d->players[side].backrow[c->source].card].name_group==1017)return offering_activate(d,c);DuelSlot *source=&d->players[side].backrow[c->source];if(!continuous_ability_can_start(d,side,c->source)||d->battle_pending)return DUEL_NOT_ALLOWED;if(d->response_player<2){if(d->response_player!=side)return DUEL_EFFECT_PENDING;if(d->chain_count&&d->chain[d->chain_count-1].speed>2)return DUEL_NOT_ALLOWED;if(d->window.kind==DUEL_WINDOW_SUMMON_NEGATION&&!d->chain_count)return DUEL_NOT_ALLOWED;}else if(side!=d->active&&continuous_ability_kind(d,source->card)!=37)return DUEL_WRONG_TURN;if(continuous_ability_kind(d,source->card)==37&&d->response_player<2)return DUEL_NOT_ALLOWED;
    if(!source->serial)source->serial=++d->next_serial;DuelChainLink *link=&d->chain[d->chain_count++];clear(link,sizeof(*link));link->command=*c;link->command.cost=0;link->card=source->card;link->source_slot=c->source;link->source_serial=source->serial;link->speed=2;link->effect_activation=1;event(d,DUEL_EVENT_SPELL,side,c->source,source->card,0);
    if(continuous_ability_kind(d,source->card)==37){link->speed=1;pay_action(d,side,500);begin_response(d,1-side);return DUEL_OK;}
    if(continuous_ability_kind(d,source->card)==23){hand_begin_choice(d,side,side,side,source->card,1,1,0,1);d->hand_task.filter=DUEL_SPELL+1;link->target_card=500;}else pile_target_begin(d,d->chain_count-1,43);return DUEL_OK;}
static int continuous_ability_source(const Duel *d,const DuelChainLink *link){const DuelSlot *s=&d->players[link->command.player].backrow[link->source_slot];return s->card==link->card&&s->serial==link->source_serial&&s->position!=DUEL_FACEDOWN_DEFENSE&&s->effect_active&&!duel_field_effect_negated(d,s->card);}
static void continuous_ability_resolve(Duel *d,const DuelChainLink *link){if(d->cards[link->card].name_group==1161){inspection_resolve(d,link);return;}if(d->cards[link->card].name_group==1017){offering_resolve(d,link);return;}if(d->cards[link->card].name_group==1532){if(link->effect_negated||link->source_slot>=5||d->players[link->command.player].backrow[link->source_slot].card!=link->card||duel_field_effect_negated(d,link->card))return;if(lair_target_options(d,link->command.cost,0,0)){d->choice=(DuelTrigger){DUEL_CHOICE_LAIR_TARGET,link->command.player,link->card,link->source_serial};d->choice.selected_count=link->command.cost;}return;}if(!continuous_ability_source(d,link))return;unsigned op=continuous_ability_kind(d,link->card);if(op==23)damage(d,1-link->command.player,link->target_card);else if(op==24&&lair_target_options(d,link->command.cost,0,0)){d->choice=(DuelTrigger){DUEL_CHOICE_LAIR_TARGET,link->command.player,link->card,link->source_serial};d->choice.selected_count=link->command.cost;}}
static void lair_target_choose(Duel *d,unsigned token){unsigned side=token/5,index=token%5;finish_choice(d);destroy(d,side,index,0);}
static int continuous_ability_ai_wants(const Duel *d,unsigned side,unsigned index){if(!continuous_ability_can_start(d,side,index))return 0;unsigned op=continuous_ability_kind(d,d->players[side].backrow[index].card);if(op==37)return d->players[side].life>2000&&d->players[side].backrow[index].ignition_turn!=d->turn;if(op==32)return offering_ai_wants(d,side)&&(d->players[side].normal_summon_used||side!=d->active);if(op==23)return d->players[1-side].life<=500||(d->players[side].hand_count>3&&d->players[1-side].life<=1500);unsigned available=grave_cost_count(d,side),room=DUEL_PILE_MAX-d->players[side].banished_count;if(!duel_spirit_active(d,side)&&available>room)available=room;for(unsigned i=0;i<5;++i){const DuelSlot *s=&d->players[1-side].monsters[i];if(s->card&&s->position!=DUEL_FACEDOWN_DEFENSE&&d->cards[s->card].level&&d->cards[s->card].level<=available)return 1;}return 0;}

static int lair_initial_ready(const Duel *d,unsigned side){unsigned count=grave_cost_count(d,side);if(count>15)count=15;for(unsigned n=1;n<=count;++n)if(lair_target_options(d,n,0,0))return 1;return 0;}
static unsigned lair_offer_options(const Duel *d,DuelChoiceOption *options,unsigned capacity){if(options&&capacity)options[0]=(DuelChoiceOption){d->choice.card,0,DUEL_OPTION_CONFIRM};if(options&&capacity>1)options[1]=(DuelChoiceOption){0,DUEL_NO_SLOT,DUEL_OPTION_SKIP};return 2;}
static int lair_offer_choose(Duel *d,unsigned token){DuelCommand c=d->equip_mode_command;c.position=token==DUEL_NO_SLOT?2:1;finish_choice(d);return activate(d,&c,1);}
