static const ContactRecipe *contact_recipe(const DuelCardDef *c){for(unsigned i=0;i<DUEL_CONTACT_RECIPE_COUNT;++i)if(contact_recipes[i].source==c->name_group)return &contact_recipes[i];return 0;}
static unsigned contact_piece(const ContactRecipe *r,unsigned name){for(unsigned i=0;i<3;++i)if(r->materials[i]==name)return 1u<<i;return 0;}
static unsigned contact_cost_options(const Duel *d,unsigned actor,unsigned card,DuelChoiceOption *options,unsigned capacity){const ContactRecipe *r=contact_recipe(&d->cards[card]);if(!r||continuous_count(d,5))return 0;unsigned used=d->choice.kind==DUEL_CHOICE_SPECIAL_HAND_COST&&d->special_hand_task.card==card?d->special_hand_task.used_pieces:0,n=0;const DuelPlayer *p=&d->players[actor];for(unsigned i=0;i<p->hand_count;++i){unsigned piece=contact_piece(r,d->cards[p->hand[i]].name_group);if(piece&&!(used&piece)){if(options&&n<capacity)options[n]=(DuelChoiceOption){p->hand[i],i,DUEL_OPTION_CARD};++n;}}for(unsigned token=0;token<10;++token){const DuelSlot *s=tribute_monster(d,actor,token);if(!s->card||!duel_can_tribute(d,actor,tribute_owner(actor,token),token%5)||(token>=5&&s->position==DUEL_FACEDOWN_DEFENSE))continue;unsigned piece=contact_piece(r,d->cards[s->card].name_group);if(piece&&!(used&piece)){if(options&&n<capacity)options[n]=(DuelChoiceOption){s->card,DUEL_HAND_MAX+token,DUEL_OPTION_CARD};++n;}}return n;}
static int contact_can_start(const Duel *d,unsigned actor,unsigned card){const ContactRecipe *r=contact_recipe(&d->cards[card]);if(!r||continuous_count(d,5))return 0;const DuelPlayer *p=&d->players[actor];unsigned pieces=0,own=0;for(unsigned i=0;i<p->hand_count;++i)pieces|=contact_piece(r,d->cards[p->hand[i]].name_group);for(unsigned token=0;token<10;++token){const DuelSlot *s=tribute_monster(d,actor,token);if(!s->card||!duel_can_tribute(d,actor,tribute_owner(actor,token),token%5)||(token>=5&&s->position==DUEL_FACEDOWN_DEFENSE))continue;unsigned piece=contact_piece(r,d->cards[s->card].name_group);pieces|=piece;own|=piece&&token<5;}return pieces==7&&(empty_zone(p->monsters)>=0||own);}
static void contact_pay(Duel *d,unsigned actor,unsigned token){DuelSpecialHandTask *t=&d->special_hand_task;const ContactRecipe *r=contact_recipe(&d->cards[t->card]);if(token<DUEL_HAND_MAX){DuelCardState state=take_pile_card(&d->players[actor],PILE_HAND,token);t->used_pieces|=contact_piece(r,d->cards[state.card].name_group);if(token<t->index)--t->index;grave_material_state(d,actor,state,0);}else{token-=DUEL_HAND_MAX;t->used_pieces|=contact_piece(r,d->cards[tribute_monster(d,actor,token)->card].name_group);leave_field(d,tribute_owner(actor,token),token%5,0,LEAVE_TRIBUTE);}}
static int contact_grave_index(const Duel *d,unsigned actor,unsigned card,unsigned piece){const ContactRecipe *r=contact_recipe(&d->cards[card]);if(!r||piece>=3)return -1;const DuelPlayer *p=&d->players[actor];for(unsigned i=p->grave_count;i>0;--i)if(d->cards[p->grave[i-1]].name_group==r->materials[piece])return i-1;return -1;}
static int contact_return_ready(const Duel *d,unsigned actor,unsigned card,unsigned source){if(!special_summon_allowed_for(d,actor)||token_space(d,actor)+(source<5?1:0)<3)return 0;if(source<5&&!duel_can_tribute(d,actor,actor,source))return 0;for(unsigned i=0;i<3;++i)if(contact_grave_index(d,actor,card,i)<0)return 0;return 1;}
