/* Dedicated damage timing preserves the existing battle snapshot while
 * cards respond. It does not restart an attack or recalculate paid costs. */
static int punch_battle_ready(const Duel *d,const DuelWindow *w,unsigned actor){if(actor>1||w->player!=d->active||actor==w->player||w->source>=5||w->target>=5)return 0;const DuelSlot *a=&d->players[w->player].monsters[w->source],*b=&d->players[duel_battle_target_player(w)].monsters[w->target];if(!a->card||!b->card||a->serial!=w->serial||b->serial!=w->target_serial||b->position==DUEL_FACEUP_ATTACK)return 0;int values[4];return duel_combat_values_for(d,w->player,w->source,duel_battle_target_player(w),w->target,values)&&values[0]<values[3];}
int duel_destruction_punch_ready(const Duel *d,unsigned actor){return d&&d->window.kind==DUEL_WINDOW_DAMAGE&&punch_battle_ready(d,&d->window,actor);}
static int punch_window_needed(const Duel *d,const DuelWindow *w){unsigned actor=duel_battle_target_player(w);if(!punch_battle_ready(d,w,actor))return 0;for(unsigned i=0;i<5;++i){const DuelSlot *s=&d->players[actor].backrow[i];if(s->card&&d->cards[s->card].name_group==1535&&s->position==DUEL_FACEDOWN_DEFENSE&&s->set_turn<d->turn&&!activation_blocked_for_slot(d,s->card,s->serial))return 1;}return 0;}
void duel_punch_mark(Duel *d,const DuelChainLink *l){if(!d||!l||l->effect_negated)return;const DuelWindow *w=&d->window;if(w->player>1||w->source>=5||w->target>=5)return;DuelSlot *s=&d->players[duel_battle_target_player(w)].monsters[w->target];if(!s->card)return;if(!s->serial)s->serial=++d->next_serial;d->punch_defender=(DuelTarget){s->serial,duel_battle_target_player(w),w->target};d->punch_attacker=(DuelTarget){w->serial,w->player,w->source};d->punch_actor=l->command.player;}
void duel_punch_finish(Duel *d){const DuelTarget *a=&d->punch_attacker,*b=&d->punch_defender;if(!a->serial||!b->serial||a->player>1||b->player>1||a->slot>=5||b->slot>=5)return;const DuelSlot *attacker=&d->players[a->player].monsters[a->slot],*defender=&d->players[b->player].monsters[b->slot];if(!attacker->card||!defender->card||attacker->serial!=a->serial||defender->serial!=b->serial)return;unsigned actor=d->effect_actor_plus1;d->effect_actor_plus1=d->punch_actor+1;destroy(d,a->player,a->slot,0);d->effect_actor_plus1=actor;}
int duel_sebek_ready(const Duel *d,unsigned actor){if(!d||actor>1)return 0;const DuelWindow *w=&d->window;return w->kind==DUEL_WINDOW_DAMAGE_DONE&&w->player==actor&&w->target==DUEL_NO_SLOT&&w->source<5&&(w->formation&65535)&&duel_can_target_monster(d,actor,w->source);}
static int damage_done_window(Duel *d){DuelWindow saved=d->window;d->window=d->damage_done_notice;clear(&d->damage_done_notice,sizeof(d->damage_done_notice));unsigned actor=d->window.player;if(actor>1||!duel_sebek_ready(d,actor)){d->window=saved;return 0;}const DuelPlayer *p=&d->players[actor];for(unsigned from=0;from<2;++from)for(unsigned i=0;i<(from?5:p->hand_count);++i){unsigned card=from?p->backrow[i].card:p->hand[i];if(!card||d->cards[card].name_group!=1179||activation_blocked_for_slot(d,card,from?p->backrow[i].serial:0)||(!from&&!can_pay_action(d,actor,hand_play_cost(d))))continue;if(from&&(p->backrow[i].position!=DUEL_FACEDOWN_DEFENSE||p->backrow[i].set_turn>=d->turn))continue;if(!fragrance_allows(d,actor,i,from,card))continue;begin_response(d,actor);return 1;}d->window=saved;return 0;}
