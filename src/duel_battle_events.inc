#include "duel_battle_event_data.h"
static unsigned battle_event_op(const Duel *d,unsigned card){for(unsigned i=0;i<DUEL_BATTLE_EVENT_COUNT;++i)if(battle_event_rules[i].name==d->cards[card].name_group)return battle_event_rules[i].op;return 0;}
static void battle_damage_events(Duel *d,unsigned side,unsigned index,unsigned actual){if(!actual||d->winner>=0)return;const DuelSlot *s=&d->players[side].monsters[index];unsigned op=battle_event_op(d,s->card);if(op>=1&&op<=3||op==6||op==21)queue_trigger(d,DUEL_TRIGGER_BATTLE_AUTO,side,s->card,s->serial);
    for(unsigned i=0;i<5;++i){DuelSlot *source=&d->players[side].backrow[i];if(source->card&&source->effect_active&&source->position!=DUEL_FACEDOWN_DEFENSE&&d->cards[source->card].name_group==1045&&!duel_field_effect_negated(d,source->card)){if(!source->serial)source->serial=++d->next_serial;queue_trigger(d,DUEL_TRIGGER_CONTINUOUS,side,source->card,source->serial);}}}
static void battle_event_resolve(Duel *d,const DuelChainLink *link){unsigned side=link->command.player,op=battle_event_op(d,link->card);if(op==21){drill_begin(d,side,link->card);}else if(op==19){battle_revival_resolve(d,link);}else if(op==18){dimensional_resolve(d,link);}else if(op==11){duel_return_grave_to_deck(d,side);}else if(op==1)draw_cards(d,side,1);else if(op==2){DuelPlayer *p=&d->players[1-side];if(p->hand_count)discard_hand_effect(d,1-side,random_next(d)%p->hand_count,side,1);}else if(op==3)draw_cards(d,1-side,2);else if(op==4){for(unsigned p=0;p<2;++p)for(unsigned i=0;i<5;++i){const DuelSlot *s=&d->players[p].monsters[i];if(s->card&&s->serial==link->source_serial){DuelTarget t={s->serial,p,i};return_monster(d,&t);return;}}}else if(op==9||op==10){for(unsigned owner=0;owner<2;++owner)for(unsigned i=0;i<5;++i){const DuelSlot *s=&d->players[owner].monsters[i];if(s->card&&s->serial==link->source_serial){destroy(d,owner,i,0);return;}}}else if(op==8)destroy_monsters_mask(d,(31u&~(1u<<link->source_slot))<<(side*5));else if(op==7){DuelPlayer *p=&d->players[side];int index=grave_index(p,link->source_serial);if(index>=0&&p->grave[index]==link->card&&p->deck_count<DUEL_DECK_MAX){put_pile_card(d,side,PILE_DECK,card_state_reset(take_pile_card(p,PILE_GRAVE,index)),0);event(d,DUEL_EVENT_RETURN,side,0,link->card,0);}}else if(op==6)pile_target_resolve(d,link,41);else if(op==5&&d->phase==DUEL_BATTLE){battle_phase_cleanup(d);d->phase=DUEL_MAIN2;event(d,DUEL_EVENT_PHASE,d->active,0,link->card,DUEL_MAIN2);}}
