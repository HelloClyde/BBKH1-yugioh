/* Ordered base transformations are native stat operations. Their source spell
 * may leave; later source removal does not undo a captured numerical value. */
void duel_stat_snapshot(Duel *d,unsigned side,unsigned index,unsigned payload,unsigned additive){
    if(!d||side>1||index>=5||!d->players[side].monsters[index].card)return;payload&=65535;unsigned mode=payload&0xe000;if(mode!=0x4000&&mode!=0x6000&&mode!=0x8000)return;
    if((mode==0x4000||mode==0x8000)&&duel_spell_immune(d,side,index))return;DuelSlot *host=&d->players[side].monsters[index];if(!host->serial)host->serial=++d->next_serial;stat_links_cleanup(d);if(d->stat_link_count>=DUEL_STAT_LINK_MAX)return;
    DuelStatLink *l=&d->stat_links[d->stat_link_count++];clear(l,sizeof(*l));l->target=host->serial;l->kind=mode==0x6000?8:mode==0x4000&&additive?7:6;l->base_value=mode==0x6000?(payload&4095):(payload&8191)*(mode==0x8000?10:5);l->expires=d->turn;l->destroy_at_end=mode==0x8000;d->stat_snapshot_present|=l->kind==6?1:l->kind==7?2:4;
}
static void stat_limiter_end(Duel *d){
    for(unsigned side=0;side<2;++side)for(unsigned i=0;i<5;++i){const DuelSlot *m=&d->players[side].monsters[i];if(!m->card||duel_spell_immune(d,side,i))continue;unsigned marked=0;for(unsigned n=0;n<d->stat_link_count;++n){const DuelStatLink *l=&d->stat_links[n];marked|=l->kind==6&&l->destroy_at_end&&l->target==m->serial&&l->expires==d->turn;}if(marked){unsigned actor=d->effect_actor_plus1;d->effect_actor_plus1=side+1;destroy(d,side,i,0);d->effect_actor_plus1=actor;}}
}
static int stat_snapshot_target(const Duel *d,unsigned side,unsigned index){return side<2&&index<5&&duel_can_target_monster(d,side,index)&&d->players[side].monsters[index].position!=DUEL_FACEDOWN_DEFENSE;}
static int stat_snapshot_validate(const Duel *d,const DuelCommand *c,unsigned card){if(d->cards[card].name_group==1314){for(unsigned i=0;i<5;++i){const DuelSlot *s=&d->players[c->player].monsters[i];if(s->card&&s->position!=DUEL_FACEDOWN_DEFENSE&&duel_race(d,c->player,i)==7)return DUEL_OK;}return DUEL_NOT_ALLOWED;}if(!c->cost){unsigned count=0;for(unsigned side=0;side<2;++side)for(unsigned i=0;i<5;++i)count+=stat_snapshot_target(d,side,i);return count>=2?DUEL_OK:DUEL_NOT_ALLOWED;}return c->target_count==2&&c->targets[0]!=c->targets[1]&&stat_snapshot_target(d,c->targets[0]/5,c->targets[0]%5)&&stat_snapshot_target(d,c->targets[1]/5,c->targets[1]%5)?DUEL_OK:DUEL_BAD_TARGET;}
static void stat_snapshot_begin(Duel *d,const DuelCommand *c,unsigned card){d->equip_mode_command=*c;d->equip_mode_command.target_count=0;d->choice=(DuelTrigger){DUEL_CHOICE_STAT_SOURCE,c->player,card,0};}
static unsigned stat_snapshot_options(const Duel *d,DuelChoiceOption *options,unsigned capacity){unsigned n=0;for(unsigned side=0;side<2;++side)for(unsigned i=0;i<5;++i)if(stat_snapshot_target(d,side,i)&&(d->choice.kind!=DUEL_CHOICE_STAT_DESTINATION||d->equip_mode_command.targets[0]!=side*5+i)){if(options&&n<capacity)options[n]=(DuelChoiceOption){d->players[side].monsters[i].card,side*5+i,DUEL_OPTION_CARD};++n;}if(options&&n<capacity)options[n]=(DuelChoiceOption){0,DUEL_NO_SLOT,DUEL_OPTION_SKIP};return n+1;}
static int stat_snapshot_choose(Duel *d,unsigned token){if(token==DUEL_NO_SLOT){finish_choice(d);return DUEL_OK;}DuelCommand *saved=&d->equip_mode_command;saved->targets[saved->target_count++]=token;if(d->choice.kind==DUEL_CHOICE_STAT_SOURCE){d->choice.kind=DUEL_CHOICE_STAT_DESTINATION;return DUEL_OK;}DuelCommand c=*saved;c.cost=1;finish_choice(d);return activate(d,&c,c.action==DUEL_ACTION_ACTIVATE_BACKROW);}
static void stat_snapshot_resolve(Duel *d,const DuelChainLink *l){if(l->effect_negated)return;unsigned actor=l->command.player;if(d->cards[l->card].name_group==1314){for(unsigned i=0;i<5;++i){const DuelSlot *m=&d->players[actor].monsters[i];if(m->card&&m->position!=DUEL_FACEDOWN_DEFENSE&&duel_race(d,actor,i)==7)duel_stat_snapshot(d,actor,i,(duel_attack_value(d,actor,i)/5)|0x8000,0);}return;}if(l->target_count<2)return;for(unsigned n=0;n<2;++n){const DuelTarget *t=&l->targets[n];if(t->player>1||t->slot>=5||!duel_target_present(d,t->player,t->slot,t->serial)||d->players[t->player].monsters[t->slot].position==DUEL_FACEDOWN_DEFENSE)return;}const DuelTarget *a=&l->targets[0],*b=&l->targets[1];unsigned value=(((unsigned)duel_attack_value(d,a->player,a->slot)+1)/2)/5|0x4000;duel_stat_snapshot(d,a->player,a->slot,value,0);duel_stat_snapshot(d,b->player,b->slot,value,1);}
static int stat_snapshot_ai(const Duel *d,unsigned actor,unsigned card){DuelCommand c={0};c.player=actor;if(stat_snapshot_validate(d,&c,card)!=DUEL_OK)return 0;if(d->cards[card].name_group==1181){unsigned own=0,enemy=0;for(unsigned i=0;i<5;++i){own|=stat_snapshot_target(d,actor,i);enemy|=stat_snapshot_target(d,1-actor,i);}return own&&enemy;}const DuelWindow *w=&d->window;if(w->kind==DUEL_WINDOW_ATTACK&&w->player==actor)return 1;int power=0;for(unsigned i=0;i<5;++i){const DuelSlot *m=&d->players[actor].monsters[i];if(m->card&&m->position==DUEL_FACEUP_ATTACK&&duel_race(d,actor,i)==7)power+=duel_attack_value(d,actor,i)*2;}return power>=d->players[1-actor].life;}
