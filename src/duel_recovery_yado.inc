/* The original Recovery permits an empty hand but excludes foreign physical
 * cards, except its own activating copy. Yado returns each choice to bottom. */
static int recovery_validate(const Duel *d,const DuelCommand *c,unsigned source){unsigned actor=c->player;if(c->target_player!=actor||c->target>=5)return DUEL_BAD_TARGET;const DuelSlot *s=&d->players[actor].monsters[c->target];if(!s->card||s->owner!=actor||!duel_can_target_monster(d,actor,c->target)||!effect_affects_monster(d,source,actor,c->target))return DUEL_BAD_TARGET;for(unsigned i=0;i<d->players[actor].hand_count;++i)if(!(c->action==DUEL_ACTION_ACTIVATE_HAND&&i==c->source)&&pile_card_state(&d->players[actor],PILE_HAND,i).owner!=actor)return DUEL_NOT_ALLOWED;return DUEL_OK;}
static void recovery_resolve(Duel *d,const DuelChainLink *link){unsigned actor=link->command.player,index=link->command.target;DuelPlayer *p=&d->players[actor];if(link->effect_negated||link->command.target_player!=actor||index>=5)return;DuelSlot *s=&p->monsters[index];if(!s->card||s->serial!=link->target_serial||!effect_affects_monster(d,link->card,actor,index))return;DuelSlot old=*s;DuelCardState returned=card_state_reset(slot_card_state(&old));if(!put_pile_card(d,old.owner,PILE_DECK,returned,0))return;clear(s,sizeof(*s));detach_monster(d,old.serial,0);event(d,DUEL_EVENT_RETURN,actor,index,old.card,0);
    unsigned count=p->hand_count,foreign=0;while(p->hand_count){DuelCardState card=card_state_reset(take_pile_card(p,PILE_HAND,0));foreign|=card.owner!=actor;put_pile_card(d,card.owner,PILE_DECK,card,0);event(d,DUEL_EVENT_RETURN,actor,0,card.card,0);}shuffle(d,p);if(foreign)shuffle(d,&d->players[1-actor]);draw_cards(d,actor,count);
}
static void yado_begin(Duel *d,const DuelChainLink *link){if(!link->effect_negated&&d->players[link->command.player].hand_count)d->choice=(DuelTrigger){DUEL_CHOICE_YADO_HAND,link->command.player,link->card,link->source_serial};}
static unsigned yado_options(const Duel *d,DuelChoiceOption *options,unsigned capacity){const DuelPlayer *p=&d->players[d->choice.player];unsigned n=0;for(unsigned i=0;i<p->hand_count;++i){if(options&&n<capacity)options[n]=(DuelChoiceOption){p->hand[i],i,DUEL_OPTION_CARD};++n;}if(options&&n<capacity)options[n]=(DuelChoiceOption){0,DUEL_NO_SLOT,DUEL_OPTION_SKIP};return n+1;}
static void yado_choose(Duel *d,unsigned token){unsigned actor=d->choice.player;if(token==DUEL_NO_SLOT){finish_choice(d);return;}DuelCardState card=card_state_reset(take_pile_card(&d->players[actor],PILE_HAND,token));put_pile_card(d,card.owner,PILE_DECK,card,1);event(d,DUEL_EVENT_RETURN,actor,0,card.card,0);if(!d->players[actor].hand_count)finish_choice(d);}
