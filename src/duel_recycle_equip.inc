#include "duel_equip_grave_data.h"
static unsigned equip_grave_kind(const Duel *d,unsigned card){if(d->cards[card].effect!=DUEL_E_EQUIP&&d->cards[card].name_group!=1514)return 0;for(unsigned i=0;i<DUEL_EQUIP_GRAVE_COUNT;++i)if(equip_grave_rules[i].name==d->cards[card].name_group)return equip_grave_rules[i].op;return 0;}
static void equip_grave_trigger(Duel *d,unsigned owner,unsigned card,uint32_t serial){unsigned kind=equip_grave_kind(d,card);if(kind&&kind<5)queue_trigger(d,kind<=2?DUEL_TRIGGER_EQUIP_GRAVE:DUEL_CHOICE_EQUIP_RECYCLE,owner,card,serial);}
static unsigned equip_recycle_options(const Duel *d,DuelChoiceOption *options,unsigned capacity){unsigned side=d->choice.player,kind=equip_grave_kind(d,d->choice.card);const DuelPlayer *p=&d->players[side];if((kind<5&&p->deck_count>=DUEL_DECK_MAX)||grave_index(p,d->choice.serial)<0)return 0;unsigned n=0;if(kind>=5){if(empty_zone(p->backrow)<0)return 0;for(unsigned owner=0;owner<2;++owner)for(unsigned i=0;i<5;++i)if(duel_equip_can_target_for(d,side,d->choice.card,owner,i)){if(options&&n<capacity)options[n]=(DuelChoiceOption){d->players[owner].monsters[i].card,owner*5+i,DUEL_OPTION_CARD};++n;}}
    if(kind==3){if(p->life<=500)return 0;if(options&&capacity)options[0]=(DuelChoiceOption){d->choice.card,0,DUEL_OPTION_CONFIRM};n=1;}
    else if(kind==4){if(continuous_count(d,5))return 0;for(unsigned i=0;i<5;++i)if(p->monsters[i].card){if(options&&n<capacity)options[n]=(DuelChoiceOption){p->monsters[i].card,i,DUEL_OPTION_CARD};++n;}}
    if(!n)return 0;if(options&&n<capacity)options[n]=(DuelChoiceOption){0,DUEL_NO_SLOT,DUEL_OPTION_SKIP};return n+1;
}
static void equip_recycle_choose(Duel *d,unsigned index){unsigned side=d->choice.player,card=d->choice.card,kind=equip_grave_kind(d,card);uint32_t serial=d->choice.serial;if(index==DUEL_NO_SLOT){finish_choice(d);return;}
    if(kind==3){d->players[side].life-=500;event(d,DUEL_EVENT_DAMAGE,side,0,card,500);}else if(kind==4)leave_field(d,side,index,0,LEAVE_TRIBUTE);
    DuelChainLink *link=&d->chain[d->chain_count++];clear(link,sizeof(*link));link->card=card;link->command.player=side;link->source_serial=serial;if(kind>=5){link->command.target_player=index/5;link->command.target=index%5;DuelSlot *target=&d->players[index/5].monsters[index%5];if(!target->serial)target->serial=++d->next_serial;link->target_serial=target->serial;link->target_card=target->card;}link->speed=1;link->effect_activation=1;d->trigger_chain_pending=1;finish_choice(d);
}
static void equip_grave_resolve(Duel *d,const DuelChainLink *link){unsigned side=link->command.player,kind=equip_grave_kind(d,link->card);if(kind==1){damage(d,1-side,500);return;}DuelPlayer *p=&d->players[side];int index=grave_index(p,link->source_serial);if(kind>=5){unsigned owner=link->command.target_player,to=link->command.target;int free=empty_zone(p->backrow);if(index<0||p->grave[index]!=link->card||free<0||owner>1||to>=5||d->players[owner].monsters[to].serial!=link->target_serial||!duel_equip_can_target_for(d,side,link->card,owner,to))return;DuelCardState equipped=take_pile_card(p,PILE_GRAVE,index);unsigned card=equipped.card;equipped.history&=3;DuelSlot *source=&p->backrow[free];clear(source,sizeof(*source));source->card=card;source->owner=side;source->position=DUEL_FACEUP_ATTACK;slot_install_state(d,source,equipped);source_field_reveal(d,source);DuelChainLink attached=*link;attached.source_slot=free;attached.source_serial=source->serial;attach_equip(d,&attached);return;}if(!kind||index<0||p->grave[index]!=link->card||p->deck_count>=DUEL_DECK_MAX)return;DuelCardState returned=card_state_reset(take_pile_card(p,PILE_GRAVE,index));unsigned card=returned.card;put_pile_card(d,side,PILE_DECK,returned,0);event(d,DUEL_EVENT_RETURN,side,0,card,0);}
