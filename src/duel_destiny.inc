/* Destiny's five printed cards share one field-family lifecycle. Letter
 * placement is a transport, so it does not activate the Spirit Message. */
static const DuelSlot *destiny_zone(const DuelPlayer *p,unsigned index){return index==DUEL_FIELD_SLOT?&p->field:&p->backrow[index];}
static int destiny_family(const Duel *d,unsigned card){unsigned name=d->cards[card].name_group;return name==1528||(name>=1541&&name<=1544);}
static int destiny_board_live(const Duel *d,unsigned side){for(unsigned i=0;i<=DUEL_FIELD_SLOT;++i){const DuelSlot *s=destiny_zone(&d->players[side],i);if(s->card&&d->cards[s->card].name_group==1528&&s->effect_active&&s->position!=DUEL_FACEDOWN_DEFENSE&&!duel_field_effect_negated(d,s->card)&&!duel_card_prohibited(d,s->card,s->serial))return 1;}return 0;}
int duel_destiny_complete(const Duel *d,unsigned side){if(!d||side>1||!destiny_board_live(d,side))return 0;unsigned mask=0;for(unsigned i=0;i<=DUEL_FIELD_SLOT;++i){const DuelSlot *s=destiny_zone(&d->players[side],i);unsigned name=d->cards[s->card].name_group;if(s->card&&s->position!=DUEL_FACEDOWN_DEFENSE&&name>=1541&&name<=1544)mask|=1u<<(name-1541);}return mask==15;}
unsigned duel_destiny_departure_mask(const Duel *d,unsigned side,unsigned index,unsigned card){if(!d||side>1||index>DUEL_FIELD_SLOT||!card||!destiny_family(d,card)||!destiny_board_live(d,side))return 0;unsigned mask=0;for(unsigned i=0;i<=DUEL_FIELD_SLOT;++i){const DuelSlot *s=destiny_zone(&d->players[side],i);if(i!=index&&s->card&&s->position!=DUEL_FACEDOWN_DEFENSE&&destiny_family(d,s->card))mask|=1u<<i;}return mask;}
static void destiny_clear_departures(Duel *d,unsigned side,unsigned mask){unsigned actor=d->effect_actor_plus1;d->effect_actor_plus1=side+1;for(unsigned i=0;i<=DUEL_FIELD_SLOT;++i)if(mask&(1u<<i))destroy(d,side,i,1);d->effect_actor_plus1=actor;}
static int destiny_end_advance(Duel *d){if(!d->destiny_end_pending)return 0;unsigned side=1-d->destiny_end_actor;if(d->turn!=d->destiny_end_turn||d->active!=d->destiny_end_actor){d->destiny_end_pending=0;return 0;}while(d->destiny_end_cursor<5){unsigned i=d->destiny_end_cursor++;if(empty_zone(d->players[side].backrow)<0){d->destiny_end_pending=0;return 0;}const DuelSlot *s=&d->players[side].backrow[i];if(!s->card||d->cards[s->card].name_group!=1528||!s->effect_active||s->position==DUEL_FACEDOWN_DEFENSE||duel_field_effect_negated(d,s->card)||duel_card_prohibited(d,s->card,s->serial))continue;unsigned before=d->trigger_count;queue_trigger(d,DUEL_TRIGGER_CONTINUOUS,side,s->card,s->serial);if(d->trigger_count>before){d->triggers[before].selected_count=i;return 1;}}d->destiny_end_pending=0;return 0;}
void duel_destiny_end_queue(Duel *d,unsigned active){d->destiny_end_actor=active;d->destiny_end_turn=d->turn;d->destiny_end_cursor=0;d->destiny_end_pending=1;destiny_end_advance(d);}
void duel_destiny_resolve(Duel *d,const DuelChainLink *l){unsigned side=l->command.player;if(side>1||l->source_slot>DUEL_FIELD_SLOT||l->effect_negated)return;DuelPlayer *p=&d->players[side];DuelSlot *s=spell_zone(p,l->source_slot);if(s->card!=l->card)return;if(!l->effect_activation){s->control_used=0;return;}unsigned stage=s->control_used;if(stage>=4)return;unsigned wanted=1541+stage,kind=PILE_DECK;int found=-1;for(unsigned i=0;i<p->deck_count;++i)if(d->cards[p->deck[i]].name_group==wanted){found=i;break;}if(found<0){kind=PILE_HAND;for(unsigned i=0;i<p->hand_count;++i)if(d->cards[p->hand[i]].name_group==wanted){found=i;break;}}if(found<0)return;++s->control_used;int to=empty_zone(p->backrow);if(to>=0){DuelCardState state=take_pile_card(p,kind,found);DuelSlot *letter=&p->backrow[to];clear(letter,sizeof(*letter));slot_install_state(d,letter,state);letter->position=DUEL_FACEUP_ATTACK;letter->effect_active=1;letter->control_used=stage+1;source_field_reveal(d,letter);event(d,DUEL_EVENT_SPELL,side,to,state.card,0);}if(kind==PILE_DECK)shuffle(d,p);}
