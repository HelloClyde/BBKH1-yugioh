/* Only the original wrappers that call the shared interception participate.
 * Soul Exchange performs this test before flag4 and target UID validation;
 * the other wrappers require an effective link and the same field instance. */
int duel_big_shield_can_intercept(const Duel *d,unsigned owner,unsigned index){if(!d||owner>1||index>=5)return 0;const DuelSlot *s=&d->players[owner].monsters[index];return s->card&&d->cards[s->card].name_group==1201&&s->position==DUEL_FACEDOWN_DEFENSE;}
static int big_shield_intercept(Duel *d,const DuelChainLink *link){unsigned name=d->cards[link->card].name_group,owner=link->command.target_player,index=link->command.target;if(name!=1220){if(name!=319&&name!=1023&&name!=1211&&name!=1027&&name!=1157&&name!=1316&&name!=1319)return 0;if(link->effect_negated||duel_field_effect_negated(d,link->card)||owner>1||index>=5||(name==1027&&owner==link->command.player))return 0;const DuelSlot *s=&d->players[owner].monsters[index];if(!s->card||s->serial!=link->target_serial)return 0;}if(!duel_big_shield_can_intercept(d,owner,index))return 0;unsigned root=(unsigned)(link-d->chain);if(root<d->chain_count)d->chain[root].negated=d->chain[root].effect_negated=1;duel_change_monster_position(d,owner,index,DUEL_FACEUP_DEFENSE);return 1;}
static void big_shield_battle_begin(Duel *d,const DuelWindow *w){DuelSlot *s=&d->players[duel_battle_target_player(w)].monsters[w->target];if(d->cards[s->card].name_group==1201){if(s->position!=DUEL_FACEUP_ATTACK)s->control_used=1;if(s->control_used)d->guard_battle=(DuelTarget){s->serial,duel_battle_target_player(w),w->target};}}
static void big_shield_battle_end(Duel *d){const DuelTarget *t=&d->guard_battle;if(!t->serial||t->player>1||t->slot>=5)return;DuelSlot *s=&d->players[t->player].monsters[t->slot];if(!s->card||s->serial!=t->serial||d->cards[s->card].name_group!=1201||!s->control_used)return;s->control_used=0;if(s->position==DUEL_FACEUP_DEFENSE)duel_change_monster_position(d,t->player,t->slot,DUEL_FACEUP_ATTACK);else if(s->position==DUEL_FACEDOWN_DEFENSE)duel_change_monster_position(d,t->player,t->slot,DUEL_FACEDOWN_ATTACK);}
