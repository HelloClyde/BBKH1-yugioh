/* Both Field controllers expose the same fusion procedure to either actor.
 * The original revalidates the source coordinate/name, without a UID check. */
int duel_fusion_gate_available(const Duel *d,unsigned actor,unsigned source){if(!d||actor>1||source>1||d->active!=actor||!main_phase(d)||d->chain_count||d->response_player<2||d->choice.kind||d->discard_required)return 0;const DuelSlot *s=&d->players[source].field;return s->card&&d->cards[s->card].name_group==1547&&s->effect_active&&s->position!=DUEL_FACEDOWN_DEFENSE&&!activation_blocked_for_slot(d,s->card,s->serial)&&!duel_field_effect_negated(d,s->card)&&fusion_options(d,actor,0,0,DUEL_NO_SLOT);}
static int fusion_gate_activate(Duel *d,const DuelCommand *c){if(!duel_fusion_gate_available(d,c->player,c->source)||d->chain_count>=DUEL_CHAIN_MAX)return DUEL_NOT_ALLOWED;const DuelSlot *s=&d->players[c->source].field;DuelChainLink *l=&d->chain[d->chain_count++];clear(l,sizeof(*l));l->command=*c;l->card=s->card;l->source_slot=DUEL_FIELD_SLOT;l->source_serial=s->serial;l->speed=1;l->effect_activation=1;event(d,DUEL_EVENT_SPELL,c->player,DUEL_FIELD_SLOT,s->card,0);begin_response(d,1-c->player);return DUEL_OK;}
static int defusion_target(const Duel *d,unsigned side,unsigned index){if(side>1||index>=5)return 0;const DuelSlot *s=&d->players[side].monsters[index];const DuelCardDef *c=&d->cards[s->card];return s->card&&s->position!=DUEL_FACEDOWN_DEFENSE&&c->family==DUEL_MONSTER&&c->race<21&&c->subtype==2&&duel_can_target_monster(d,side,index);}
/* This legacy selector deliberately accepts material history from another
 * Fusion or Ritual. It selects oldest copies in reverse recipe order and
 * permits one substitution, rather than remembering this Fusion's materials. */
unsigned duel_defusion_materials(const Duel *d,unsigned side,unsigned card,uint32_t *selected){if(!d||side>1||!card_valid(d,card))return 0;const DuelFusionRecipe *r=fusion_recipe(d,card);if(!r)return 0;const DuelPlayer *p=&d->players[side];uint32_t used[3];unsigned n=0,substitute=0;for(unsigned k=r->count;k>0;--k){int found=-1;for(unsigned pass=0;pass<2&&found<0;++pass){if(pass&&substitute)break;for(unsigned i=0;i<p->grave_count;++i){unsigned material=p->grave[i];const DuelCardDef *c=&d->cards[material];if(!(p->grave_history[i]&3)||(duel_normal_prohibited[material]&&!p->grave_proper[i]))continue;unsigned duplicate=0;for(unsigned j=0;j<n;++j)duplicate|=used[j]==p->grave_serial[i];if(duplicate)continue;if(pass?c->effect==DUEL_E_FUSION_SUBSTITUTE:c->name_group==r->materials[k-1]){found=i;if(pass)substitute=1;break;}}}if(found>=0){used[n]=p->grave_serial[found];if(selected)selected[n]=used[n];++n;}}return n;}
static void defusion_resolve(Duel *d,const DuelChainLink *l){const DuelCommand *c=&l->command;if(!defusion_target(d,c->target_player,c->target))return;DuelSlot *s=&d->players[c->target_player].monsters[c->target];if(s->serial!=l->target_serial)return;unsigned fusion=s->card,proper=s->properly_summoned,owner=s->owner;DuelTarget t={s->serial,c->target_player,c->target};return_monster(d,&t);const DuelFusionRecipe *r=fusion_recipe(d,fusion);if(owner!=c->player||!proper||!r||!special_summon_allowed_for(d,c->player)||token_space(d,c->player)<r->count)return;uint32_t selected[3];if(duel_defusion_materials(d,c->player,fusion,selected)!=r->count)return;DuelPileSummonTask *task=&d->pile_summon_task;clear(task,sizeof(*task));task->spell=l->card;task->actor=task->chooser=c->player;task->kind=12;task->remaining=r->count;for(unsigned i=0;i<r->count;++i)task->instances[i]=selected[i];d->choice=(DuelTrigger){DUEL_CHOICE_DEFUSION,c->player,l->card,0};}
