/* DarkSpirit replaces the attacker without another declaration/cost or
 * consuming that Monster's ordinary attack. MagicArm keeps temporary control
 * even when the previous attacker can no longer continue the battle. */
#define BATTLE_FORCED_ATTACKER (1u<<28)
int duel_forced_attack_ready(const Duel *d,unsigned actor,unsigned name){if(!d||actor>1||(name!=1529&&name!=990))return 0;const DuelWindow *w=&d->window;if(w->kind!=DUEL_WINDOW_ATTACK||w->player==actor)return 0;return name==1529?duel_can_target_monster(d,w->player,w->source):monsters(&d->players[actor])&&empty_zone(d->players[actor].monsters)>=0;}
void duel_forced_battle(Duel *d,const DuelChainLink *l){unsigned actor=l->command.player,name=d->cards[l->card].name_group,side=l->command.target_player,index=l->command.target;if(l->effect_negated||actor>1||side>1||index>=5||l->target_count<2)return;DuelSlot *selected=&d->players[side].monsters[index];if(!selected->card||selected->serial!=l->target_serial||selected->position==DUEL_FACEDOWN_DEFENSE)return;DuelWindow *w=&d->window;if(w->kind!=DUEL_WINDOW_ATTACK)return;const DuelTarget *old=&l->targets[0],*defender=&l->targets[1];if(old->player>1||old->slot>=5||defender->player>1)return;
    if(name==1529){if(selected->position==DUEL_FACEUP_DEFENSE)duel_change_monster_position(d,side,index,DUEL_FACEUP_ATTACK);w->player=side;w->source=index;w->serial=selected->serial;w->card=selected->card;w->target=defender->slot;w->target_player_plus1=defender->player+1;w->target_serial=defender->slot<5?d->players[defender->player].monsters[defender->slot].serial:0;w->events|=BATTLE_REDIRECT_FORCED|BATTLE_REDIRECT_SEEN|BATTLE_FORCED_ATTACKER;w->negated=0;return;}
    if(name!=990||!duel_forced_attack_ready(d,actor,990)||!duel_battle_redirect_target(d,name,actor,w,side,index))return;uint32_t victim=selected->serial;if(!control_add(d,side,index,actor,l->card,0,0))return;control_reconcile(d);unsigned controlled,to;if(!control_find(d,victim,&controlled,&to)||controlled!=actor)return;DuelSlot *attacker=&d->players[old->player].monsters[old->slot];if(!attacker->card||attacker->attacked>duel_attack_limit(d,old->player,old->slot)||!combat_attack_position(d,attacker)||duel_card_prohibited(d,attacker->card,attacker->serial)||!continuous_attack_allowed(d,old->player,old->slot))return;w->player=old->player;w->source=old->slot;w->serial=attacker->serial;w->card=attacker->card;w->target=to;w->target_player_plus1=actor+1;w->target_serial=victim;w->events|=BATTLE_REDIRECT_FORCED|BATTLE_REDIRECT_SEEN;w->negated=0;
}
static void forced_control_battle_end(Duel *d){for(unsigned i=0;i<d->control_layer_count;)if(d->cards[d->control_layers[i].card].name_group==990)control_remove_layer(d,i);else ++i;control_reconcile(d);}
