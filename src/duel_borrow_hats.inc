static int borrow_mark(const Duel *d,unsigned actor,uint32_t serial){if(!serial)return -1;for(unsigned i=0;i<64;++i){const DuelRevivalJob *j=&d->revival_jobs[i];if(j->used&&j->kind==5&&j->actor==actor&&j->serial==serial&&j->due_turn>=d->turn)return i;}return -1;}
static void borrow_penalty(Duel *d,unsigned actor,uint32_t serial){if(borrow_mark(d,actor,serial)>=0)damage(d,actor,2000);}
static int borrow_candidate(const Duel *d,unsigned actor,unsigned index){return index<d->players[1-actor].grave_count&&d->cards[d->players[1-actor].grave[index]].family==DUEL_SPELL;}
static int borrow_validate(const Duel *d,const DuelCommand *c){if(d->players[c->player].hand_count>=DUEL_HAND_MAX||revival_job_space(d)>=64)return DUEL_NOT_ALLOWED;if(c->cost)return c->cost==1&&c->tributes&&borrow_candidate(d,c->player,c->tributes-1)?DUEL_OK:DUEL_BAD_TARGET;for(unsigned i=0;i<d->players[1-c->player].grave_count;++i)if(borrow_candidate(d,c->player,i))return DUEL_OK;return DUEL_NOT_ALLOWED;}
static void borrow_resolve(Duel *d,const DuelChainLink *l){unsigned actor=l->command.player;DuelCardState selected=l->grave_targets[0];if(!selected.card)return;int from=grave_index(&d->players[1-actor],selected.serial);if(from>=0&&d->players[actor].hand_count<DUEL_HAND_MAX){DuelCardState state=card_state_reset(take_pile_card(&d->players[1-actor],PILE_GRAVE,from));put_pile_card(d,actor,PILE_HAND,state,0);event(d,DUEL_EVENT_RETURN,actor,0,state.card,0);}/*575e80 accepts the not-found0, so the mark survives a failed move. */temporary_notice(d,5,actor,l->card,selected.serial,0);}
static void borrow_end(Duel *d){for(unsigned n=0;n<64;++n){DuelRevivalJob *j=&d->revival_jobs[n];if(!j->used||j->kind!=5||j->due_turn>d->turn)continue;unsigned actor=j->actor;int from=hand_selection_index(&d->players[actor],PILE_HAND,j->serial);if(from>=0){unsigned card=discard_hand_unpaid(d,actor,from,actor,0);event(d,DUEL_EVENT_PILE_DESTROY,actor,0,card,0);}for(unsigned i=0;i<6;++i){DuelSlot *s=spell_zone(&d->players[actor],i);if(s->card&&s->serial==j->serial&&s->position==DUEL_FACEDOWN_DEFENSE)leave_field(d,actor,i,1,LEAVE_SEND);}clear(j,sizeof(*j));}}
static int hats_target(const Duel *d,unsigned actor,unsigned index){if(index>=5)return 0;const DuelSlot *s=&d->players[actor].monsters[index];unsigned name=d->cards[s->card].name_group;return s->card&&!(name>=1920&&name<=1923)&&duel_can_target_monster(d,actor,index);}
static int hats_deck_card(const Duel *d,unsigned card){unsigned name=d->cards[card].name_group;return d->cards[card].family!=DUEL_MONSTER&&!(name>=1541&&name<=1544);}
static int hats_validate(const Duel *d,const DuelCommand *c){unsigned actor=c->player;if(c->action!=DUEL_ACTION_ACTIVATE_BACKROW||actor==d->active||d->phase!=DUEL_BATTLE||!special_summon_allowed_for(d,actor))return DUEL_NOT_ALLOWED;unsigned space=0,deck=0,target=0;for(unsigned i=0;i<5;++i){space+=!d->players[actor].monsters[i].card&&!d->players[actor].monsters[i].zone_blocked;target|=hats_target(d,actor,i);}for(unsigned i=0;i<d->players[actor].deck_count;++i)deck+=hats_deck_card(d,d->players[actor].deck[i]);return space>=2&&deck>=2&&target?DUEL_OK:DUEL_NOT_ALLOWED;}
static void hats_battle_end(Duel *d){unsigned mask=0;for(unsigned i=0;i<d->stat_link_count;++i){DuelStatLink *l=&d->stat_links[i];if(l->kind!=13)continue;for(unsigned side=0;side<2;++side)for(unsigned j=0;j<5;++j)if(d->players[side].monsters[j].card&&d->players[side].monsters[j].serial==l->target)mask|=1u<<(side*5+j);}if(mask){unsigned saved=d->effect_actor_plus1;d->effect_actor_plus1=2-d->active;destroy_monsters_mask(d,mask);d->effect_actor_plus1=saved;}}
static int borrow_hats_choice(unsigned k){return k>=DUEL_CHOICE_BORROW_TARGET&&k<=DUEL_CHOICE_HATS_DECK;}
static unsigned borrow_hats_options(const Duel *d,DuelChoiceOption *options,unsigned capacity){unsigned actor=d->choice.player,k=d->choice.kind,n=0;const DuelPlayer *p=&d->players[k==DUEL_CHOICE_BORROW_TARGET?1-actor:actor];unsigned total=k==DUEL_CHOICE_HATS_TARGET?5:k==DUEL_CHOICE_HATS_DECK?p->deck_count:p->grave_count;for(unsigned i=0;i<total;++i){if(k==DUEL_CHOICE_HATS_TARGET?!hats_target(d,actor,i):k==DUEL_CHOICE_BORROW_TARGET?!borrow_candidate(d,actor,i):!hats_deck_card(d,p->deck[i])||(d->choice.selected_count&&pile_card_state(p,PILE_DECK,i).serial==d->choice_targets[1].serial))continue;unsigned card=k==DUEL_CHOICE_HATS_TARGET?p->monsters[i].card:k==DUEL_CHOICE_HATS_DECK?p->deck[i]:p->grave[i];if(options&&n<capacity)options[n]=(DuelChoiceOption){card,i,DUEL_OPTION_CARD};++n;}return n;}
static void hats_begin(Duel *d,const DuelChainLink *l){DuelCommand c=l->command;c.action=DUEL_ACTION_ACTIVATE_BACKROW;if(hats_validate(d,&c)!=DUEL_OK)return;d->choice=(DuelTrigger){DUEL_CHOICE_HATS_TARGET,c.player,l->card,l->source_serial};}
static int borrow_hats_choose(Duel *d,unsigned token){unsigned k=d->choice.kind,actor=d->choice.player;if(k==DUEL_CHOICE_BORROW_TARGET){DuelCommand c=d->equip_mode_command;finish_choice(d);c.cost=1;c.tributes=token+1;return activate(d,&c,c.action==DUEL_ACTION_ACTIVATE_BACKROW);}
    if(k==DUEL_CHOICE_HATS_TARGET){DuelSlot *s=&d->players[actor].monsters[token];if(!s->serial)s->serial=++d->next_serial;d->choice_targets[0]=(DuelTarget){s->serial,actor,token};d->choice.kind=DUEL_CHOICE_HATS_DECK;return DUEL_OK;}
    DuelCardState state=hand_selection_identify(d,actor,PILE_DECK,token);d->choice_targets[1+d->choice.selected_count++]=(DuelTarget){state.serial,actor,token};if(d->choice.selected_count<2)return DUEL_OK;DuelTarget selected[3];for(unsigned i=0;i<3;++i)selected[i]=d->choice_targets[i];unsigned card=d->choice.card;finish_choice(d);if(!duel_target_present(d,actor,selected[0].slot,selected[0].serial))return DUEL_OK;
    duel_change_monster_position(d,actor,selected[0].slot,live_backrow_name(d,1151,3)?DUEL_FACEUP_DEFENSE:DUEL_FACEDOWN_DEFENSE);unsigned positions[3]={selected[0].slot,0,0};
    for(unsigned n=0;n<2;++n){DuelPlayer *p=&d->players[actor];int from=hand_selection_index(p,PILE_DECK,selected[n+1].serial);if(from<0)continue;DuelCardState summoned=take_pile_card(p,PILE_DECK,from);int to=excavation_install(d,actor,summoned,DUEL_FACEDOWN_DEFENSE);if(to<0){put_pile_card(d,actor,PILE_DECK,summoned,0);continue;}positions[n+1]=to;stat_links_cleanup(d);if(d->stat_link_count<DUEL_STAT_LINK_MAX){d->stat_links[d->stat_link_count++]=(DuelStatLink){summoned.serial,summoned.serial,13};d->stat_snapshot_present|=128;}}
    for(unsigned n=2;n>0;--n){unsigned j=random_next(d)%(n+1);DuelSlot temp=d->players[actor].monsters[positions[n]];d->players[actor].monsters[positions[n]]=d->players[actor].monsters[positions[j]];d->players[actor].monsters[positions[j]]=temp;}shuffle(d,&d->players[actor]);event(d,DUEL_EVENT_REMODEL,actor,0,card,3);return DUEL_OK;
}
