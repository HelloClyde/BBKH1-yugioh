/* Excavation adds cards without drawing them. Parasite marks follow one
 * physical instance; they are independent of its current pile or controller. */
static int excavation_only_special(const DuelCardDef *c){unsigned n=c->name_group;return c->family==DUEL_MONSTER&&(c->subtype>=2||n==55||n==56||n==62||n==66||n==368||n==373||n==391||n==741||n==845||n==1202||n==1257||n>=726&&n<=728||n==766||n>=1514&&n<=1519);}
static int chosen_monster(const Duel *d,unsigned actor,unsigned card){const DuelCardDef *c=&d->cards[card];return c->family==DUEL_MONSTER&&(!excavation_only_special(c)||toon_card(c)&&toon_world_present(d,actor));}
static int chosen_ready(const Duel *d,unsigned actor,unsigned from_hand){if(empty_zone(d->players[actor].monsters)<0||!special_summon_allowed_for(d,actor))return 0;unsigned non=0,mon=0;const DuelPlayer *p=&d->players[actor];for(unsigned i=0;i<p->hand_count;++i)if(d->cards[p->hand[i]].family==DUEL_MONSTER)mon+=chosen_monster(d,actor,p->hand[i]);else ++non;return mon&&non>=2+from_hand;}
static int parasite_mark(const Duel *d,unsigned side,uint32_t serial){if(!serial)return -1;for(unsigned i=0;i<64;++i){const DuelRevivalJob *j=&d->revival_jobs[i];if(j->used&&j->kind==4&&j->actor==side&&j->serial==serial)return i;}return -1;}
static int excavation_install(Duel *d,unsigned side,DuelCardState state,unsigned position){int index=empty_zone(d->players[side].monsters);if(index<0)return -1;DuelSlot *s=&d->players[side].monsters[index];clear(s,sizeof(*s));slot_install_state(d,s,state);s->position=position==DUEL_FACEDOWN_DEFENSE&&live_backrow_name(d,1151,3)?DUEL_FACEUP_DEFENSE:position;s->summoned_turn=s->set_turn=d->turn;s->return_controller=DUEL_NO_SLOT;special_summon_success(d,side,index);if(!d->battle_pending)d->summon_notice=(DuelWindow){DUEL_WINDOW_SUMMON,side,index,0,s->serial,0,state.card,0,2};event(d,DUEL_EVENT_REVIVE,side,index,state.card,0);return index;}
static void parasite_draw(Duel *d,unsigned side,unsigned index){DuelPlayer *p=&d->players[side];if(index>=p->hand_count||d->cards[p->hand[index]].name_group!=762)return;DuelCardState state=pile_card_state(p,PILE_HAND,index);int mark=parasite_mark(d,side,state.serial);if(mark<0)return;clear(&d->revival_jobs[mark],sizeof(DuelRevivalJob));if(live_backrow_name(d,1530,3)||activation_blocked_for_slot(d,state.card,state.serial))return;queue_trigger(d,DUEL_TRIGGER_PARASITE_DRAW,side,state.card,state.serial);}
static void parasite_resolve(Duel *d,const DuelChainLink *l){unsigned actor=l->command.player;if(l->command.cost==2){DuelPlayer *p=&d->players[actor];int from=hand_selection_index(p,PILE_HAND,l->source_serial);if(from<0)return;if(empty_zone(p->monsters)<0||!special_summon_allowed_for(d,actor)){DuelCardState dead=take_pile_card(p,PILE_HAND,from);dead.history=DUEL_HISTORY_ARRIVED;grave_card_state(d,dead.owner,dead);event(d,DUEL_EVENT_PILE_DESTROY,actor,from,dead.card,0);return;}DuelCardState state=take_pile_card(p,PILE_HAND,from);int to=excavation_install(d,actor,state,DUEL_FACEUP_DEFENSE);if(to<0)return;stat_links_cleanup(d);if(d->stat_link_count<DUEL_STAT_LINK_MAX){uint32_t order=++d->next_field_order;for(unsigned side=0;side<2;++side)for(unsigned i=0;i<5;++i)if(source_field_order(&d->players[side].backrow[i])>=order)order=source_field_order(&d->players[side].backrow[i])+1;d->next_field_order=order;d->stat_links[d->stat_link_count++]=(DuelStatLink){state.serial,state.serial,12,(int32_t)order,(int32_t)actor+1};d->stat_snapshot_present|=64;}damage(d,actor,1000);return;}
    unsigned index=l->source_slot;if(index>=5)return;DuelSlot *s=&d->players[actor].monsters[index];if(!s->card||s->card!=l->card||s->position==DUEL_FACEDOWN_DEFENSE||d->players[1-actor].deck_count>=DUEL_DECK_MAX)return;DuelCardState state=card_state_reset(slot_card_state(s));clear(s,sizeof(*s));detach_monster(d,state.serial,0);put_pile_card(d,1-actor,PILE_DECK,state,0);temporary_notice(d,4,1-actor,l->card,state.serial,0);shuffle(d,&d->players[1-actor]);event(d,DUEL_EVENT_RETURN,actor,index,state.card,0);
}
static void cyber_step(Duel *d){DuelExcavationTask *t=&d->excavation_task;while(t->active&&d->winner<0){if(t->round>=2){t->active=0;event(d,DUEL_EVENT_REMODEL,t->actor,0,t->source,0);return;}unsigned side=t->actor^t->round;DuelPlayer *p=&d->players[side];if(!t->left||!p->deck_count){++t->round;t->left=5;continue;}--t->left;unsigned at=d->remodel.revealed[side]++;DuelCardState state=card_state_identify(d,pile_card_state(p,PILE_DECK,p->deck_count-1));p->deck_state[p->deck_count-1]=state;d->remodel.cards[side][at]=state.card;const DuelCardDef *c=&d->cards[state.card];
        if(c->family==DUEL_MONSTER&&c->level<5&&!excavation_only_special(c)){unsigned owner=state.owner;if(t->permission[owner]&&empty_zone(d->players[owner].monsters)>=0){t->pending=state;t->report_side=side;t->report_index=at;d->choice=(DuelTrigger){DUEL_CHOICE_CYBER_POSITION,owner,state.card,state.serial};return;}grave_deck_state(d,side,take_pile_card(p,PILE_DECK,p->deck_count-1),t->actor,1);}else {put_pile_card(d,side,PILE_HAND,take_pile_card(p,PILE_DECK,p->deck_count-1),0);event(d,DUEL_EVENT_RETURN,side,0,state.card,0);}
    }}
static void cyber_begin(Duel *d,const DuelChainLink *l){destroy_monsters_mask(d,0x3ff);if(d->battle_pending){for(unsigned i=0;i<d->battle_destroy_count;++i){const DuelTarget *target=&d->battle_destroy[i];DuelSlot *s=&d->players[target->player].monsters[target->slot];if(s->card&&s->serial==target->serial)leave_field(d,target->player,target->slot,0,LEAVE_SEND);}d->battle_destroy_count=0;}uint32_t seq=d->remodel.sequence+1;clear(&d->remodel,sizeof(d->remodel));d->remodel.sequence=seq;d->remodel.source_card=l->card;clear(&d->excavation_task,sizeof(d->excavation_task));DuelExcavationTask *t=&d->excavation_task;t->source=l->card;t->actor=d->active;t->active=1;t->left=5;for(unsigned i=0;i<2;++i)t->permission[i]=special_summon_allowed_for(d,i);cyber_step(d);}
static int excavation_choice(unsigned kind){return kind>=DUEL_CHOICE_CHOSEN_MONSTER&&kind<=DUEL_CHOICE_DRILL_OFFER;}
static unsigned excavation_options(const Duel *d,DuelChoiceOption *options,unsigned capacity){unsigned k=d->choice.kind,actor=d->choice.serial-1,n=0;if(k==DUEL_CHOICE_CYBER_POSITION||k==DUEL_CHOICE_CHOSEN_POSITION){for(unsigned i=0;i<2;++i)if(options&&i<capacity)options[i]=(DuelChoiceOption){d->choice.card,i,DUEL_OPTION_CONFIRM};return 2;}if(k==DUEL_CHOICE_DRILL_OFFER){if(options&&capacity)options[0]=(DuelChoiceOption){d->choice.card,0,DUEL_OPTION_CONFIRM};if(options&&capacity>1)options[1]=(DuelChoiceOption){0,DUEL_NO_SLOT,DUEL_OPTION_SKIP};return 2;}if(k==DUEL_CHOICE_CHOSEN_BLIND){for(unsigned i=0;i<3;++i)if(options&&i<capacity)options[i]=(DuelChoiceOption){0,i,DUEL_OPTION_CARD};return 3;}
    const DuelPlayer *p=&d->players[actor];for(unsigned i=0;i<p->hand_count;++i){if(k==DUEL_CHOICE_CHOSEN_MONSTER?!chosen_monster(d,actor,p->hand[i]):d->cards[p->hand[i]].family==DUEL_MONSTER)continue;unsigned used=0;for(unsigned j=0;j<d->choice.selected_count;++j)used|=pile_card_state(p,PILE_HAND,i).serial&&pile_card_state(p,PILE_HAND,i).serial==d->choice_targets[j].serial;if(used)continue;if(options&&n<capacity)options[n]=(DuelChoiceOption){p->hand[i],i,DUEL_OPTION_CARD};++n;}return n;
}
static void chosen_begin(Duel *d,const DuelChainLink *l){if(chosen_ready(d,l->command.player,0))d->choice=(DuelTrigger){DUEL_CHOICE_CHOSEN_MONSTER,l->command.player,l->card,l->command.player+1};}
static void drill_begin(Duel *d,unsigned actor,unsigned card){const DuelPlayer *p=&d->players[actor];for(unsigned i=0;i<p->deck_count;++i)if(d->cards[p->deck[i]].name_group==762&&parasite_mark(d,actor,pile_card_state(p,PILE_DECK,i).serial)<0){d->choice=(DuelTrigger){DUEL_CHOICE_DRILL_OFFER,actor,card,0};return;}}
static void excavation_choose(Duel *d,unsigned token){unsigned k=d->choice.kind;if(k==DUEL_CHOICE_CYBER_POSITION){DuelExcavationTask *t=&d->excavation_task;unsigned side=t->report_side,owner=t->pending.owner;DuelPlayer *p=&d->players[side];int from=hand_selection_index(p,PILE_DECK,t->pending.serial);finish_choice(d);if(from>=0){DuelCardState state=take_pile_card(p,PILE_DECK,from);int to=excavation_install(d,owner,state,token?DUEL_FACEDOWN_DEFENSE:DUEL_FACEUP_ATTACK);if(to>=0){d->remodel.deployed[side][t->report_index]=to+1;++d->remodel.summoned[owner];}else grave_deck_state(d,side,state,t->actor,1);}continuous_cleanup(d);control_reconcile(d);cyber_step(d);return;}
    if(k==DUEL_CHOICE_DRILL_OFFER){unsigned side=d->choice.player;finish_choice(d);if(token==DUEL_NO_SLOT)return;DuelPlayer *p=&d->players[side];int from=-1;for(unsigned i=p->deck_count;i>0;--i)if(d->cards[p->deck[i-1]].name_group==762&&parasite_mark(d,side,pile_card_state(p,PILE_DECK,i-1).serial)<0){from=i-1;break;}if(from>=0){DuelCardState state=take_pile_card(p,PILE_DECK,from);shuffle(d,p);put_pile_card(d,side,PILE_DECK,state,0);event(d,DUEL_EVENT_RETURN,side,0,state.card,0);}return;}
    unsigned actor=d->choice.serial-1;DuelPlayer *p=&d->players[actor];if(k==DUEL_CHOICE_CHOSEN_POSITION){int from=hand_selection_index(p,PILE_HAND,d->excavation_task.pending.serial);if(from<0){finish_choice(d);return;}DuelCardState state=take_pile_card(p,PILE_HAND,from);finish_choice(d);excavation_install(d,actor,state,token?DUEL_FACEDOWN_DEFENSE:DUEL_FACEUP_ATTACK);return;}
    if(k!=DUEL_CHOICE_CHOSEN_BLIND){DuelCardState state=hand_selection_identify(d,actor,PILE_HAND,token);d->choice_targets[d->choice.selected_count++]=(DuelTarget){state.serial,actor,token};d->choice.kind=DUEL_CHOICE_CHOSEN_NONMONSTER;if(d->choice.selected_count==3){for(unsigned i=2;i>0;--i){unsigned j=random_next(d)%(i+1);DuelTarget tmp=d->choice_targets[i];d->choice_targets[i]=d->choice_targets[j];d->choice_targets[j]=tmp;}d->choice.kind=DUEL_CHOICE_CHOSEN_BLIND;d->choice.player=1-actor;}return;}
    uint32_t kept=d->choice_targets[token].serial;for(unsigned i=0;i<3;++i)if(i!=token){int from=hand_selection_index(p,PILE_HAND,d->choice_targets[i].serial);if(from>=0)send_hand_effect(d,actor,from,actor,0);}int from=hand_selection_index(p,PILE_HAND,kept);if(from<0){finish_choice(d);return;}if(d->cards[p->hand[from]].family!=DUEL_MONSTER){send_hand_effect(d,actor,from,actor,0);finish_choice(d);return;}d->excavation_task.pending=pile_card_state(p,PILE_HAND,from);d->choice.kind=DUEL_CHOICE_CHOSEN_POSITION;d->choice.card=d->excavation_task.pending.card;d->choice.player=actor;
}
