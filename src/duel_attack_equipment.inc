static int attack_equipment_name(unsigned name){return name==735||name==1170;}
static int attack_equipment_begin(Duel *d,const DuelWindow *w){DuelSlot *s=&d->players[duel_battle_target_player(w)].monsters[w->target];if(!attack_equipment_name(d->cards[s->card].name_group)||s->position!=DUEL_FACEDOWN_DEFENSE||s->facedown_attack||activation_blocked_for_slot(d,s->card,s->serial)||d->chain_count>=DUEL_CHAIN_MAX)return 0;detach_monster(d,s->serial,0);s->position=DUEL_FACEUP_DEFENSE;DuelChainLink *l=&d->chain[d->chain_count++];clear(l,sizeof(*l));l->card=s->card;l->source_serial=s->serial;l->source_slot=w->target;l->command.player=duel_battle_target_player(w);l->command.target_player=w->player;l->command.target=w->source;l->target_serial=w->serial;l->effect_activation=l->speed=1;clear(&d->window,sizeof(d->window));damage_state_clear(d);begin_response(d,w->player);return 1;}
static void attack_equipment_resolve(Duel *d,const DuelChainLink *l){unsigned side=l->command.player,index=l->source_slot;DuelPlayer *p=&d->players[side];if(index>=5)return;DuelSlot *s=&p->monsters[index];if(!s->card||s->serial!=l->source_serial||s->card!=l->card)return;int to=empty_zone(p->backrow);if(to<0){destroy(d,side,index,0);return;}DuelCardState state=slot_card_state(s);clear(s,sizeof(*s));detach_monster(d,state.serial,0);DuelSlot *source=&p->backrow[to];clear(source,sizeof(*source));slot_install_state(d,source,state);source->position=DUEL_FACEUP_ATTACK;source->effect_active=1;source_field_reveal(d,source);unsigned host_side=l->command.target_player,host_index=l->command.target;if(host_side<2&&host_index<5){DuelSlot *host=&d->players[host_side].monsters[host_index];if(host->card){if(!host->serial)host->serial=++d->next_serial;source->link_serial=host->serial;equipment_order_attach(d,source,host);}}event(d,DUEL_EVENT_SPELL,side,to,state.card,0);}
/* The original Standby table processes Kiseitai before Blast Sphere. Blast
 * damages the opposite source-controller seat even after a reassignment. */
static void attack_equipment_standby(Duel *d,unsigned active){unsigned side=1-active;DuelPlayer *p=&d->players[side];for(unsigned kind=0;kind<2&&d->winner<0;++kind)for(unsigned i=0;i<5&&d->winner<0;++i){DuelSlot *s=&p->backrow[i];unsigned name=s->card?d->cards[s->card].name_group:0;if(name!=(kind?735:1170)||!s->effect_active||s->position==DUEL_FACEDOWN_DEFENSE||equip_effect_negated(d,s->card)||(kind&&s->control_used))continue;unsigned host_side,host_index;if(!equip_host(d,s->card,s->link_serial,&host_side,&host_index))continue;unsigned power=duel_attack_value(d,host_side,host_index);if(!kind)recover(d,side,(power+1)/2,s->card);else if(duel_spell_immune(d,host_side,host_index))destroy(d,side,i,1);else{unsigned actor=d->effect_actor_plus1;d->effect_actor_plus1=side+1;destroy(d,host_side,host_index,0);d->effect_actor_plus1=actor;damage(d,active,power);}}}
