/* Persistent continuous modifiers use source and target instances. A field
 * coordinate can be reused without inheriting a departed card's modifiers. */
static void stat_links_cleanup(Duel *d);
static const DuelSlot *stat_link_source(const Duel *d,const DuelStatLink *link){if(link->kind==9||link->kind==10||link->kind==11||link->kind==12||link->kind==13){for(unsigned p=0;p<2;++p)for(unsigned i=0;i<5;++i){const DuelSlot *s=&d->players[p].monsters[i];if(s->card&&s->serial==link->source)return s;}return 0;}for(unsigned p=0;p<2;++p)for(unsigned i=0;i<=DUEL_FIELD_SLOT;++i){const DuelSlot *s=i==DUEL_FIELD_SLOT?&d->players[p].field:&d->players[p].backrow[i];if(s->card&&s->serial==link->source)return s;}return 0;}
static int stat_source_after(const Duel *d,uint32_t source,uint32_t target,unsigned kind,int after){for(unsigned i=after+1;i<d->stat_link_count;++i){const DuelStatLink *l=&d->stat_links[i];if(l->kind==kind&&l->source==source&&l->target==target)return 1;}return 0;}
static int fairy_last_reset(const Duel *d,unsigned side,unsigned index){if(!(d->field_name_cache&128)&&!(d->stat_snapshot_present&1))return -1;const DuelSlot *target=&d->players[side].monsters[index];if(!target->card||target->position==DUEL_FACEDOWN_DEFENSE)return -1;int latest=-1;for(unsigned i=0;i<d->stat_link_count;++i){const DuelStatLink *l=&d->stat_links[i];if(l->target!=target->serial)continue;if((l->kind==6||l->kind==14)&&l->expires>=d->turn){latest=i;continue;}if(l->kind!=3)continue;const DuelSlot *source=stat_link_source(d,l);if(source&&d->cards[source->card].name_group==1424&&(source->position==DUEL_FACEDOWN_DEFENSE||!duel_field_effect_negated(d,source->card))&&!duel_card_prohibited(d,source->card,source->serial))latest=i;}return latest;}
static void fairy_stat_delta(Duel *d,const DuelSlot *target,int amount){if(!(d->field_name_cache&128)&&!(d->stat_snapshot_present&1))return;for(unsigned i=0;i<d->stat_link_count;++i)if((d->stat_links[i].kind==3||d->stat_links[i].kind==6||d->stat_links[i].kind==14)&&d->stat_links[i].target==target->serial)d->stat_links[i].attack_after+=amount;}
void duel_fairy_reset_attack(Duel *d,unsigned actor,unsigned source_index,unsigned side,unsigned index){if(!d||actor>1||source_index>=5||side>1||index>=5)return;DuelSlot *source=&d->players[actor].backrow[source_index],*target=&d->players[side].monsters[index];if(!source->card||d->cards[source->card].name_group!=1424||!target->card)return;if(!source->serial)source->serial=++d->next_serial;if(!target->serial)target->serial=++d->next_serial;stat_links_cleanup(d);for(unsigned i=0;i<d->stat_link_count;++i)if(d->stat_links[i].kind==3&&d->stat_links[i].source==source->serial&&d->stat_links[i].target==target->serial){for(unsigned j=i;j+1<d->stat_link_count;++j)d->stat_links[j]=d->stat_links[j+1];--d->stat_link_count;break;}if(d->stat_link_count<DUEL_STAT_LINK_MAX)d->stat_links[d->stat_link_count++]=(DuelStatLink){source->serial,target->serial,3,0};d->field_name_cache|=128;}
static void fairy_target_hidden(Duel *d,uint32_t serial){for(unsigned i=0;i<d->stat_link_count;++i)if((d->stat_links[i].kind==3||d->stat_links[i].kind>=6&&d->stat_links[i].kind<=8||d->stat_links[i].kind==10||d->stat_links[i].kind==11||d->stat_links[i].kind==14||d->stat_links[i].kind==15)&&d->stat_links[i].target==serial||d->stat_links[i].kind==11&&d->stat_links[i].source==serial)clear(&d->stat_links[i],sizeof(DuelStatLink));}
static void fairy_battle_phase_end(Duel *d){for(unsigned i=0;i<d->stat_link_count;)if(d->stat_links[i].kind==3){for(unsigned j=i;j+1<d->stat_link_count;++j)d->stat_links[j]=d->stat_links[j+1];clear(&d->stat_links[--d->stat_link_count],sizeof(DuelStatLink));}else ++i;}
static void stat_field_attach(Duel *d,const DuelSlot *source){stat_links_cleanup(d);for(unsigned side=0;side<2;++side)for(unsigned i=0;i<5;++i){DuelSlot *host=&d->players[side].monsters[i];if(!host->card)continue;if(!host->serial)host->serial=++d->next_serial;if(d->stat_link_count<DUEL_STAT_LINK_MAX)d->stat_links[d->stat_link_count++]=(DuelStatLink){source->serial,host->serial,4,0};}}
static void stat_link_clear_target(Duel *d,uint32_t serial){for(unsigned i=0;i<d->stat_link_count;++i)if(d->stat_links[i].target==serial)clear(&d->stat_links[i],sizeof(d->stat_links[i]));}
static void mirror_attach(Duel *d,unsigned side,unsigned index){stat_links_cleanup(d);DuelSlot *target=&d->players[side].monsters[index];if(!target->card||target->position==DUEL_FACEDOWN_DEFENSE)return;if(!target->serial)target->serial=++d->next_serial;
    for(unsigned i=0;i<5;++i){DuelSlot *source=&d->players[1-side].backrow[i];if(!source->card||!source->effect_active||source->position==DUEL_FACEDOWN_DEFENSE||d->cards[source->card].name_group!=1099||duel_field_effect_negated(d,source->card))continue;if(!source->serial)source->serial=++d->next_serial;unsigned exists=0;int free=-1;for(unsigned n=0;n<d->stat_link_count;++n){DuelStatLink *l=&d->stat_links[n];exists|=l->source==source->serial&&l->target==target->serial;if(!l->kind&&free<0)free=n;}if(!exists&&free<0&&d->stat_link_count<DUEL_STAT_LINK_MAX)free=d->stat_link_count++;if(!exists&&free>=0)d->stat_links[free]=(DuelStatLink){source->serial,target->serial,1};}}
static int final_attack_modifiers(const Duel *d,unsigned side,unsigned index,int value){const DuelSlot *target=&d->players[side].monsters[index];int reset=fairy_last_reset(d,side,index);if(reset>=0){unsigned swapped=target->swap_until==d->turn&&target->swap_parity;int base=swapped?equipment_original_stat(d,side,index,1):equipment_original_stat_since(d,side,index,0,reset);int bonus=castle_bonus_since(d,side,index,reset)+d->stat_links[reset].attack_after+equip_bonus_since(d,side,index,0,reset)+field_bonus_since(d,side,index,0,reset)+binding_stat_bonus_since(d,side,index,reset);value=base+(d->reverse_turn==d->turn?-bonus:bonus);}if(value<0)value=0;if(target->position==DUEL_FACEDOWN_DEFENSE)return value;for(unsigned n=0;n<d->stat_link_count;++n){const DuelStatLink *l=&d->stat_links[n];if(l->kind!=1||l->target!=target->serial)continue;const DuelSlot *s=stat_link_source(d,l);if(s&&s->effect_active&&s->position!=DUEL_FACEDOWN_DEFENSE&&!duel_field_effect_negated(d,s->card))value=(value+1)/2;}return value;}
static int original_stat(const Duel *d,unsigned side,unsigned index,unsigned defense){const DuelSlot *s=&d->players[side].monsters[index];if(s->swap_until==d->turn&&s->swap_parity&&s->position!=DUEL_FACEDOWN_DEFENSE)defense=!defense;return equipment_original_stat(d,side,index,defense);}

/* Goddess consumes earlier ATK channels at its ordered status position.
 * Later base assignments and bonuses continue independently. */
static int goddess_ordered_bonus(const Duel *d,unsigned side,unsigned index,int after){return castle_bonus_since(d,side,index,after)+equip_bonus_since(d,side,index,0,after)+field_bonus_since(d,side,index,0,after)+binding_stat_bonus_since(d,side,index,after);}
static int goddess_base(const Duel *d,unsigned side,unsigned index,unsigned at){const DuelSlot *host=&d->players[side].monsters[index];const DuelStatLink *op=&d->stat_links[at];int previous=-1;for(unsigned n=0;n<at;++n){const DuelStatLink *l=&d->stat_links[n];if(l->target!=host->serial)continue;if((l->kind==6||l->kind==14)&&l->expires>=d->turn)previous=n;else if(l->kind==3){const DuelSlot *s=stat_link_source(d,l);if(s&&d->cards[s->card].name_group==1424&&(s->position==DUEL_FACEDOWN_DEFENSE||!duel_field_effect_negated(d,s->card))&&!duel_card_prohibited(d,s->card,s->serial))previous=n;}}int base=equipment_original_stat_range(d,side,index,0,previous,at);int bonus=goddess_ordered_bonus(d,side,index,previous)-goddess_ordered_bonus(d,side,index,(int)at-1);bonus+=(previous<0?goddess_unordered_bonus(d,side,index):d->stat_links[previous].attack_after)-op->attack_after;int prefix=base+bonus;return op->base_value?prefix*2:(prefix*5+5)/10;}
static void ignition_stat_mark(Duel *d,DuelSlot *source,unsigned op,unsigned success){if(!source->serial)source->serial=++d->next_serial;stat_links_cleanup(d);if(d->stat_link_count>=DUEL_STAT_LINK_MAX)return;DuelStatLink *l=&d->stat_links[d->stat_link_count++];clear(l,sizeof(*l));l->target=source->serial;l->kind=op==6?14:15;l->base_value=success;l->expires=d->turn;d->stat_snapshot_present|=1;}

static void stat_links_cleanup(Duel *d){d->stat_snapshot_present=0;for(unsigned n=0;n<d->stat_link_count;++n){DuelStatLink *l=&d->stat_links[n];unsigned exists=0;for(unsigned p=0;p<2;++p)for(unsigned i=0;i<5;++i)exists|=d->players[p].monsters[i].card&&d->players[p].monsters[i].serial==l->target;if(!exists||((l->kind>=6&&l->kind<=8||l->kind==14||l->kind==15)?l->expires&&l->expires<d->turn:!l->source||!stat_link_source(d,l))){for(unsigned j=n;j+1<d->stat_link_count;++j)d->stat_links[j]=d->stat_links[j+1];clear(&d->stat_links[--d->stat_link_count],sizeof(*l));--n;}else if(l->kind==14||l->kind==15)d->stat_snapshot_present|=1;else if(l->kind>=6&&l->kind<=8)d->stat_snapshot_present|=l->kind==6?1:l->kind==7?2:4;else if(l->kind==9)d->stat_snapshot_present|=8;else if(l->kind==10)d->stat_snapshot_present|=16;else if(l->kind==11)d->stat_snapshot_present|=32;else if(l->kind==12)d->stat_snapshot_present|=64;else if(l->kind==13)d->stat_snapshot_present|=128;}}
