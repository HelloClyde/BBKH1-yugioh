#include "duel_search_data.h"
static const SearchRule *search_rule(const Duel *d,unsigned card){if(d->cards[card].effect!=DUEL_E_SEARCH)return 0;for(unsigned i=0;i<DUEL_SEARCH_RULE_COUNT;++i)if(search_rules[i].name==d->cards[card].name_group)return &search_rules[i];return 0;}
static int search_match(const DuelCardDef *c,const SearchRule *r){return duel_card_supported(c)&&(r->filter==1?c->family==DUEL_MONSTER&&c->subtype==r->selector&&c->name_group!=1910:r->filter==2?c->family==DUEL_SPELL&&c->subtype==r->selector:c->name_group==r->selector);}
static int search_candidate(const Duel *d,unsigned side,unsigned card){const SearchRule *r=search_rule(d,card);if(!r)return 0;const DuelPlayer *p=&d->players[side];for(unsigned i=0;i<p->deck_count;++i)if(search_match(&d->cards[p->deck[i]],r))return 1;return 0;}
static unsigned search_options(const Duel *d,unsigned side,unsigned card,DuelChoiceOption *options,unsigned capacity){const SearchRule *r=search_rule(d,card);const DuelPlayer *p=&d->players[side];if(!r||p->hand_count>=DUEL_HAND_MAX)return 0;unsigned count=0;
    for(unsigned i=0;i<p->deck_count;++i){if(!search_match(&d->cards[p->deck[i]],r))continue;if(options&&count<capacity)options[count]=(DuelChoiceOption){p->deck[i],i,DUEL_OPTION_CARD};++count;}return count;
}
unsigned duel_hand_monster_effect(const DuelCardDef *c){if(duel_hand_special(c)||c->name_group==71)return 1;for(unsigned i=0;i<DUEL_SEARCH_RULE_COUNT;++i)if(c->effect==DUEL_E_SEARCH&&search_rules[i].name==c->name_group&&search_rules[i].trigger==2)return 1;return 0;}
static int summon_search_trigger(Duel *d,unsigned side,unsigned index){DuelSlot *s=&d->players[side].monsters[index];const SearchRule *r=search_rule(d,s->card);if(!r||r->trigger!=1||!search_options(d,side,s->card,0,0))return 0;queue_trigger(d,DUEL_CHOICE_SEARCH_OFFER,side,s->card,s->serial);return 1;}
static void search_resolve(Duel *d,const DuelChainLink *link){unsigned side=link->command.player;if(search_options(d,side,link->card,0,0))d->choice=(DuelTrigger){DUEL_CHOICE_DECK_SEARCH,side,link->card,0};else shuffle(d,&d->players[side]);}
static int activate_hand_monster(Duel *d,const DuelCommand *c){if(c->source<d->players[c->player].hand_count&&duel_hand_special(&d->cards[d->players[c->player].hand[c->source]]))return begin_special_hand(d,c);DuelPlayer *p=&d->players[c->player];if(c->source>=p->hand_count)return DUEL_BAD_ARGUMENT;unsigned card=p->hand[c->source];if(!duel_hand_monster_effect(&d->cards[card]))return DUEL_NOT_ALLOWED;if(!main_phase(d))return DUEL_WRONG_PHASE;if(c->player!=d->active)return DUEL_WRONG_TURN;if(d->chain_count||d->response_player<2||duel_card_activation_blocked(d,card)||!search_candidate(d,c->player,card))return DUEL_NOT_ALLOWED;
    discard_hand_effect(d,c->player,c->source,c->player,0);DuelChainLink *link=&d->chain[d->chain_count++];clear(link,sizeof(*link));link->command=*c;link->card=card;link->source_slot=DUEL_NO_SLOT;link->effect_activation=1;link->speed=1;event(d,DUEL_EVENT_SPELL,c->player,c->source,card,0);begin_response(d,1-c->player);return DUEL_OK;
}
