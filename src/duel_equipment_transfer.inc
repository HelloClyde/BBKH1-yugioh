static const DuelSlot *spell_zone_const(const DuelPlayer *p,unsigned slot){return slot==DUEL_FIELD_SLOT?&p->field:&p->backrow[slot];}
/* Reassignment preserves the printed card, controller, position and typed
 * association kind. A pending declaration changes its chain target instead. */
static int equipment_transfer_pending(const Duel *d,const DuelSlot *s){for(unsigned i=0;i<d->chain_count;++i)if(d->chain[i].source_serial==s->serial&&d->cards[d->chain[i].card].effect==DUEL_E_EQUIP&&!s->effect_active)return i;return -1;}
static int equipment_transfer_source(const Duel *d,unsigned side,unsigned index){if(side>1||index>DUEL_FIELD_SLOT)return 0;const DuelSlot *s=index==DUEL_FIELD_SLOT?&d->players[side].field:&d->players[side].backrow[index];if(!s->card)return 0;const DuelCardDef *c=&d->cards[s->card];if(index<5&&c->family==DUEL_MONSTER&&c->race<21)return 1;if((c->original_property>>17&7)==3)return s->position!=DUEL_FACEDOWN_DEFENSE;return index<5&&(c->name_group==650||c->name_group==657||c->name_group==1258)&&s->position!=DUEL_FACEDOWN_DEFENSE&&equipment_transfer_pending(d,s)<0;}
static int equipment_transfer_eligible(const Duel *d,unsigned owner,const DuelSlot *source,unsigned side,unsigned index){if(side>1||index>=5)return 0;const DuelSlot *host=&d->players[side].monsters[index];if(!host->card||host->position==DUEL_FACEDOWN_DEFENSE)return 0;if(source->equip_role==DUEL_EQUIP_ROLE_ABSORB&&source->link_serial)return owner==side&&absorption_name(d->cards[host->card].name_group)&&!absorption_attached(d,host->serial);unsigned name=d->cards[source->card].name_group;if(name==735||name==1170||name==1417)return 0;if((name==1514||name==1068)&&owner==side)return 0;if((name==650||name==71)&&owner!=side)return 0;if(name==71)for(unsigned p=0;p<2;++p)for(unsigned i=0;i<5;++i){const DuelSlot *s=&d->players[p].backrow[i];if(s->card&&s->effect_active&&d->cards[s->card].name_group==71&&s->link_serial==host->serial)return 0;}return equip_eligible(d,source->card,side,index);}
int duel_equipment_transfer_can_target(const Duel *d,unsigned owner,unsigned source,unsigned side,unsigned target){return d&&owner<2&&source<=DUEL_FIELD_SLOT&&spell_zone_const(&d->players[owner],source)->card&&equipment_transfer_eligible(d,owner,spell_zone_const(&d->players[owner],source),side,target);}
static unsigned equipment_transfer_targets(const Duel *d,unsigned owner,unsigned index,DuelChoiceOption *options,unsigned capacity){if(!equipment_transfer_source(d,owner,index))return 0;const DuelSlot *source=spell_zone_const(&d->players[owner],index);unsigned n=0;for(unsigned p=0;p<2;++p)for(unsigned i=0;i<5;++i){const DuelSlot *host=&d->players[p].monsters[i];if(host->serial&&host->serial==source->link_serial)continue;if(equipment_transfer_eligible(d,owner,source,p,i)){if(options&&n<capacity)options[n]=(DuelChoiceOption){host->card,p*5+i,DUEL_OPTION_CARD};++n;}}if(equipment_transfer_pending(d,source)>=0&&n<2)return 0;return n;}
static unsigned equipment_transfer_sources(const Duel *d,DuelChoiceOption *options,unsigned capacity){unsigned n=0;for(unsigned p=0;p<2;++p)for(unsigned i=0;i<=DUEL_FIELD_SLOT;++i)if(equipment_transfer_targets(d,p,i,0,0)){if(options&&n<capacity)options[n]=(DuelChoiceOption){spell_zone_const(&d->players[p],i)->card,p*6+i,DUEL_OPTION_CARD};++n;}return n;}
static int equipment_transfer_any(const Duel *d){for(unsigned p=0;p<2;++p)for(unsigned i=0;i<5;++i)if(equipment_transfer_source(d,p,i))return 1;return 0;}
static int equipment_transfer_validate(const Duel *d,const DuelCommand *c){if(!c->cost)return equipment_transfer_sources(d,0,0)?DUEL_OK:DUEL_NOT_ALLOWED;if(c->cost!=2||!c->tributes||c->tributes>12)return DUEL_BAD_ARGUMENT;unsigned token=c->tributes-1,side=token/6,index=token%6;if(!equipment_transfer_targets(d,side,index,0,0))return DUEL_BAD_TARGET;const DuelSlot *source=spell_zone_const(&d->players[side],index);return c->target_player<2&&c->target<5&&(!source->link_serial||source->link_serial!=d->players[c->target_player].monsters[c->target].serial)&&equipment_transfer_eligible(d,side,source,c->target_player,c->target)?DUEL_OK:DUEL_BAD_TARGET;}
static void equipment_transfer_apply(Duel *d,unsigned side,unsigned index,unsigned target_side,unsigned target_index){DuelSlot *source=spell_zone(&d->players[side],index),*host=&d->players[target_side].monsters[target_index];int pending=equipment_transfer_pending(d,source);if(pending>=0){DuelChainLink *l=&d->chain[pending];l->command.target_player=target_side;l->command.target=target_index;l->target_serial=host->serial;l->target_card=host->card;return;}for(unsigned i=0;i<d->stat_link_count;)if(d->stat_links[i].source==source->serial){for(unsigned j=i;j+1<d->stat_link_count;++j)d->stat_links[j]=d->stat_links[j+1];clear(&d->stat_links[--d->stat_link_count],sizeof(DuelStatLink));}else ++i;for(unsigned i=0;i<d->control_layer_count;)if(d->control_layers[i].source==source->serial)control_remove_layer(d,i);else ++i;source->link_serial=host->serial;source->effect_active=1;equipment_order_attach(d,source,host);unsigned name=d->cards[source->card].name_group;if(name==1068||name==1514)control_add(d,target_side,target_index,side,source->card,source->serial,0);if(name==1258){source->control_used=1-target_side;control_add(d,target_side,target_index,source->control_used,source->card,source->serial,0);}event(d,DUEL_EVENT_SPELL,side,index,source->card,0);}
static void equipment_transfer_resolve(Duel *d,const DuelChainLink *l,unsigned collected){unsigned side=l->command.target_player,index=l->command.target;if(!duel_target_present(d,side,index,l->target_serial))return;const DuelSlot *host=&d->players[side].monsters[index];if(!collected){const DuelTarget *t=&l->targets[0];if(t->player>1||t->slot>DUEL_FIELD_SLOT)return;DuelSlot *source=spell_zone(&d->players[t->player],t->slot);if(!source->card||source->serial!=t->serial||!equipment_transfer_targets(d,t->player,t->slot,0,0)||!equipment_transfer_eligible(d,t->player,source,side,index)||source->link_serial==host->serial)return;equipment_transfer_apply(d,t->player,t->slot,side,index);return;}unsigned invalid=0;for(unsigned order=0;order<2;++order){unsigned p=d->active^order;for(unsigned i=0;i<5;++i){DuelSlot *source=&d->players[p].backrow[i];if(!equipment_transfer_source(d,p,i)||source->link_serial==host->serial)continue;if(equipment_transfer_eligible(d,p,source,side,index))equipment_transfer_apply(d,p,i,side,index);else invalid|=1u<<(p*6+i);}}if(invalid)move_backrows_mask(d,invalid,0,0);}
