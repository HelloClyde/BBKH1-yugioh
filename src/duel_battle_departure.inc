/* The original stores one three-bit countdown on the victim deployment.
 * Typed UID records keep that state separate from printed card definitions. */
static void battle_countdown_reset(Duel *d,uint32_t serial){if(!serial)return;for(unsigned i=0;i<10;++i)if(d->battle_countdowns[i].serial==serial)clear(&d->battle_countdowns[i],sizeof(d->battle_countdowns[i]));}
unsigned duel_battle_countdown(const Duel *d,unsigned side,unsigned index){if(!d||side>1||index>=5||!d->players[side].monsters[index].card)return 0;uint32_t serial=d->players[side].monsters[index].serial;for(unsigned i=0;i<10;++i)if(d->battle_countdowns[i].serial==serial)return d->battle_countdowns[i].remaining;return 0;}
void duel_battle_countdown_set(Duel *d,unsigned side,unsigned index,unsigned count){if(!d||side>1||index>=5||count>7)return;DuelSlot *s=&d->players[side].monsters[index];if(!s->card)return;if(!s->serial)s->serial=++d->next_serial;if(!count){battle_countdown_reset(d,s->serial);return;}int free=-1;for(unsigned i=0;i<10;++i){DuelBattleCountdown *q=&d->battle_countdowns[i];if(q->serial==s->serial){if(!q->remaining||count<q->remaining)q->remaining=count;return;}unsigned present=0;for(unsigned p=0;p<2&&!present;++p)for(unsigned j=0;j<5;++j)present|=d->players[p].monsters[j].card&&d->players[p].monsters[j].serial==q->serial;if(free<0&&(!q->serial||!present))free=i;}if(free>=0)d->battle_countdowns[free]=(DuelBattleCountdown){s->serial,count};}
static void battle_countdown_end(Duel *d){unsigned side=d->active,mask=0;for(unsigned i=0;i<5;++i){unsigned count=duel_battle_countdown(d,side,i);if(count){duel_battle_countdown_set(d,side,i,count-1);if(count==1)mask|=1u<<i;}}unsigned actor=d->effect_actor_plus1;d->effect_actor_plus1=2-side;for(unsigned i=0;i<5;++i)if(mask&(1u<<i))destroy(d,side,i,0);d->effect_actor_plus1=actor;}
void duel_battle_departure_events(Duel *d,const DuelWindow *w){if(!d||!w||w->negated||w->player>1||w->source>=5||w->target>=5)return;const DuelSlot *a=&d->players[w->player].monsters[w->source],*b=&d->players[duel_battle_target_player(w)].monsters[w->target];if(!a->card||!b->card||a->serial!=w->serial||b->serial!=w->target_serial)return;d->dimensional_battle[0]=(DuelTarget){w->serial,w->player,w->source};d->dimensional_battle[1]=(DuelTarget){w->target_serial,duel_battle_target_player(w),w->target};for(unsigned role=0;role<2;++role){unsigned side=role?duel_battle_target_player(w):w->player,opposing=role?w->player:duel_battle_target_player(w),index=role?w->target:w->source,other=role?w->source:w->target;const DuelSlot *s=&d->players[side].monsters[index];if(activation_blocked_for_slot(d,s->card,s->serial))continue;unsigned name=d->cards[s->card].name_group;if(!role&&(name==398||name==392))duel_battle_countdown_set(d,opposing,other,5);if(role&&name==393&&duel_race(d,opposing,other)!=7)duel_battle_countdown_set(d,opposing,other,3);if(name==255)queue_trigger(d,DUEL_TRIGGER_BATTLE_AUTO,side,s->card,s->serial);}}
static void dimensional_resolve(Duel *d,const DuelChainLink *l){unsigned actor=d->effect_actor_plus1;d->effect_actor_plus1=l->command.player+1;for(unsigned i=0;i<2;++i){const DuelTarget *t=&d->dimensional_battle[i];if(t->player>1||t->slot>=5)continue;const DuelSlot *s=&d->players[t->player].monsters[t->slot];if(s->card&&s->serial==t->serial)duel_banish_field(d,t->player,t->slot,0);}d->effect_actor_plus1=actor;}
