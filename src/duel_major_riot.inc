/* Major Riot: the returned count belongs to each physical owner. The turn
 * player chooses first, after both special-summon permissions are frozen. */
static int riot_hand_card(const Duel *d,unsigned card){const DuelCardDef *c=&d->cards[card];return card&&c->family==DUEL_MONSTER&&c->race<21&&c->level<5&&!excavation_only_special(c);}
static unsigned riot_options(const Duel *d,DuelChoiceOption *options,unsigned capacity){unsigned side=d->choice.player,count=0;const DuelPlayer *p=&d->players[side];for(unsigned i=0;i<p->hand_count;++i)if(riot_hand_card(d,p->hand[i])){if(options&&count<capacity)options[count]=(DuelChoiceOption){p->hand[i],i,DUEL_OPTION_CARD};++count;}return count;}
static void riot_shuffle(Duel *d,unsigned side,unsigned mask){uint8_t slots[5];unsigned n=0;for(unsigned i=0;i<5;++i){const DuelSlot *s=&d->players[side].monsters[i];if((mask&(1u<<i))&&s->card&&s->position==DUEL_FACEDOWN_DEFENSE&&!s->facedown_attack)slots[n++]=i;}for(unsigned i=n;i>1;--i){unsigned j=random_next(d)%i;DuelSlot temp=d->players[side].monsters[slots[i-1]];d->players[side].monsters[slots[i-1]]=d->players[side].monsters[slots[j]];d->players[side].monsters[slots[j]]=temp;}}
static void riot_step(Duel *d){DuelRiotTask *t=&d->riot_task;while(t->active&&d->winner<0){if(t->round>=2){for(unsigned i=0;i<2;++i)riot_shuffle(d,t->actor^i,t->deployed[t->actor^i]);t->active=0;event(d,DUEL_EVENT_REMODEL,t->actor,0,t->source,0);return;}unsigned side=t->actor^t->round,eligible=0,room=0;DuelPlayer *p=&d->players[side];for(unsigned i=0;i<p->hand_count;++i)eligible+=riot_hand_card(d,p->hand[i]);for(unsigned i=0;i<5;++i)room+=!p->monsters[i].card&&!p->monsters[i].zone_blocked;if(!t->permission[side])eligible=0;if(t->left[side]>eligible)t->left[side]=eligible;if(t->left[side]>room)t->left[side]=room;if(!t->left[side]){++t->round;continue;}d->choice=(DuelTrigger){DUEL_CHOICE_MAJOR_RIOT,side,t->source,0};return;}}
static void riot_begin(Duel *d,const DuelChainLink *l){DuelRiotTask *t=&d->riot_task;clear(t,sizeof(*t));t->source=l->card;t->actor=d->active;t->active=1;/* Freeze the eligible field set before any equip/association departure. */DuelTarget returned[10];uint8_t owners[10],counted[10];unsigned count=0;for(unsigned round=0;round<2;++round){unsigned side=d->active^round;for(unsigned i=0;i<5;++i){const DuelSlot *s=&d->players[side].monsters[i];if(!s->card||battle_destroyed(d,side,i))continue;returned[count]=(DuelTarget){s->serial,side,i};owners[count]=s->owner;const DuelCardDef *c=&d->cards[s->card];counted[count]=c->family==DUEL_MONSTER&&c->race<21&&!duel_is_token(d,s->card)&&c->subtype!=2;++count;}}for(unsigned i=0;i<count;++i){const DuelTarget *target=&returned[i];return_monster(d,target);const DuelSlot *s=&d->players[target->player].monsters[target->slot];if(counted[i]&&(!s->card||s->serial!=target->serial))++t->left[owners[i]];}for(unsigned side=0;side<2;++side)t->permission[side]=special_summon_allowed_for(d,side);riot_step(d);}
static void riot_choose(Duel *d,unsigned token){DuelRiotTask *t=&d->riot_task;unsigned side=d->choice.player;DuelPlayer *p=&d->players[side];DuelCardState state=take_pile_card(p,PILE_HAND,token);finish_choice(d);int to=excavation_install(d,side,state,DUEL_FACEDOWN_DEFENSE);if(to<0){put_pile_card(d,side,PILE_HAND,state,0);t->left[side]=0;}else {t->deployed[side]|=1u<<to;if(t->left[side])--t->left[side];}continuous_cleanup(d);control_reconcile(d);riot_step(d);}
