#include "duel_ignition_data.h"
static const IgnitionRule *ignition_rule(const DuelCardDef *def){if(def->effect!=DUEL_E_IGNITION)return 0;for(unsigned i=0;i<DUEL_IGNITION_RULE_COUNT;++i)if(ignition_rules[i].name==def->name_group)return &ignition_rules[i];return 0;}
unsigned duel_monster_tribute_cost(const DuelCardDef *def){const IgnitionRule *r=ignition_rule(def);return r?r->tributes:0;}
unsigned duel_monster_has_ignition(const DuelCardDef *def){return ignition_rule(def)!=0||deck_evolution_rule(def)!=0;}
unsigned duel_monster_effect_target(const DuelCardDef *def){const IgnitionRule *r=ignition_rule(def);return r?(r->op==14?2:(r->op==5||r->op==16)):0;}
unsigned duel_monster_effect_coin(const DuelCardDef *def){const IgnitionRule *r=ignition_rule(def);return r&&(r->op==6||r->op==13);}
static int ignition_once(const IgnitionRule *r){return r->op==5||r->op==6||r->op==7||r->op==11||r->op==13||r->op==16;}
/* Preserve the original resource-record priority, including its wrong-card
 * lookup, as explicitly requested by the user. */
static int ignition_eye_available(const Duel *d,unsigned side){const DuelPlayer *p=&d->players[side];if(p->hand_count>=DUEL_HAND_MAX)return 0;for(unsigned i=0;i<p->grave_count;++i)if(d->cards[p->grave[i]].name_group==1003)return 1;return 0;}
static int ignition_eye_target(const Duel *d,unsigned side){const DuelPlayer *p=&d->players[side];if(p->hand_count>=DUEL_HAND_MAX)return -1;for(unsigned target=0;target<DUEL_MONSTER_EYE_TARGET_COUNT;++target)for(unsigned i=p->grave_count;i>0;--i)if(p->grave[i-1]==monster_eye_grave_records[target])return i-1;return -1;}
static unsigned ignition_fusion_options(const Duel *d,unsigned side,unsigned op,DuelChoiceOption *options,unsigned capacity){const DuelPlayer *p=&d->players[side];if(op==10&&(!special_summon_allowed_for(d,side)||empty_zone(p->monsters)<0))return 0;unsigned count=0;for(unsigned i=0;i<p->fusion_count;++i){const DuelCardDef *c=&d->cards[p->fusion[i]];if(c->family!=DUEL_MONSTER||c->subtype!=2||(op==10&&!duel_card_supported(c)))continue;if(options&&count<capacity)options[count]=(DuelChoiceOption){p->fusion[i],i,DUEL_OPTION_CARD};++count;}return count;}
static unsigned ignition_choice_options(const Duel *d,DuelChoiceOption *options,unsigned capacity){const IgnitionRule *r=ignition_rule(&d->cards[d->choice.card]);if(!r)return 0;if(d->choice.kind==DUEL_CHOICE_IGNITION_FUSION)return ignition_fusion_options(d,d->choice.player,r->op,options,capacity);const DuelPlayer *p=&d->players[d->choice.player];if(d->choice.selected_count>=p->fusion_count||empty_zone(p->monsters)<0)return 0;for(unsigned i=0;i<2;++i)if(options&&i<capacity)options[i]=(DuelChoiceOption){p->fusion[d->choice.selected_count],i,DUEL_OPTION_CONFIRM};return 2;}
static void ignition_choose(Duel *d,unsigned index){unsigned side=d->choice.player;DuelPlayer *p=&d->players[side];const IgnitionRule *r=ignition_rule(&d->cards[d->choice.card]);if(d->choice.kind==DUEL_CHOICE_IGNITION_FUSION){if(r->op==9){DuelCardState sent=take_pile_card(p,PILE_FUSION,index);unsigned card=sent.card;sent.history=0;grave_card_state(d,side,sent);event(d,DUEL_EVENT_PILE_DESTROY,side,index,card,1);finish_choice(d);}else {d->choice.selected_count=index;d->choice.kind=DUEL_CHOICE_IGNITION_POSITION;}return;}unsigned selected=d->choice.selected_count;int to=empty_zone(p->monsters);finish_choice(d);if(!special_summon_allowed_for(d,side)||to<0||selected>=p->fusion_count)return;DuelCardState summoned=take_pile_card(p,PILE_FUSION,selected);unsigned card=summoned.card;DuelSlot *s=&p->monsters[to];clear(s,sizeof(*s));s->card=card;s->owner=side;s->position=index;s->summoned_turn=s->set_turn=d->turn;slot_install_state(d,s,summoned);s->return_controller=DUEL_NO_SLOT;/* Extra-deck Special Summon, not a proper Fusion Summon. */s->properly_summoned=summoned.proper;special_summon_success(d,side,to);d->summon_notice=(DuelWindow){DUEL_WINDOW_SUMMON,side,to,0,s->serial,0,card,0,2};event(d,DUEL_EVENT_REVIVE,side,to,card,0);}
static DuelSlot *ignition_source(Duel *d,uint32_t serial){for(unsigned owner=0;owner<2;++owner)for(unsigned i=0;i<5;++i){DuelSlot *s=&d->players[owner].monsters[i];if(s->card&&s->serial==serial&&s->position!=DUEL_FACEDOWN_DEFENSE)return s;}return 0;}
static void ignition_random_result(Duel *d,const DuelChainLink *link,unsigned count,unsigned mask,unsigned guess,unsigned success){uint32_t sequence=d->random_result.sequence+1;d->random_result=(DuelRandomResult){sequence,link->card,link->command.player,count,mask,guess,success};event(d,DUEL_EVENT_SPELL,link->command.player,link->source_slot,link->card,success);}
static int activate_monster(Duel *d,const DuelCommand *c){if(c->source<5&&d->cards[d->players[c->player].monsters[c->source].card].name_group==1525)return mary_activate(d,c);if(c->source<5&&duel_card_prohibited(d,d->players[c->player].monsters[c->source].card,d->players[c->player].monsters[c->source].serial))return DUEL_NOT_ALLOWED;if(c->source<5&&d->players[c->player].monsters[c->source].card&&d->cards[d->players[c->player].monsters[c->source].card].name_group==416)return blast_activate(d,c);if(!main_phase(d)&&!(c->source<5&&d->cards[d->players[c->player].monsters[c->source].card].name_group==579&&d->phase==DUEL_STANDBY))return DUEL_WRONG_PHASE;if(c->source>=5)return DUEL_BAD_ARGUMENT;DuelPlayer *p=&d->players[c->player];DuelSlot *source=&p->monsters[c->source];if(!source->card||source->position==DUEL_FACEDOWN_DEFENSE)return DUEL_NOT_ALLOWED;
    if(deck_evolution_rule(&d->cards[source->card]))return activate_deck_evolution(d,c);
    const IgnitionRule *r=ignition_rule(&d->cards[source->card]);if(!r)return DUEL_UNSUPPORTED;if(d->chain_count||(r->tributes&&continuous_count(d,5))||(ignition_once(r)&&source->ignition_turn==d->turn))return DUEL_NOT_ALLOWED;if(c->tributes&~1023u)return DUEL_BAD_ARGUMENT;
    if((r->op==9||r->op==10)&&(p->life<=(int)r->amount||!ignition_fusion_options(d,c->player,r->op,0,0)))return DUEL_NOT_ALLOWED;
    if(r->op==18){if(!duel_patrol_ready(d,c->player,c->source))return DUEL_NOT_ALLOWED;if(!c->cost){patrol_begin(d,c,source->card);return DUEL_OK;}const DuelSlot *t=patrol_slot_const(d,c->target_player,c->target);if(c->cost!=1||c->target_player!=1-c->player||!t||!t->card||t->position!=DUEL_FACEDOWN_DEFENSE)return DUEL_BAD_TARGET;}
    if(r->op==17&&!contact_return_ready(d,c->player,source->card,c->source))return DUEL_NOT_ALLOWED;
    if(r->op==15&&(!duel_can_tribute(d,c->player,c->player,c->source)||d->end_timer_count>=64))return DUEL_NOT_ALLOWED;
    if(r->op==13&&!monsters(&d->players[1-c->player]))return DUEL_NOT_ALLOWED;
    if(r->op==12&&(!p->hand_count||grave_redirect_active(d)))return DUEL_NOT_ALLOWED;
    if(r->op==11&&duel_spirit_active(d,c->player)&&monsters(p)<2)return DUEL_NOT_ALLOWED;
    if(r->op==11&&(!grave_banish_allowed(d,c->player)||!pile_target_candidates(d,c->player,42,c->player,0,0,0)))return DUEL_NOT_ALLOWED;
    if(r->op==8&&(p->life<(int)r->amount||!ignition_eye_available(d,c->player)))return DUEL_NOT_ALLOWED;
    if(r->op==16&&(empty_zone(p->backrow)<0||absorption_attached(d,source->serial)))return DUEL_NOT_ALLOWED;
    if((r->op==5||r->op==16)&&(c->target_player!=1-c->player||c->target>=5||!duel_can_target_monster(d,c->target_player,c->target)))return DUEL_BAD_TARGET;
    if((r->op==6||r->op==13)&&c->position>1)return DUEL_BAD_ARGUMENT;
    unsigned count=0,amount=r->amount;for(unsigned token=0;token<10;++token)if(c->tributes&(1u<<token)){unsigned owner=tribute_owner(c->player,token),i=token%5;if(!duel_can_tribute(d,c->player,owner,i)||(r->op==3&&owner==c->player&&i==c->source))return DUEL_BAD_TARGET;++count;if(r->op==2)amount=(duel_attack_value(d,owner,i)+1)/2;}if(count!=r->tributes)return DUEL_NEED_TRIBUTES;
    unsigned card=source->card;if(!source->serial)source->serial=++d->next_serial;uint32_t serial=source->serial;
    if(r->op==12)discard_hand_effect(d,c->player,random_next(d)%p->hand_count,c->player,0);
    if(r->op>=8&&r->op<=10){p->life-=r->amount;if(!p->life){event(d,DUEL_EVENT_SPELL,c->player,c->source,card,-(int)r->amount);check_victory_boundary(d);return DUEL_OK;}}
    if(r->op==15||r->op==17)leave_field(d,c->player,c->source,0,LEAVE_TRIBUTE);
    tribute_pay_mask(d,c->player,c->tributes);
    DuelChainLink *link=&d->chain[d->chain_count++];clear(link,sizeof(*link));link->command=*c;link->card=card;link->source_serial=serial;link->source_slot=c->source;link->speed=1;link->effect_activation=1;link->target_card=amount;
    if(r->op==18){DuelSlot *target=patrol_slot(d,c->target_player,c->target);if(!target->serial)target->serial=++d->next_serial;link->target_serial=target->serial;link->target_card=target->card;}
    if(r->op==5||r->op==16){DuelSlot *target=&d->players[c->target_player].monsters[c->target];if(!target->serial)target->serial=++d->next_serial;link->target_serial=target->serial;link->target_card=target->card;}
    event(d,DUEL_EVENT_SPELL,c->player,c->source,card,r->op>=8&&r->op<=10?-(int)r->amount:0);if(r->op==11){source->ignition_turn=d->turn;link->command.cost=0;link->target_card=0;pile_target_begin(d,d->chain_count-1,42);}else begin_response(d,1-c->player);return DUEL_OK;}
static void ignition_resolve(Duel *d,const DuelChainLink *link){const IgnitionRule *r=ignition_rule(&d->cards[link->card]);if(!r)return;unsigned side=link->command.player;
    if(r->op==18){patrol_resolve(d,link);}
    else if(r->op==17){if(contact_return_ready(d,side,link->card,DUEL_NO_SLOT))pile_summon_begin(d,side,link->card,11);}
    else if(r->op==16){absorption_resolve(d,link);}
    else if(r->op==15){if(link->command.cost==1){if(history_target_options(d,side,d->cards[link->card].name_group,0,0))d->choice=(DuelTrigger){DUEL_CHOICE_HISTORY_TARGET,side,link->card,link->source_serial};}else history_schedule(d,side,link->card);}
    else if(r->op==14){blast_resolve(d,link);}
    else if(r->op==13){unsigned coin=random_next(d)&1,success=coin==link->command.position,mask=0,total=0;DuelSlot *source=ignition_source(d,link->source_serial);if(source)source->ignition_turn=d->turn;unsigned victim=success?1-side:side;for(unsigned i=0;i<5;++i)if(d->players[victim].monsters[i].card){mask|=1u<<(victim*5+i);if(!success)total+=duel_attack_value(d,victim,i);}ignition_random_result(d,link,1,!coin,link->command.position,success);destroy_monsters_mask(d,mask);if(!success)damage(d,side,total/2);else if(d->winner<0)time_wizard_offer(d,side,link->card);}
    else if(r->op==12){unsigned mask=0;for(unsigned owner=0;owner<2;++owner)for(unsigned i=0;i<5;++i)if(d->players[owner].monsters[i].card&&d->players[owner].monsters[i].special_summon_marker)mask|=1u<<(owner*5+i);destroy_monsters_mask(d,mask);}
    else if(r->op==11&&link->source_slot<5){DuelSlot *source=&d->players[side].monsters[link->source_slot];if(source->card==link->card){source->lasting_attack+=link->target_card;fairy_stat_delta(d,source,link->target_card);source->lasting_attack_until=d->turn+1;}}
    else if(r->op==1||r->op==2)damage(d,1-side,link->target_card);
    else if(r->op==8){int index=ignition_eye_target(d,side);if(index>=0){DuelCardState returned=card_state_reset(take_pile_card(&d->players[side],PILE_GRAVE,index));unsigned card=returned.card;put_pile_card(d,side,PILE_HAND,returned,0);event(d,DUEL_EVENT_RETURN,side,0,card,0);}}
    else if(r->op==9||r->op==10){if(ignition_fusion_options(d,side,r->op,0,0))d->choice=(DuelTrigger){DUEL_CHOICE_IGNITION_FUSION,side,link->card,link->source_serial};}
    else if(r->op==4)recover(d,side,r->amount,link->card);
    else if(r->op==3)for(unsigned owner=0;owner<2;++owner)for(unsigned i=0;i<5;++i){DuelSlot *s=&d->players[owner].monsters[i];if(s->card&&s->serial==link->source_serial&&s->position!=DUEL_FACEDOWN_DEFENSE)s->temporary_attack+=r->amount;}
    else if(r->op==5||r->op==16){DuelSlot *target=&d->players[link->command.target_player].monsters[link->command.target];if(!target->card||target->serial!=link->target_serial)return;unsigned heads=0,mask=0;for(unsigned i=0;i<3;++i)if(!(random_next(d)&1)){++heads;mask|=1u<<i;}DuelSlot *source=ignition_source(d,link->source_serial);if(source)source->ignition_turn=d->turn;if(heads>=2)destroy(d,link->command.target_player,link->command.target,0);ignition_random_result(d,link,3,mask,0,heads>=2);}
    else if(r->op==6||r->op==7){unsigned coin=r->op==6?random_next(d)&1:0,success=r->op==7||coin==link->command.position;DuelSlot *source=link->source_slot<5?&d->players[side].monsters[link->source_slot]:0;if(source&&source->card){ignition_stat_mark(d,source,r->op,success);source_ready_used(d,source);if(r->op==7)source->destroy_end_turn=d->turn;}if(r->op==6)ignition_random_result(d,link,1,!coin,link->command.position,success);}
}
static int ignition_ai_command(const Duel *d,unsigned side,unsigned index,DuelCommand *c){if(duel_card_prohibited(d,d->players[side].monsters[index].card,d->players[side].monsters[index].serial))return 0;const DuelPlayer *p=&d->players[side];const DuelSlot *s=&p->monsters[index];unsigned evolved=duel_monster_deck_special(d,side,index);if(evolved&&d->cards[evolved].attack>=duel_attack_value(d,side,index)){c->action=DUEL_ACTION_ACTIVATE_MONSTER;c->source=index;return 1;}const IgnitionRule *r=ignition_rule(&d->cards[s->card]);if(!s->card||s->position==DUEL_FACEDOWN_DEFENSE||!r||(r->tributes&&continuous_count(d,5))||(ignition_once(r)&&s->ignition_turn==d->turn))return 0;unsigned available=tribute_available(d,side)-(r->op==3&&duel_can_tribute(d,side,side,index)),mask=0;if(available<r->tributes)return 0;
    if(r->op==18){if(!duel_patrol_ready(d,side,index))return 0;c->action=DUEL_ACTION_ACTIVATE_MONSTER;c->source=index;c->cost=0;return 1;}
    if(r->op==17){if(!contact_return_ready(d,side,s->card,index))return 0;c->action=DUEL_ACTION_ACTIVATE_MONSTER;c->source=index;return 1;}
    if(r->op==15){if(!duel_can_tribute(d,side,side,index)||d->end_timer_count>=64||!history_target_options(d,side,d->cards[s->card].name_group,0,0))return 0;c->action=DUEL_ACTION_ACTIVATE_MONSTER;c->source=index;return 1;}
    if(r->op==14)return blast_ai_command(d,side,index,c);
    if(r->op==13){if(!monsters(&d->players[1-side]))return 0;unsigned total=0;for(unsigned i=0;i<5;++i)if(p->monsters[i].card)total+=duel_attack_value(d,side,i);if(p->life<=(int)(total/2)||monsters(p)>monsters(&d->players[1-side]))return 0;c->action=DUEL_ACTION_ACTIVATE_MONSTER;c->source=index;c->position=0;return 1;}
    if(r->op==12){if(!p->hand_count||grave_redirect_active(d))return 0;unsigned own=0,enemy=0;for(unsigned i=0;i<5;++i){own+=p->monsters[i].card&&p->monsters[i].special_summon_marker;enemy+=d->players[1-side].monsters[i].card&&d->players[1-side].monsters[i].special_summon_marker;}if(enemy<=own)return 0;c->action=DUEL_ACTION_ACTIVATE_MONSTER;c->source=index;return 1;}
    if(r->op==11){if(duel_spirit_active(d,side)&&monsters(p)<2)return 0;if(!grave_banish_allowed(d,side)||!pile_target_candidates(d,side,42,side,0,0,0))return 0;c->action=DUEL_ACTION_ACTIVATE_MONSTER;c->source=index;return 1;}
    if(r->op==9)return 0;if(r->op==10){if(p->life<=(int)r->amount||!ignition_fusion_options(d,side,r->op,0,0))return 0;c->action=DUEL_ACTION_ACTIVATE_MONSTER;c->source=index;return 1;}
    if(r->op==8){if(p->life<=(int)r->amount||!ignition_eye_available(d,side)||ignition_eye_target(d,side)<0)return 0;c->action=DUEL_ACTION_ACTIVATE_MONSTER;c->source=index;return 1;}
    if(r->op==16&&(empty_zone(p->backrow)<0||absorption_attached(d,s->serial)))return 0;
    if(r->op==5||r->op==16){int best=-1,power=-1;for(unsigned i=0;i<5;++i){const DuelSlot *target=&d->players[1-side].monsters[i];if(!target->card||!duel_can_target_monster(d,1-side,i))continue;int value=target->position==DUEL_FACEDOWN_DEFENSE?1500:duel_attack_value(d,1-side,i);if(value>power){power=value;best=i;}}if(best<0)return 0;c->action=DUEL_ACTION_ACTIVATE_MONSTER;c->source=index;c->target_player=1-side;c->target=best;return 1;}
    if(r->op==6||r->op==7){if(d->phase!=DUEL_MAIN1||d->turn==1||s->position!=DUEL_FACEUP_ATTACK||s->attacked)return 0;if(r->op==7&&duel_attack_value(d,side,index)>=2*d->cards[s->card].attack)return 0;c->action=DUEL_ACTION_ACTIVATE_MONSTER;c->source=index;c->position=0;return 1;}
    if(r->op==1&&d->players[1-side].life>(int)(available/r->tributes*r->amount))return 0;if(r->op==2&&d->players[1-side].life>4000)return 0;if(r->op==4&&p->life>2000)return 0;
    if(r->op==3){int best=0;for(unsigned i=0;i<5;++i)if(d->players[1-side].monsters[i].card&&d->players[1-side].monsters[i].position!=DUEL_FACEDOWN_DEFENSE){int value=duel_attack_value(d,1-side,i);if(value>best)best=value;}if(d->turn==1||duel_attack_value(d,side,index)>best)return 0;}
    for(unsigned n=0;n<r->tributes;++n){int best=-1,score=2147483647;for(unsigned token=0;token<10;++token){unsigned owner=tribute_owner(side,token),i=token%5;if(mask&(1u<<token)||!duel_can_tribute(d,side,owner,i)||(r->op==3&&owner==side&&i==index))continue;int attack=duel_attack_value(d,owner,i),value=r->op==2?-attack:(owner==side?100000+attack:-100000-attack);if(value<score){best=token;score=value;}}if(best<0)return 0;mask|=1u<<best;}
    if(r->op==2){unsigned power=0;for(unsigned i=0;i<10;++i)if(mask&(1u<<i))power=(duel_attack_value(d,tribute_owner(side,i),i%5)+1)/2;if(power<(unsigned)d->players[1-side].life)return 0;}
    c->action=DUEL_ACTION_ACTIVATE_MONSTER;c->source=index;c->tributes=mask;return 1;}
