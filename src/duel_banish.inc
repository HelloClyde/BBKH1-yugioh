/* Banishment is its own field/pile movement. Graveyard-only observers must
 * not run for a card that never entered the graveyard. */
int duel_banish_field(Duel *d,unsigned side,unsigned index,unsigned backrow){if(!d||side>1||(backrow?index>DUEL_FIELD_SLOT:index>=5))return 0;DuelSlot *s=backrow?spell_zone(&d->players[side],index):&d->players[side].monsters[index];if(!s->card)return 0;DuelSlot old=*s;DuelPlayer *owner=&d->players[old.owner];if(!duel_is_token(d,old.card)&&owner->banished_count>=DUEL_PILE_MAX)return 0;unsigned destiny=backrow?duel_destiny_departure_mask(d,side,index,old.card):0;unsigned live=!duel_field_effect_negated(d,old.card);clear(s,sizeof(*s));if(!duel_is_token(d,old.card)){DuelCardState state=slot_card_state(&old);state.history=d->effect_actor_plus1&&d->effect_actor_plus1!=side+1?DUEL_HISTORY_OPPONENT:0;put_pile_card(d,old.owner,PILE_BANISHED,state,0);}if(backrow)linked_source_left(d,&old,live,LEAVE_BANISH,side);else detach_monster(d,old.serial,0);event(d,DUEL_EVENT_BANISH,side,index,old.card,0);destiny_clear_departures(d,side,destiny);return 1;}
static void banish_deck_name(Duel *d,unsigned card){for(unsigned side=0;side<2;++side){DuelPlayer *p=&d->players[side];for(unsigned i=p->deck_count;i>0;--i)if(p->banished_count<DUEL_PILE_MAX&&d->cards[p->deck[i-1]].name_group==d->cards[card].name_group){DuelCardState removed=take_pile_card(p,PILE_DECK,i-1);removed.history&=3;put_pile_card(d,side,PILE_BANISHED,removed,0);}shuffle(d,p);}}
static void simultaneous_effect_damage(Duel *d,unsigned amount){for(unsigned side=0;side<2;++side){unsigned actual=amount>(unsigned)d->players[side].life?d->players[side].life:amount;d->players[side].life-=actual;if(actual)d->reactive_pending.damage|=1u<<side;if(actual)event(d,DUEL_EVENT_DAMAGE,side,0,0,actual);}}

static int banished_index(const DuelPlayer *p,uint32_t serial){for(unsigned i=0;i<p->banished_count;++i)if(p->banished_serial[i]==serial)return i;return -1;}
static int banish_grave(Duel *d,unsigned side,unsigned index,unsigned actor){if(!grave_banish_allowed(d,actor))return 0;DuelPlayer *p=&d->players[side];if(index>=p->grave_count||p->banished_count>=DUEL_PILE_MAX)return 0;DuelCardState removed=take_pile_card(p,PILE_GRAVE,index);unsigned card=removed.card;removed.history&=3;put_pile_card(d,side,PILE_BANISHED,removed,0);event(d,DUEL_EVENT_BANISH,side,index,card,0);return 1;}
