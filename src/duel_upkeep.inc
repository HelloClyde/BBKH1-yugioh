/* Maintenance is a payment/decline task, not a spell activation. The original
 * charges it even while the maintained card's ordinary effect is negated. */
static unsigned upkeep_amount(const Duel *d,unsigned card){switch(d->cards[card].name_group){case 1099:return 2000;case 1131:return 100;case 1154:return 700;case 1420:return 1000;case 1424:return 500;default:return 0;}}
static int upkeep_source(const Duel *d){int i=trigger_source(d,&d->choice);return i>=0&&upkeep_amount(d,d->choice.card)?i:-1;}
static int tribute_upkeep_source(const Duel *d){unsigned side=d->choice.player;for(unsigned i=0;i<5;++i){const DuelSlot *s=&d->players[side].monsters[i];if(s->card==d->choice.card&&s->serial==d->choice.serial&&s->position!=DUEL_FACEDOWN_DEFENSE&&d->cards[s->card].name_group==1431)return i;}return -1;}
static unsigned tribute_upkeep_options(const Duel *d,DuelChoiceOption *options,unsigned capacity){if(tribute_upkeep_source(d)<0)return 0;unsigned n=0,side=d->choice.player;for(unsigned token=0;token<10;++token){const DuelSlot *s=tribute_monster(d,side,token);if(s->serial!=d->choice.serial&&duel_can_tribute(d,side,tribute_owner(side,token),token%5)){if(options&&n<capacity)options[n]=(DuelChoiceOption){s->card,token,DUEL_OPTION_CARD};++n;}}if(options&&n<capacity)options[n]=(DuelChoiceOption){0,DUEL_NO_SLOT,DUEL_OPTION_SKIP};return n+1;}
static void tribute_upkeep_choose(Duel *d,unsigned index){int source=tribute_upkeep_source(d);unsigned side=d->choice.player;if(source>=0){if(index==DUEL_NO_SLOT)destroy(d,side,source,0);else leave_field(d,tribute_owner(side,index),index%5,0,LEAVE_TRIBUTE);}finish_choice(d);}
static void upkeep_queue(Duel *d,unsigned side){DuelPlayer *p=&d->players[side];for(unsigned i=0;i<5;++i){DuelSlot *s=&p->monsters[i];if(s->card&&d->cards[s->card].name_group==1431&&s->position!=DUEL_FACEDOWN_DEFENSE){if(!s->serial)s->serial=++d->next_serial;queue_trigger(d,DUEL_CHOICE_TRIBUTE_UPKEEP,side,s->card,s->serial);}}for(unsigned i=0;i<5;++i){DuelSlot *s=&p->backrow[i];if(s->card&&s->effect_active&&s->position!=DUEL_FACEDOWN_DEFENSE&&upkeep_amount(d,s->card)){if(!s->serial)s->serial=++d->next_serial;queue_trigger(d,DUEL_CHOICE_UPKEEP,side,s->card,s->serial);}}}
static unsigned upkeep_options(const Duel *d,DuelChoiceOption *options,unsigned capacity){if(upkeep_source(d)<0)return 0;unsigned n=0;if(d->players[d->choice.player].life>(int)upkeep_amount(d,d->choice.card)){if(options&&n<capacity)options[n]=(DuelChoiceOption){d->choice.card,0,DUEL_OPTION_CONFIRM};++n;}if(options&&n<capacity)options[n]=(DuelChoiceOption){0,DUEL_NO_SLOT,DUEL_OPTION_SKIP};return n+1;}
static void upkeep_choose(Duel *d,unsigned index){int i=upkeep_source(d);unsigned side=d->choice.player,card=d->choice.card;if(i>=0){if(index==DUEL_NO_SLOT)destroy(d,side,i,1);else {d->players[side].life-=upkeep_amount(d,card);event(d,DUEL_EVENT_SPELL,side,i,card,-(int)upkeep_amount(d,card));}}finish_choice(d);}
static void continuous_standby_queue(Duel *d,unsigned side){for(unsigned owner=0;owner<2;++owner)for(unsigned i=0;i<5;++i){DuelSlot *s=&d->players[owner].backrow[i];if(continuous_live(d,owner,i)&&d->cards[s->card].name_group==1311){if(!s->serial)s->serial=++d->next_serial;queue_trigger(d,DUEL_TRIGGER_CONTINUOUS,owner,s->card,s->serial);}}}
static void continuous_event_resolve(Duel *d,const DuelChainLink *link){if(reactive_hand_name(d->cards[link->card].name_group)){reactive_hand_resolve(d,link);return;}for(unsigned i=0;i<5;++i){const DuelSlot *s=&d->players[link->command.player].backrow[i];if(s->card==link->card&&s->serial==link->source_serial&&continuous_live(d,link->command.player,i)&&((d->cards[s->card].name_group==1311)||(d->cards[s->card].name_group==1045))){if(d->cards[s->card].name_group==1311)damage(d,d->active,500);else {DuelPlayer *p=&d->players[1-link->command.player];if(p->hand_count)discard_hand_effect(d,1-link->command.player,random_next(d)%p->hand_count,link->command.player,1);}return;}}}
static void continuous_cleanup(Duel *d){duel_refresh_field_cache(d);monster_negation_refresh(d);pumpking_observer(d,DUEL_NO_SLOT);temporary_zone_reconcile(d);ground_reconcile(d);prohibition_reconcile(d);call_dark_cleanup(d);unsigned mask=0;for(unsigned side=0;side<2;++side)for(unsigned i=0;i<5;++i){const DuelSlot *host=&d->players[side].monsters[i];if(!host->card||!host->serial||host->position==DUEL_FACEDOWN_DEFENSE||d->cards[host->card].name_group!=1351||battle_destroyed(d,side,i)||(d->window.kind==DUEL_WINDOW_SUMMON_NEGATION&&d->window.player==side&&d->window.source==i&&d->window.serial==host->serial))continue;for(unsigned owner=0;owner<2;++owner)for(unsigned j=0;j<5;++j){const DuelSlot *s=&d->players[owner].backrow[j];if(s->card&&s->effect_active&&d->cards[s->card].effect==DUEL_E_EQUIP&&s->link_serial==host->serial)mask|=1u<<(owner*6+j);}}if(mask)move_backrows_mask(d,mask,0,0);if(continuous_count(d,22))for(unsigned side=0;side<2;++side)for(unsigned i=0;i<5;++i){DuelSlot *s=&d->players[side].monsters[i];if(s->card&&s->position==DUEL_FACEUP_ATTACK&&duel_race(d,side,i)==1)duel_change_monster_position(d,side,i,DUEL_FACEUP_DEFENSE);}if(!continuous_has_umi(d))for(unsigned side=0;side<2;++side)for(unsigned i=0;i<5;++i){DuelSlot *s=&d->players[side].backrow[i];if(s->card&&s->effect_active&&s->position!=DUEL_FACEDOWN_DEFENSE&&d->cards[s->card].name_group==1423)destroy(d,side,i,1);}passive_flush(d);kotodama_observer(d);passive_flush(d);}
