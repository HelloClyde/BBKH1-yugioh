static void cocoon_end(Duel *d,unsigned side){for(unsigned i=0;i<5;++i){DuelSlot *s=&d->players[side].backrow[i];if(s->card&&d->cards[s->card].name_group==71&&s->effect_active&&s->position!=DUEL_FACEDOWN_DEFENSE&&!equip_effect_negated(d,s->card)&&s->control_used<15)++s->control_used;}}
#include "duel_periodic_data.h"
static const PeriodicRule *periodic_rule(const Duel *d,unsigned card){if(d->cards[card].effect!=DUEL_E_PERIODIC)return 0;for(unsigned i=0;i<DUEL_PERIODIC_RULE_COUNT;++i)if(periodic_rules[i].name==d->cards[card].name_group)return &periodic_rules[i];return 0;}
static int periodic_hand_spell(const Duel *d,unsigned side){const DuelPlayer *p=&d->players[side];for(unsigned i=0;i<p->hand_count;++i)if(d->cards[p->hand[i]].family==DUEL_SPELL)return 1;return 0;}
static unsigned periodic_banished_monsters(const Duel *d,unsigned side){unsigned n=0;const DuelPlayer *p=&d->players[side];for(unsigned i=0;i<p->banished_count;++i)n+=d->cards[p->banished[i]].family==DUEL_MONSTER;return n;}
static const DuelSlot *periodic_trap_source(const Duel *d,unsigned side,unsigned card,uint32_t serial){for(unsigned i=0;i<5;++i){const DuelSlot *s=&d->players[side].backrow[i];if(s->card==card&&s->serial==serial&&s->position!=DUEL_FACEDOWN_DEFENSE&&s->effect_active&&!duel_field_effect_negated(d,card))return s;}return 0;}
static int periodic_spirit_source(const Duel *d,unsigned side,unsigned card,uint32_t serial){for(unsigned i=0;i<5;++i){const DuelSlot *s=&d->players[side].monsters[i];if(s->card==card&&s->serial==serial&&s->position!=DUEL_FACEDOWN_DEFENSE&&!battle_destroyed(d,side,i))return 1;}return 0;}
static unsigned periodic_spirit_targets(const Duel *d,unsigned side,DuelChoiceOption *options,unsigned capacity){unsigned count=0;for(unsigned i=0;i<5;++i){const DuelSlot *s=&d->players[1-side].monsters[i];if(!s->card||s->position==DUEL_FACEDOWN_DEFENSE||!duel_can_target_monster(d,1-side,i))continue;if(options&&count<capacity)options[count]=(DuelChoiceOption){s->card,i,DUEL_OPTION_CARD};++count;}return count;}
static unsigned periodic_spirit_options(const Duel *d,DuelChoiceOption *options,unsigned capacity){if(!periodic_spirit_source(d,d->choice.player,d->choice.card,d->choice.serial))return 0;unsigned count=periodic_spirit_targets(d,d->choice.player,options,capacity);if(count&&periodic_rule(d,d->choice.card)->op==8){if(options&&count<capacity)options[count]=(DuelChoiceOption){0,DUEL_NO_SLOT,DUEL_OPTION_SKIP};++count;}return count;}
static void periodic_spirit_choose(Duel *d,unsigned index){if(index==DUEL_NO_SLOT){finish_choice(d);return;}unsigned side=d->choice.player;DuelSlot *s=&d->players[1-side].monsters[index];if(!s->serial)s->serial=++d->next_serial;DuelChainLink *link=&d->chain[d->chain_count++];clear(link,sizeof(*link));link->command.player=side;link->command.target_player=1-side;link->command.target=index;link->card=d->choice.card;link->source_serial=d->choice.serial;link->target_serial=s->serial;link->target_card=s->card;link->speed=1;link->effect_activation=1;d->trigger_chain_pending=1;finish_choice(d);}
/* Equip timer counters belong to each source, capped at the original four
 * bits. They keep advancing while Equip effects are negated. */
static void equipment_standby(Duel *d,unsigned side){DuelPlayer *p=&d->players[side];for(unsigned i=0;i<5&&d->winner<0;++i){const DuelSlot *s=&p->backrow[i];if(s->card&&d->cards[s->card].name_group==1417&&s->effect_active&&s->position!=DUEL_FACEDOWN_DEFENSE&&!equip_effect_negated(d,s->card)){unsigned host_side;if(spell_equipment_host(d,s->link_serial,&host_side,0))damage(d,host_side,500);check_victory_boundary(d);}}for(unsigned i=0;i<5&&d->winner<0;++i){DuelSlot *s=&p->backrow[i];if(!s->card||d->cards[s->card].name_group!=1419||s->position==DUEL_FACEDOWN_DEFENSE||!s->effect_active||equip_effect_negated(d,s->card))continue;unsigned host_side=0;if(equip_host(d,s->card,s->link_serial,&host_side,0))damage(d,host_side,500);check_victory_boundary(d);}if(d->winner>=0)return;for(unsigned i=0;i<5;++i){const DuelSlot *s=&d->players[1-side].backrow[i];if(s->card&&d->cards[s->card].name_group==1068&&s->position!=DUEL_FACEDOWN_DEFENSE&&s->effect_active&&!equip_effect_negated(d,s->card)&&equip_host(d,s->card,s->link_serial,0,0))recover(d,side,1000,s->card);}for(unsigned i=0;i<5;++i){DuelSlot *s=&p->backrow[i];if(!s->card||s->position==DUEL_FACEDOWN_DEFENSE)continue;unsigned op=dynamic_equip_op(d,s->card);if((op==4||op==5)&&s->control_used<15)++s->control_used;}attack_equipment_standby(d,side);}
static void periodic_queue(Duel *d,unsigned event_kind,unsigned player){if(d->winner>=0)return;if(event_kind==5){mushroom_end_queue(d,player);duel_destiny_end_queue(d,player);}if(event_kind==1){temporary_standby(d,player);d->jigen_standby_actor_plus1=d->standby_finish_actor_plus1=player+1;d->jigen_standby_next=0;revival_job_queue(d,player);upkeep_queue(d,player);continuous_standby_queue(d,player);equipment_standby(d,player);token_standby(d,player);if(d->winner>=0)return;}
    for(unsigned side=0;side<2;++side){DuelPlayer *p=&d->players[side];for(unsigned zone=0;zone<3;++zone)for(unsigned i=0;i<(zone==2?p->grave_count:5);++i){unsigned card=zone==2?p->grave[i]:zone?p->backrow[i].card:p->monsters[i].card;if(!card)continue;const PeriodicRule *r=periodic_rule(d,card);if(!r||r->zone!=zone||!((r->event==event_kind&&side==player)||((event_kind==1&&r->event==4||event_kind==5&&r->event==6)&&side!=player)))continue;uint32_t serial;
        if(zone!=2){DuelSlot *s=zone?&p->backrow[i]:&p->monsters[i];if(s->position==DUEL_FACEDOWN_DEFENSE||(r->position==1&&s->position!=DUEL_FACEUP_ATTACK)||(r->position==2&&s->position!=DUEL_FACEUP_DEFENSE)||(!zone&&battle_destroyed(d,side,i))||(zone&&(!s->effect_active||duel_field_effect_negated(d,card))))continue;if(!s->serial)s->serial=++d->next_serial;serial=s->serial;}
        else {if(!p->grave_serial[i])p->grave_serial[i]=++d->next_serial;serial=p->grave_serial[i];}
        /* Wishes is continuous: one recovery after the complete draw batch,
           inside its current effect, rather than a new chain after it. */
        if(event_kind==2&&r->event==2){recover(d,side,r->amount,card);continue;}
        if(r->op==10){unsigned visible=0,mask=0;for(unsigned owner=0;owner<2;++owner)for(unsigned n=0;n<5;++n){const DuelSlot *m=&d->players[owner].monsters[n];visible+=m->card&&m->position!=DUEL_FACEDOWN_DEFENSE;}if(!visible)continue;unsigned roll=random_next(d)%6+1;for(unsigned owner=0;owner<2;++owner)for(unsigned n=0;n<5;++n){const DuelSlot *m=&d->players[owner].monsters[n];if(m->card&&m->position!=DUEL_FACEDOWN_DEFENSE&&(d->cards[m->card].level>=6?6:d->cards[m->card].level)==roll)mask|=1u<<(owner*5+n);}d->random_result=(DuelRandomResult){d->random_result.sequence+1,card,side,0,roll,0,1};destroy_monsters_mask(d,mask);continue;}
        if(r->op==12)continue;
        if(r->op==11){damage(d,side,r->amount);if(d->winner>=0)return;continue;}
        if(r->op==9){if(periodic_hand_spell(d,1-side))recover(d,1-side,r->amount,card);continue;}
        if(r->op==5){if(monsters(p)==1){duel_change_monster_position(d,side,i,DUEL_FACEUP_DEFENSE);if(p->monsters[i].position_lock_until<d->turn)p->monsters[i].position_lock_until=d->turn;}continue;}
        if(r->op==7||r->op==8){if(periodic_spirit_targets(d,side,0,0))queue_trigger(d,DUEL_CHOICE_SPIRIT_POSITION,side,card,serial);continue;}
        if(event_kind==3&&activation_blocked_for_slot(d,card,serial))continue;if(r->op==3&&!periodic_banished_monsters(d,1-side))continue;queue_trigger(d,r->op==4?DUEL_CHOICE_PERIODIC:DUEL_TRIGGER_PERIODIC,side,card,serial);
    }}
}
static int periodic_validate(const Duel *d,unsigned side,unsigned card){const PeriodicRule *r=periodic_rule(d,card);return !r||r->zone!=1?DUEL_NOT_ALLOWED:r->op==2&&r->event==4&&d->players[1-side].life>3000?DUEL_NOT_ALLOWED:DUEL_OK;}
static unsigned periodic_offer_options(const Duel *d,DuelChoiceOption *options,unsigned capacity){const DuelPlayer *p=&d->players[d->choice.player];if(p->hand_count>=DUEL_HAND_MAX||grave_index(p,d->choice.serial)<0)return 0;if(options&&capacity)options[0]=(DuelChoiceOption){d->choice.card,0,DUEL_OPTION_CONFIRM};if(options&&capacity>1)options[1]=(DuelChoiceOption){0,DUEL_NO_SLOT,DUEL_OPTION_SKIP};return 2;}
static void periodic_choose(Duel *d,unsigned index){if(index!=DUEL_NO_SLOT){DuelChainLink *link=&d->chain[d->chain_count++];clear(link,sizeof(*link));link->command.player=d->choice.player;link->card=d->choice.card;link->source_serial=d->choice.serial;link->speed=1;link->effect_activation=1;d->trigger_chain_pending=1;}finish_choice(d);}
static void periodic_resolve(Duel *d,const DuelChainLink *link){unsigned side=link->command.player;const PeriodicRule *r=periodic_rule(d,link->card);if(!r||(r->zone==1&&!periodic_trap_source(d,side,link->card,link->source_serial)))return;
    if(r->op==7||r->op==8){unsigned owner=link->command.target_player,index=link->command.target;DuelSlot *s=&d->players[owner].monsters[index];if(!s->card||s->serial!=link->target_serial||s->position==DUEL_FACEDOWN_DEFENSE)return;duel_change_monster_position(d,owner,index,s->position==DUEL_FACEUP_ATTACK?DUEL_FACEUP_DEFENSE:DUEL_FACEUP_ATTACK);if(r->op==7&&s->position_lock_until<d->turn)s->position_lock_until=d->turn;}
    else if(r->op==1)recover(d,side,r->amount,link->card);else if(r->op==2)damage(d,1-side,r->amount);else if(r->op==3)damage(d,1-side,r->amount*periodic_banished_monsters(d,1-side));
    else if(r->op==6){for(unsigned owner=0;owner<2;++owner)for(unsigned i=0;i<5;++i){const DuelSlot *s=&d->players[owner].monsters[i];if(s->card==link->card&&s->serial==link->source_serial&&s->position!=DUEL_FACEDOWN_DEFENSE){DuelTarget target={s->serial,owner,i};return_monster(d,&target);return;}}}
    else if(r->op==4){DuelPlayer *p=&d->players[side];int index=grave_index(p,link->source_serial);if(index>=0&&p->grave[index]==link->card&&p->hand_count<DUEL_HAND_MAX){put_pile_card(d,side,PILE_HAND,card_state_reset(take_pile_card(p,PILE_GRAVE,index)),0);event(d,DUEL_EVENT_RETURN,side,0,link->card,0);}}
}
