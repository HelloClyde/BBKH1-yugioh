/* Selection before activation and decisions during resolution are separate:
 * paid tributes survive negation; Two-Pronged Attack stores three UIDs. */
static int destruction_choice_kind(unsigned kind){return kind==DUEL_CHOICE_DESTRUCTION_SELECT||kind==DUEL_CHOICE_SHARE_TRIBUTE||kind==DUEL_CHOICE_EARTH_FIRST||kind==DUEL_CHOICE_EARTH_SECOND||kind==DUEL_CHOICE_EARTH_OPPONENT;}
static unsigned destruction_tribute_options(const Duel *d,unsigned actor,DuelChoiceOption *options,unsigned capacity){unsigned n=0;for(unsigned side=0;side<2;++side)for(unsigned i=0;i<5;++i)if(duel_can_tribute(d,actor,side,i)){if(options&&n<capacity)options[n]=(DuelChoiceOption){d->players[side].monsters[i].card,side*5+i,DUEL_OPTION_CARD};++n;}return n;}
static unsigned destruction_target_count(const Duel *d,unsigned side){unsigned n=0;for(unsigned i=0;i<5;++i)n+=duel_can_target_monster(d,side,i)!=0;return n;}
static int destruction_validate(const Duel *d,const DuelCommand *c,unsigned name){unsigned actor=c->player;if(name==1097){for(unsigned p=0;p<2;++p)for(unsigned i=0;i<5;++i)if(d->players[p].monsters[i].card&&d->players[p].monsters[i].position!=DUEL_FACEDOWN_DEFENSE)return DUEL_OK;return DUEL_NOT_ALLOWED;}
    if(name==1059){if(!destruction_tribute_options(d,actor,0,0)||!destruction_tribute_options(d,1-actor,0,0))return DUEL_NOT_ALLOWED;if(!c->cost)return DUEL_OK;return c->cost==1&&c->tributes>=1&&c->tributes<=10&&duel_can_tribute(d,actor,(c->tributes-1)/5,(c->tributes-1)%5)?DUEL_OK:DUEL_BAD_TARGET;}
    if(destruction_target_count(d,actor)<2||!destruction_target_count(d,1-actor))return DUEL_NOT_ALLOWED;if(!c->cost)return DUEL_OK;if(c->cost!=1||c->target_count!=3)return DUEL_BAD_TARGET;for(unsigned n=0;n<3;++n){unsigned token=c->targets[n];if(token>=10||token/5!=(n<2?actor:1-actor)||!duel_can_target_monster(d,token/5,token%5))return DUEL_BAD_TARGET;for(unsigned j=0;j<n;++j)if(token==c->targets[j])return DUEL_BAD_TARGET;}return DUEL_OK;
}
static void destruction_begin(Duel *d,const DuelCommand *c,unsigned card){d->equip_mode_command=*c;d->equip_mode_command.target_count=0;d->choice=(DuelTrigger){DUEL_CHOICE_DESTRUCTION_SELECT,c->player,card,0};}
static unsigned destruction_choice_options(const Duel *d,DuelChoiceOption *options,unsigned capacity){const DuelTrigger *choice=&d->choice;unsigned kind=choice->kind,n=0;
    if(kind==DUEL_CHOICE_SHARE_TRIBUTE)return destruction_tribute_options(d,choice->player,options,capacity);
    if(kind==DUEL_CHOICE_DESTRUCTION_SELECT){if(d->cards[choice->card].name_group==1059)n=destruction_tribute_options(d,choice->player,options,capacity);else{const DuelCommand *c=&d->equip_mode_command;unsigned side=c->target_count<2?c->player:1-c->player;for(unsigned i=0;i<5;++i){unsigned token=side*5+i,selected=0;for(unsigned j=0;j<c->target_count;++j)selected|=c->targets[j]==token;if(selected||!duel_can_target_monster(d,side,i))continue;if(options&&n<capacity)options[n]=(DuelChoiceOption){d->players[side].monsters[i].card,token,DUEL_OPTION_CARD};++n;}}if(options&&n<capacity)options[n]=(DuelChoiceOption){0,DUEL_NO_SLOT,DUEL_OPTION_SKIP};return n+1;}
    for(unsigned value=1;value<=6;++value){unsigned bit=1u<<(value-1);if(kind==DUEL_CHOICE_EARTH_SECOND&&(choice->selected_count&bit)||kind==DUEL_CHOICE_EARTH_OPPONENT&&!(choice->selected_count&bit))continue;if(options&&n<capacity)options[n]=(DuelChoiceOption){choice->card,value,DUEL_OPTION_CONFIRM};++n;}return n;
}
static int destruction_choose(Duel *d,unsigned token){unsigned kind=d->choice.kind,card=d->choice.card,actor=d->choice.serial?d->choice.serial-1:d->choice.player;
    if(kind==DUEL_CHOICE_DESTRUCTION_SELECT){DuelCommand c=d->equip_mode_command;if(token==DUEL_NO_SLOT){finish_choice(d);return DUEL_OK;}if(d->cards[card].name_group==1059){c.tributes=token+1;c.cost=1;}else{c.targets[c.target_count++]=token;d->equip_mode_command=c;if(c.target_count<3)return DUEL_OK;c.cost=1;}finish_choice(d);return activate(d,&c,c.action==DUEL_ACTION_ACTIVATE_BACKROW);}
    if(kind==DUEL_CHOICE_SHARE_TRIBUTE){finish_choice(d);leave_field(d,token/5,token%5,0,LEAVE_TRIBUTE);return DUEL_OK;}
    if(kind==DUEL_CHOICE_EARTH_FIRST){d->choice.selected_count=1u<<(token-1);d->choice.kind=DUEL_CHOICE_EARTH_SECOND;return DUEL_OK;}
    if(kind==DUEL_CHOICE_EARTH_SECOND){d->choice.selected_count|=1u<<(token-1);d->choice.kind=DUEL_CHOICE_EARTH_OPPONENT;d->choice.player=1-actor;return DUEL_OK;}
    finish_choice(d);unsigned mask=0;for(unsigned p=0;p<2;++p)for(unsigned i=0;i<5;++i){const DuelSlot *s=&d->players[p].monsters[i];if(s->card&&s->position!=DUEL_FACEDOWN_DEFENSE&&duel_attribute(d,p,i)==token)mask|=1u<<(p*5+i);}unsigned saved=d->effect_actor_plus1;d->effect_actor_plus1=actor+1;destroy_monsters_mask(d,effect_monster_mask(d,card,mask));d->effect_actor_plus1=saved;return DUEL_OK;
}
static void destruction_resolve(Duel *d,const DuelChainLink *link){unsigned name=d->cards[link->card].name_group,actor=link->command.player;if(link->effect_negated)return;
    if(name==1059){if(destruction_tribute_options(d,1-actor,0,0))d->choice=(DuelTrigger){DUEL_CHOICE_SHARE_TRIBUTE,1-actor,link->card,actor+1};return;}
    if(name==1097){d->choice=(DuelTrigger){DUEL_CHOICE_EARTH_FIRST,actor,link->card,actor+1};return;}
    if(link->target_count!=3)return;unsigned mask=0;for(unsigned i=0;i<3;++i){const DuelTarget *t=&link->targets[i];if(!duel_target_present(d,t->player,t->slot,t->serial))return;mask|=1u<<(t->player*5+t->slot);}destroy_monsters_mask(d,effect_monster_mask(d,link->card,mask));
}
static int destruction_attribute_score(const Duel *d,unsigned actor,unsigned attribute){int score=0;for(unsigned p=0;p<2;++p)for(unsigned i=0;i<5;++i){const DuelSlot *s=&d->players[p].monsters[i];if(s->card&&s->position!=DUEL_FACEDOWN_DEFENSE&&duel_attribute(d,p,i)==attribute)score+=(p==actor?-1:1)*(1000+duel_attack_value(d,p,i));}return score;}
static unsigned destruction_ai_choice(const Duel *d){DuelChoiceOption options[DUEL_OPTION_MAX];unsigned n=destruction_choice_options(d,options,DUEL_OPTION_MAX),best=0;int score=-2147483647;for(unsigned i=0;i<n;++i){if(options[i].kind==DUEL_OPTION_SKIP)continue;unsigned token=options[i].index;int value;if(d->choice.kind==DUEL_CHOICE_DESTRUCTION_SELECT||d->choice.kind==DUEL_CHOICE_SHARE_TRIBUTE){value=(token/5==d->choice.player?-1:1)*(1000+duel_attack_value(d,token/5,token%5));}else value=destruction_attribute_score(d,d->choice.player,token);if(value>score){score=value;best=token;}}return best;}
static int destruction_ai(const Duel *d,unsigned actor,DuelCommand *c,unsigned card){unsigned name=d->cards[card].name_group;if(destruction_validate(d,c,name)!=DUEL_OK)return 0;if(name==1097){unsigned good=0;for(unsigned a=1;a<=6;++a)good+=destruction_attribute_score(d,actor,a)>0;return good>=2;}if(name==1059)return monsters(&d->players[actor])>=monsters(&d->players[1-actor]);return monsters(&d->players[actor])>monsters(&d->players[1-actor])&&monsters(&d->players[actor])>2;}
