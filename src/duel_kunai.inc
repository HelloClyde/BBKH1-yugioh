static int kunai_position_available(const Duel *d,unsigned actor){const DuelWindow *w=&d->window;if(w->kind!=DUEL_WINDOW_ATTACK||w->player==actor||w->source>=5)return 0;const DuelSlot *s=&d->players[w->player].monsters[w->source];return s->card&&(s->position==DUEL_FACEUP_ATTACK||(s->position==DUEL_FACEDOWN_DEFENSE&&s->facedown_attack))&&duel_can_target_monster(d,w->player,w->source);}
static unsigned kunai_targets(const Duel *d,unsigned side,unsigned card,DuelChoiceOption *options,unsigned capacity){unsigned n=0;for(unsigned i=0;i<5;++i)if(duel_equip_can_target_for(d,side,card,side,i)){if(options&&n<capacity)options[n]=(DuelChoiceOption){d->players[side].monsters[i].card,i,DUEL_OPTION_CARD};++n;}return n;}
static unsigned kunai_modes(const Duel *d,unsigned side,unsigned card,DuelChoiceOption *options,unsigned capacity){unsigned change=kunai_position_available(d,side),equip=kunai_targets(d,side,card,0,0)!=0,n=0;for(unsigned mode=1;mode<=3;++mode)if((mode==1&&change)||(mode==2&&equip)||(mode==3&&change&&equip)){if(options&&n<capacity)options[n]=(DuelChoiceOption){card,mode,DUEL_OPTION_CONFIRM};++n;}return n;}
/* The original stages are independent. Failed equipment still permits the
 * attacker-position effect, and equipment uses the current target coordinate. */
static void kunai_resolve(Duel *d,const DuelChainLink *l){if(duel_field_effect_negated(d,l->card))return;unsigned side=l->command.player,mode=l->command.cost;if(mode!=1&&l->command.target_player==side&&l->command.target<5){DuelSlot *source=&d->players[side].backrow[l->source_slot],*host=&d->players[side].monsters[l->command.target];if(source->card==l->card&&source->serial==l->source_serial&&source->position!=DUEL_FACEDOWN_DEFENSE&&host->card&&host->position!=DUEL_FACEDOWN_DEFENSE){if(!host->serial)host->serial=++d->next_serial;source->link_serial=host->serial;source->effect_active=1;equipment_order_attach(d,source,host);d->summon_notice=(DuelWindow){DUEL_WINDOW_EQUIP,side,l->source_slot,l->command.target,source->serial,host->serial,l->card};}}
    if(mode!=2){const DuelTarget *t=&l->targets[0];if(t->player<2&&t->player!=side&&t->slot<5){DuelSlot *s=&d->players[t->player].monsters[t->slot];if(s->card&&(s->position==DUEL_FACEUP_ATTACK||(s->position==DUEL_FACEDOWN_DEFENSE&&s->facedown_attack))){duel_change_monster_position(d,t->player,t->slot,s->position==DUEL_FACEUP_ATTACK?DUEL_FACEUP_DEFENSE:DUEL_FACEDOWN_DEFENSE);event(d,DUEL_EVENT_POSITION,t->player,t->slot,s->card,0);}}}
}
