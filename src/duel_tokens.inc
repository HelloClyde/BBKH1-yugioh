/* Tokens are field instances with metadata, never new owned pile cards. */
#include "duel_token_data.h"
int duel_is_token(const Duel *d,unsigned card){return d&&card_valid(d,card)&&d->cards[card].name_group>=1920&&d->cards[card].name_group<=1923;}
static int token_permission(const Duel *d,unsigned side,unsigned name){if(special_summon_allowed_for(d,side))return 1;/* Jam's own Slime production is its explicit exception. */return name==1923&&!(d->summon_ban_turn[side]==d->turn&&(d->summon_ban_mask[side]&2))&&!live_monster_name(d,1510,3)&&!live_monster_name(d,1526,3);}
static unsigned summon_token(Duel *d,unsigned side,unsigned name,unsigned position){if(name<1920||name>1923||!token_permission(d,side,name))return 0;int to=empty_zone(d->players[side].monsters);if(to<0)return 0;unsigned card=duel_token_records[name-1920];DuelSlot *s=&d->players[side].monsters[to];clear(s,sizeof(*s));s->card=card;s->owner=side;s->position=position==DUEL_FACEDOWN_DEFENSE&&live_backrow_name(d,1151,3)?DUEL_FACEUP_DEFENSE:position;s->summoned_turn=s->set_turn=d->turn;s->properly_summoned=1;s->return_controller=DUEL_NO_SLOT;s->serial=++d->next_serial;special_summon_success(d,side,to);d->summon_notice=(DuelWindow){DUEL_WINDOW_SUMMON,side,to,0,s->serial,0,card,0,2};event(d,DUEL_EVENT_SUMMON,side,to,card,0);return 1;}
static void token_standby(Duel *d,unsigned side){for(unsigned i=0;i<5;++i){DuelSlot *s=&d->players[side].backrow[i];if(s->card&&d->cards[s->card].name_group==1426&&s->effect_active&&s->position!=DUEL_FACEDOWN_DEFENSE){if(!s->serial)s->serial=++d->next_serial;queue_trigger(d,DUEL_TRIGGER_TOKEN_STANDBY,side,s->card,s->serial);}}}
static void token_standby_resolve(Duel *d,const DuelTrigger *t){duel_refresh_field_cache(d);prohibition_reconcile(d);for(unsigned i=0;i<5;++i){const DuelSlot *s=&d->players[t->player].backrow[i];if(s->card==t->card&&s->serial==t->serial&&s->effect_active&&s->position!=DUEL_FACEDOWN_DEFENSE&&!duel_field_effect_negated(d,s->card)&&!duel_card_prohibited(d,s->card,s->serial)){summon_token(d,t->player,1923,DUEL_FACEUP_ATTACK);return;}}}
static unsigned token_space(const Duel *d,unsigned side){unsigned n=0;for(unsigned i=0;i<5;++i)n+=!d->players[side].monsters[i].card&&!d->players[side].monsters[i].zone_blocked;return n;}
static int multiply_cost(const Duel *d,unsigned actor,unsigned owner,unsigned index){if(owner>1||index>=5||!duel_can_tribute(d,actor,owner,index))return 0;const DuelSlot *s=&d->players[owner].monsters[index];return s->position!=DUEL_FACEDOWN_DEFENSE&&d->cards[s->card].name_group==57;}
static void summon_turn_ban(Duel *d,unsigned side){d->summon_ban_turn[side]=d->turn;d->summon_ban_mask[side]=3;}
