int duel_spirit_active(const Duel *d,unsigned side){return d&&side<2&&d->spirit_elimination_turn[side]==d->turn;}
static int spirit_pool(unsigned op){return op==38||op==39||op==41||op==42||op==43;}
static unsigned spirit_field_options(const Duel *d,unsigned side,const DuelChainLink *link,DuelChoiceOption *options,unsigned capacity){unsigned n=0;for(unsigned i=0;i<5;++i){const DuelSlot *s=&d->players[side].monsters[i];if(!s->card||(!duel_is_token(d,s->card)&&d->players[s->owner].banished_count>=DUEL_PILE_MAX))continue;unsigned selected=0;if(link)for(unsigned j=0;j<link->target_count;++j)selected|=link->targets[j].player==side&&link->targets[j].slot==i;if(selected)continue;if(options&&n<capacity)options[n]=(DuelChoiceOption){s->card,i,DUEL_OPTION_CARD};++n;}return n;}
static int spirit_natural_cost(const Duel *d,unsigned side,unsigned card){unsigned name=d->cards[card].name_group;return name>=1514&&name<=1519&&duel_spirit_active(d,side);}
static unsigned spirit_natural_options(const Duel *d,unsigned side,unsigned card,DuelChoiceOption *options,unsigned capacity){unsigned n=0;if(!grave_banish_allowed(d,side))return 0;for(unsigned i=0;i<5;++i){const DuelSlot *s=&d->players[side].monsters[i];if(!s->card||(!duel_is_token(d,s->card)&&d->players[s->owner].banished_count>=DUEL_PILE_MAX))continue;if(d->cards[card].name_group==1514?duel_race(d,side,i)!=3:duel_attribute(d,side,i)!=d->cards[card].attribute)continue;if(options&&n<capacity)options[n]=(DuelChoiceOption){s->card,i,DUEL_OPTION_CARD};++n;}return n;}
int duel_makiu_target(const Duel *d,unsigned actor,unsigned side,unsigned index){if(side!=actor||index>=5||!duel_can_target_monster(d,side,index)||d->players[side].monsters[index].position==DUEL_FACEDOWN_DEFENSE)return 0;return d->cards[d->players[side].monsters[index].card].name_group==21||duel_race(d,side,index)==19;}
static int makiu_validate(const Duel *d,const DuelCommand *c){if(d->phase!=DUEL_MAIN1)return DUEL_WRONG_PHASE;unsigned enemy=0;for(unsigned i=0;i<5;++i)enemy|=d->players[1-c->player].monsters[i].card&&d->players[1-c->player].monsters[i].position!=DUEL_FACEDOWN_DEFENSE;return enemy&&duel_makiu_target(d,c->player,c->target_player,c->target)?DUEL_OK:DUEL_BAD_TARGET;}
static void makiu_resolve(Duel *d,const DuelChainLink *l){if(l->effect_negated||!duel_target_present(d,l->command.target_player,l->command.target,l->target_serial)||!duel_makiu_target(d,l->command.player,l->command.target_player,l->command.target))return;unsigned actor=l->command.player,mask=0;int attack=duel_attack_value(d,actor,l->command.target);for(unsigned i=0;i<5;++i){const DuelSlot *s=&d->players[1-actor].monsters[i];if(s->card&&s->position!=DUEL_FACEDOWN_DEFENSE&&duel_defense_value(d,1-actor,i)<=attack)mask|=1u<<((1-actor)*5+i);}destroy_monsters_mask(d,effect_monster_mask(d,l->card,mask));}
static int makiu_ai(const Duel *d,unsigned side,DuelCommand *c,unsigned card){if(d->cards[card].name_group==1551){if(!monsters(&d->players[side])||!grave_banish_allowed(d,side))return 0;for(unsigned i=0;i<d->players[side].hand_count;++i){unsigned candidate=d->players[side].hand[i],name=d->cards[candidate].name_group;if(name>=1514&&name<=1519&&spirit_natural_options(d,side,candidate,0,0)>=(name==1514?3:name==1515?2:1))return 1;}return 0;}int best=-1,power=-1;for(unsigned i=0;i<5;++i)if(duel_makiu_target(d,side,side,i)&&duel_attack_value(d,side,i)>power){best=i;power=duel_attack_value(d,side,i);}if(best<0)return 0;c->target_player=side;c->target=best;if(makiu_validate(d,c)!=DUEL_OK)return 0;for(unsigned i=0;i<5;++i){const DuelSlot *s=&d->players[1-side].monsters[i];if(s->card&&s->position!=DUEL_FACEDOWN_DEFENSE&&duel_defense_value(d,1-side,i)<=power&&effect_affects_monster(d,card,1-side,i))return 1;}return 0;}
