static DuelSlot *patrol_slot(Duel *d,unsigned side,unsigned index){if(side>1||index>10)return 0;return index<5?&d->players[side].monsters[index]:index<10?&d->players[side].backrow[index-5]:&d->players[side].field;}
static const DuelSlot *patrol_slot_const(const Duel *d,unsigned side,unsigned index){if(side>1||index>10)return 0;return index<5?&d->players[side].monsters[index]:index<10?&d->players[side].backrow[index-5]:&d->players[side].field;}
int duel_patrol_target(const Duel *d,unsigned actor,unsigned side,unsigned index){const DuelSlot *s=patrol_slot_const(d,side,index);return side!=actor&&s&&s->card&&s->position==DUEL_FACEDOWN_DEFENSE;}
static unsigned patrol_options(const Duel *d,unsigned actor,DuelChoiceOption *options,unsigned capacity){unsigned n=0;for(unsigned i=0;i<11;++i){if(!duel_patrol_target(d,actor,1-actor,i))continue;if(options&&n<capacity)options[n]=(DuelChoiceOption){0,i,DUEL_OPTION_CARD};++n;}return n;}
int duel_patrol_ready(const Duel *d,unsigned actor,unsigned index){if(index>=5||actor!=d->active||d->phase!=DUEL_STANDBY)return 0;const DuelSlot *s=&d->players[actor].monsters[index];return s->card&&d->cards[s->card].name_group==579&&s->position!=DUEL_FACEDOWN_DEFENSE&&s->ignition_turn!=d->turn&&!activation_blocked_for_slot(d,s->card,s->serial)&&patrol_options(d,actor,0,0);}
static int patrol_any(const Duel *d){for(unsigned i=0;i<5;++i)if(duel_patrol_ready(d,d->active,i))return 1;return 0;}
static void patrol_begin(Duel *d,const DuelCommand *c,unsigned card){d->equip_mode_command=*c;d->choice=(DuelTrigger){DUEL_CHOICE_PATROL_TARGET,c->player,card,0};}
static int patrol_choose(Duel *d,unsigned token){DuelCommand c=d->equip_mode_command;finish_choice(d);if(token==DUEL_NO_SLOT)return DUEL_OK;c.cost=1;c.target_player=1-c.player;c.target=token;return activate_monster(d,&c);}
static void standby_peek_view(Duel *d,unsigned actor,unsigned owner,unsigned source,unsigned card){clear(&d->peek_task,sizeof(d->peek_task));d->peek_task.actor=actor;d->peek_task.owner=owner;d->peek_task.kind=6;d->peek_task.count=1;d->peek_task.cards[0]=card;d->choice=(DuelTrigger){DUEL_CHOICE_PEEK_VIEW,actor,source,0};}
static void patrol_resolve(Duel *d,const DuelChainLink *l){if(l->effect_negated||l->command.target_player==l->command.player)return;DuelSlot *s=patrol_slot(d,l->command.target_player,l->command.target);if(!s||!s->card||s->serial!=l->target_serial||s->position!=DUEL_FACEDOWN_DEFENSE)return;standby_peek_view(d,l->command.player,l->command.target_player,l->card,s->card);if(l->source_slot<5&&d->players[l->command.player].monsters[l->source_slot].card)d->players[l->command.player].monsters[l->source_slot].ignition_turn=d->turn;}
int duel_inspection_ready(const Duel *d,unsigned actor,unsigned index){if(index>=5||actor==d->active||d->phase!=DUEL_STANDBY||d->players[actor].life<=500||!d->players[1-actor].hand_count)return 0;const DuelSlot *s=&d->players[actor].backrow[index];return s->card&&d->cards[s->card].name_group==1161&&s->position!=DUEL_FACEDOWN_DEFENSE&&s->effect_active&&!activation_blocked_for_slot(d,s->card,s->serial);}
static int inspection_any(const Duel *d){for(unsigned i=0;i<5;++i)if(duel_inspection_ready(d,1-d->active,i))return 1;return 0;}
static int inspection_offer(Duel *d){unsigned actor=1-d->active;if(d->inspection_declined_turn[actor]==d->turn)return 0;for(unsigned i=0;i<5;++i)if(duel_inspection_ready(d,actor,i)){d->choice=(DuelTrigger){DUEL_CHOICE_INSPECTION_OFFER,actor,d->players[actor].backrow[i].card,d->players[actor].backrow[i].serial,i};return 1;}return 0;}
static unsigned inspection_options(const Duel *d,DuelChoiceOption *options,unsigned capacity){if(options&&capacity)options[0]=(DuelChoiceOption){d->choice.card,0,DUEL_OPTION_CONFIRM};if(options&&capacity>1)options[1]=(DuelChoiceOption){0,DUEL_NO_SLOT,DUEL_OPTION_SKIP};return 2;}
static int inspection_choose(Duel *d,unsigned token){unsigned actor=d->choice.player,index=d->choice.selected_count;finish_choice(d);if(token==DUEL_NO_SLOT){d->inspection_declined_turn[actor]=d->turn;return DUEL_OK;}DuelCommand c={actor,DUEL_ACTION_ACTIVATE_BACKROW,index};return activate_continuous_ability(d,&c);}
static void inspection_resolve(Duel *d,const DuelChainLink *l){unsigned actor=l->command.player;if(!l->effect_activation||l->effect_negated||l->source_slot>=5||d->players[actor].backrow[l->source_slot].card!=l->card||!d->players[1-actor].hand_count)return;unsigned index=random_next(d)%d->players[1-actor].hand_count;standby_peek_view(d,actor,1-actor,l->card,d->players[1-actor].hand[index]);d->players[actor].backrow[l->source_slot].ignition_turn=d->turn;}
